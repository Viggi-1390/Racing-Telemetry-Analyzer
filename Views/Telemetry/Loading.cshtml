@{
    Layout = null;
    var vehicle = ViewBag.Vehicle as RacingTelemetryAnalyzer.Models.Vehicle;
    var track = ViewBag.Track as RacingTelemetryAnalyzer.Models.Track;
    var isBike = vehicle != null && vehicle.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Bike;
    var vehicleName = vehicle?.Name ?? "UNKNOWN VEHICLE";
    var vehicleClass = vehicle?.Class ?? "RACE";
    var vehicleId = vehicle?.VehicleId ?? 1;
    var trackName = track?.Name ?? "MONZA";
    var trackId = track?.TrackId ?? 1;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initializing Telemetry — @vehicleName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/racing-design-system.css" />
    <style>
        :root {
            --rta-bg-abyss:         #060709;
            --rta-bg-surface-1:     #0d1017;
            --rta-bg-surface-2:     #131722;
            --rta-orange:           #ff5a1f;
            --rta-orange-glow:      rgba(255, 90, 31, 0.40);
            --rta-cyan:             #00d2ff;
            --rta-cyan-bright:      #00f0ff;
            --rta-cyan-glow:        rgba(0, 210, 255, 0.45);
            --rta-text-primary:     #f4f4f5;
            --rta-text-secondary:   #8e95a5;
            --rta-text-muted:       #4b5263;
            --rta-border-subtle:    rgba(0, 210, 255, 0.14);
            --rta-border-medium:    rgba(0, 210, 255, 0.30);
            --rta-font-ui:          'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --rta-font-mono:        'JetBrains Mono', 'Consolas', 'SF Mono', monospace;
            --scan-progress:        0%;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--rta-bg-abyss, #060709);
            color: var(--rta-text-primary, #f4f4f5);
            font-family: var(--rta-font-ui, sans-serif);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* 32px Technical CAD Coordinate Grid */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                radial-gradient(circle at 1px 1px, rgba(0, 210, 255, 0.08) 1px, transparent 0),
                linear-gradient(to right, rgba(0, 210, 255, 0.025) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 210, 255, 0.025) 1px, transparent 1px);
            background-size: 32px 32px;
            pointer-events: none;
            z-index: 0;
        }

        /* Ambient Cyan Telemetry Spotlight */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 48%, rgba(0, 210, 255, 0.07) 0%, rgba(6, 7, 9, 0.88) 75%);
            pointer-events: none;
            z-index: 1;
        }

        /* ======================================================== */
        /* CLEAN CENTERED RACING TELEMETRY ANALYZER LOADING STACK   */
        /* ======================================================== */
        .loading-workstation {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 100%;
            max-width: 960px;
            padding: 20px;
            gap: 16px;
        }

        /* 1. Header HUD Pill & Titles */
        .hud-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--rta-font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            color: var(--rta-cyan, #00d2ff);
            background: rgba(0, 210, 255, 0.06);
            border: 1px solid rgba(0, 210, 255, 0.22);
            border-radius: 4px;
            padding: 5px 14px;
            text-transform: uppercase;
            box-shadow: 0 0 12px rgba(0, 210, 255, 0.15);
        }

        .hud-status-dot {
            width: 6px;
            height: 6px;
            background: var(--rta-cyan, #00d2ff);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--rta-cyan, #00d2ff);
            animation: pulse-dot 1.4s infinite ease-in-out;
        }

        .vehicle-title {
            font-family: var(--rta-font-ui);
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 4px;
            color: #ffffff;
            text-transform: uppercase;
            text-shadow: 0 0 24px rgba(255, 255, 255, 0.18);
            line-height: 1.1;
            margin-top: 2px;
        }

        .session-subtitle {
            font-family: var(--rta-font-mono);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 2.5px;
            color: var(--rta-orange, #ff5a1f);
            text-transform: uppercase;
            text-shadow: 0 0 10px rgba(255, 90, 31, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .session-subtitle .divider {
            color: var(--rta-text-muted, #4b5263);
        }

        .session-subtitle .track-tag {
            color: var(--rta-cyan, #00d2ff);
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.35);
        }

        /* ======================================================== */
        /* 2. HERO VEHICLE SHOWCASE STAGE (LARGE & CENTERED)       */
        /* ======================================================== */
        .hero-stage-container {
            position: relative;
            width: 100%;
            max-width: 920px;
            height: 420px;
            background: radial-gradient(circle at 50% 50%, rgba(0, 210, 255, 0.05) 0%, rgba(8, 10, 15, 0.82) 80%);
            border: 1px solid rgba(0, 210, 255, 0.18);
            border-radius: 8px;
            box-shadow: 
                inset 0 0 35px rgba(0, 210, 255, 0.04),
                0 16px 45px rgba(0, 0, 0, 0.65);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin: 6px 0;
        }

        /* Corner Framing Brackets `[` and `]` matching RTA Identity */
        .corner-bracket {
            position: absolute;
            width: 22px;
            height: 22px;
            border-color: var(--rta-cyan, #00d2ff);
            border-style: solid;
            pointer-events: none;
            filter: drop-shadow(0 0 8px rgba(0, 210, 255, 0.8));
            z-index: 10;
        }
        .bracket-tl { top: 12px; left: 14px; border-width: 2.5px 0 0 2.5px; }
        .bracket-tr { top: 12px; right: 14px; border-width: 2.5px 2.5px 0 0; }
        .bracket-bl { bottom: 12px; left: 14px; border-width: 0 0 2.5px 2.5px; }
        .bracket-br { bottom: 12px; right: 14px; border-width: 0 2.5px 2.5px 0; }

        /* Vehicle Viewport & Dual-Layer SVG Stack */
        .vehicle-viewport {
            position: relative;
            width: 92%;
            height: 90%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Base Layer: Dormant Wireframe (12% opacity) */
        .silhouette-layer-base {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0.14;
            filter: drop-shadow(0 0 2px rgba(0, 210, 255, 0.3));
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        /* Active Layer: Illuminated Vector Line-Art (revealed by Laser Scanline) */
        .silhouette-layer-active {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 1;
            filter: 
                drop-shadow(0 0 8px rgba(0, 210, 255, 0.75)) 
                drop-shadow(0 0 20px rgba(0, 210, 255, 0.40));
            clip-path: inset(0 calc(100% - var(--scan-progress, 0%)) 0 0);
            pointer-events: none;
            transition: filter 0.4s ease;
        }

        /* Vector Lock State: full glowing illumination locked across entire vehicle */
        .hero-stage-container.vector-locked .silhouette-layer-active {
            filter: 
                drop-shadow(0 0 10px rgba(0, 210, 255, 0.85)) 
                drop-shadow(0 0 24px rgba(0, 210, 255, 0.50));
        }

        /* ======================================================== */
        /* INTENSE CYAN LASER SCANLINE EMITTER                     */
        /* ======================================================== */
        .laser-scan-emitter {
            position: absolute;
            top: 4%;
            bottom: 4%;
            left: var(--scan-progress, 0%);
            width: 3px;
            background: #ffffff;
            box-shadow: 
                0 0 6px #ffffff,
                0 0 14px var(--rta-cyan, #00d2ff),
                0 0 28px var(--rta-cyan, #00d2ff),
                0 0 45px rgba(0, 210, 255, 0.9);
            transform: translateX(-50%);
            pointer-events: none;
            z-index: 15;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .laser-scan-emitter::before,
        .laser-scan-emitter::after {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 8px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 12px #00d2ff, 0 0 20px #00d2ff;
        }
        .laser-scan-emitter::before { top: 0; }
        .laser-scan-emitter::after { bottom: 0; }

        /* Subtle Trailing Scan Glow */
        .laser-trailing-glow {
            position: absolute;
            top: 4%;
            bottom: 4%;
            right: calc(100% - var(--scan-progress, 0%));
            width: 80px;
            background: linear-gradient(90deg, transparent, rgba(0, 210, 255, 0.04), rgba(0, 210, 255, 0.22));
            pointer-events: none;
            z-index: 14;
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        /* ======================================================== */
        /* 3. DIAGNOSTICS TERMINAL & SYSTEM READY                  */
        /* ======================================================== */
        .diagnostics-terminal {
            width: 380px;
            max-width: 90vw;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-family: var(--rta-font-mono);
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            margin-top: 4px;
        }

        .diag-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #4b5263;
            transition: color 0.3s ease, transform 0.25s ease;
        }

        .diag-line.active {
            color: var(--rta-orange, #ff5a1f);
            animation: pulse-step 1s infinite ease-in-out;
        }

        .diag-line.completed {
            color: #d1d5db;
        }

        .diag-label {
            font-weight: 700;
            white-space: nowrap;
        }

        .diag-dots {
            flex-grow: 1;
            overflow: hidden;
            letter-spacing: 3px;
            color: #272a38;
            margin: 0 8px;
            white-space: nowrap;
        }

        .diag-status {
            font-weight: 800;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: #4b5263;
            min-width: 36px;
            text-align: right;
            transition: all 0.25s ease;
        }

        .diag-line.active .diag-status {
            color: var(--rta-orange, #ff5a1f);
            text-shadow: 0 0 8px rgba(255, 90, 31, 0.5);
        }

        .diag-line.completed .diag-status {
            color: var(--rta-cyan, #00d2ff);
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.7);
        }

        /* System Ready Banner */
        .system-ready-banner {
            font-family: var(--rta-font-mono);
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 5px;
            color: var(--rta-cyan, #00d2ff);
            opacity: 0;
            transform: translateY(6px);
            transition: opacity 0.4s ease, transform 0.4s ease;
            text-shadow: 0 0 20px rgba(0, 210, 255, 0.8), 0 0 35px rgba(0, 210, 255, 0.4);
            min-height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .system-ready-banner.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Keyframes */
        @@keyframes pulse-step {
            0%, 100% { opacity: 0.85; transform: translateX(0); }
            50% { opacity: 1; transform: translateX(3px); text-shadow: 0 0 8px rgba(255, 90, 31, 0.5); }
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 0.5; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        /* Accessibility: Reduced Motion */
        @@media (prefers-reduced-motion: reduce) {
            .laser-scan-emitter, .laser-trailing-glow { display: none !important; }
            .silhouette-layer-active { clip-path: none !important; opacity: 1 !important; }
            .system-ready-banner { opacity: 1 !important; transform: none !important; }
            .diag-line { color: #d1d5db !important; }
            .diag-status { color: var(--rta-cyan, #00d2ff) !important; text-shadow: none !important; }
        }

        /* Responsive Scaling for 1600x900 & 1366x768 */
        @@media (max-width: 1400px) {
            .hero-stage-container { height: 380px; max-width: 860px; }
            .vehicle-title { font-size: 1.9rem; }
        }

        @@media (max-height: 800px) {
            .hero-stage-container { height: 320px; max-width: 780px; }
            .vehicle-title { font-size: 1.6rem; }
            .loading-workstation { gap: 10px; }
        }
    </style>
</head>
<body>
    <div class="loading-workstation">

        <!-- 1. HEADER HUD IDENTITY -->
        <div class="hud-status-badge">
            <span class="hud-status-dot"></span> RACING TELEMETRY ANALYZER
        </div>

        <div class="vehicle-title">@vehicleName</div>
        <div class="session-subtitle">
            <span>@(isBike ? "MOTOGP RACING MOTORCYCLE" : "GT3 RACING CAR")</span>
            <span class="divider">/</span>
            <span class="track-tag">@trackName</span>
        </div>

        <!-- 2. HERO VEHICLE SHOWCASE STAGE (LARGE & CENTERED) -->
        <div class="hero-stage-container" id="heroStage">
            <!-- Corner Framing Brackets -->
            <div class="corner-bracket bracket-tl"></div>
            <div class="corner-bracket bracket-tr"></div>
            <div class="corner-bracket bracket-bl"></div>
            <div class="corner-bracket bracket-br"></div>

            <!-- Laser Scanline & Follow Glow -->
            <div class="laser-trailing-glow" id="laserGlow"></div>
            <div class="laser-scan-emitter" id="laserEmitter"></div>

            <!-- Dual-Layer Vehicle Vector Line-Art -->
            <div class="vehicle-viewport">
                @if (isBike)
                {
                    <!-- DORMANT WIREFRAME LAYER (14% Opacity) -->
                    <img src="/images/loading/motogp-racing-loader.svg" alt="MotoGP Prototype Silhouette Base" class="silhouette-layer-base" />

                    <!-- ACTIVE RECONSTRUCTED LAYER (Revealed by Laser Scanline) -->
                    <img src="/images/loading/motogp-racing-loader.svg" alt="MotoGP Prototype Silhouette Reconstructed" class="silhouette-layer-active" id="activeSil" />
                }
                else
                {
                    <!-- DORMANT WIREFRAME LAYER (14% Opacity) -->
                    <img src="/images/loading/gt3-racing-loader.svg" alt="GT3 Racing Car Silhouette Base" class="silhouette-layer-base" />

                    <!-- ACTIVE RECONSTRUCTED LAYER (Revealed by Laser Scanline) -->
                    <img src="/images/loading/gt3-racing-loader.svg" alt="GT3 Racing Car Silhouette Reconstructed" class="silhouette-layer-active" id="activeSil" />
                }
            </div>
        </div>

        <!-- 3. DIAGNOSTICS TERMINAL -->
        <div class="diagnostics-terminal">
            <div class="diag-line" id="diag-0">
                <span class="diag-label">VEHICLE SYSTEM</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-0">--</span>
            </div>
            <div class="diag-line" id="diag-1">
                <span class="diag-label">TELEMETRY</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-1">--</span>
            </div>
            <div class="diag-line" id="diag-2">
                <span class="diag-label">TRACK</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-2">--</span>
            </div>
            <div class="diag-line" id="diag-3">
                <span class="diag-label">SESSION</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-3">--</span>
            </div>
        </div>

        <!-- 4. SYSTEM READY BANNER -->
        <div class="system-ready-banner" id="readyBanner">
            <span>[ SYSTEM READY ]</span>
        </div>

    </div>

    <!-- ======================================================== -->
    <!-- MEASURED 6-PHASE MOTORSPORT ANIMATION SEQUENCE           -->
    <!-- ======================================================== -->
    <script>
        const heroStage = document.getElementById('heroStage');
        const laserEmitter = document.getElementById('laserEmitter');
        const laserGlow = document.getElementById('laserGlow');
        const readyBanner = document.getElementById('readyBanner');

        const vehicleId = '@vehicleId';
        const trackId = '@trackId';

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReducedMotion) {
            document.documentElement.style.setProperty('--scan-progress', '100%');
            ['status-0', 'status-1', 'status-2', 'status-3'].forEach(id => {
                const el = document.getElementById(id);
                if (el) { el.textContent = 'OK'; el.parentElement.classList.add('completed'); }
            });
            if (readyBanner) readyBanner.classList.add('visible');
            setTimeout(() => {
                window.location.href = '/Telemetry?vehicleId=' + vehicleId + '&trackId=' + trackId;
            }, 1200);
        } else {
            // PHASE 1: INITIALIZATION (0ms - 600ms)
            // Screen renders dark with wireframe vehicle outline at 14% opacity

            // PHASE 2: LASER SCAN & PROGRESSIVE RECONSTRUCTION (600ms - 2100ms)
            setTimeout(() => {
                if (laserEmitter) laserEmitter.style.opacity = '1';
                if (laserGlow) laserGlow.style.opacity = '1';

                const scanStartTime = performance.now();
                const scanDuration = 1500; // 1.5s smooth sweep across vehicle from left to right

                function animateLaserScan(currentTime) {
                    const elapsed = currentTime - scanStartTime;
                    const progress = Math.min(1.0, elapsed / scanDuration);

                    // Smooth easeInOutQuad curve
                    const easeProgress = progress < 0.5
                        ? 2 * progress * progress
                        : 1 - Math.pow(-2 * progress + 2, 2) / 2;

                    const currentPct = (easeProgress * 100).toFixed(2);
                    document.documentElement.style.setProperty('--scan-progress', currentPct + '%');

                    if (progress < 1.0) {
                        requestAnimationFrame(animateLaserScan);
                    } else {
                        // Scan reaches 100%
                        document.documentElement.style.setProperty('--scan-progress', '100%');
                        if (laserEmitter) laserEmitter.style.opacity = '0';
                        if (laserGlow) laserGlow.style.opacity = '0';

                        // PHASE 3: VECTOR LOCK (2100ms - 2400ms)
                        if (heroStage) heroStage.classList.add('vector-locked');
                    }
                }

                requestAnimationFrame(animateLaserScan);
            }, 600);

            // PHASE 4: SYSTEM DIAGNOSTICS SEQUENTIAL REVEAL (2400ms - 3400ms)
            const stages = [
                { lineId: 'diag-0', statusId: 'status-0', startAt: 2400, doneAt: 2700 },
                { lineId: 'diag-1', statusId: 'status-1', startAt: 2700, doneAt: 3000 },
                { lineId: 'diag-2', statusId: 'status-2', startAt: 3000, doneAt: 3300 },
                { lineId: 'diag-3', statusId: 'status-3', startAt: 3300, doneAt: 3600 }
            ];

            stages.forEach(stage => {
                setTimeout(() => {
                    const line = document.getElementById(stage.lineId);
                    const status = document.getElementById(stage.statusId);
                    if (line) line.classList.add('active');
                    if (status) status.textContent = '...';
                }, stage.startAt);

                setTimeout(() => {
                    const line = document.getElementById(stage.lineId);
                    const status = document.getElementById(stage.statusId);
                    if (line) {
                        line.classList.remove('active');
                        line.classList.add('completed');
                    }
                    if (status) status.textContent = 'OK';
                }, stage.doneAt);
            });

            // PHASE 5: TELEMETRY DATA LOCK & SYSTEM READY BANNER (3700ms)
            setTimeout(() => {
                if (readyBanner) readyBanner.classList.add('visible');
            }, 3700);

            // PHASE 6: SEAMLESS TRANSITION TO TELEMETRY WORKSTATION (4400ms)
            setTimeout(() => {
                window.location.href = '/Telemetry?vehicleId=' + vehicleId + '&trackId=' + trackId;
            }, 4400);
        }
    </script>
</body>
</html>

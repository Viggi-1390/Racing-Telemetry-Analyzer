@{
    Layout = null;
    var vehicle = ViewBag.Vehicle as RacingTelemetryAnalyzer.Models.Vehicle;
    var track = ViewBag.Track as RacingTelemetryAnalyzer.Models.Track;
    var isBike = vehicle != null && vehicle.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Bike;
    var vehicleName = vehicle?.Name ?? "UNKNOWN";
    var vehicleClass = vehicle?.Class ?? "RACE";
    var vehicleId = vehicle?.VehicleId ?? 1;
    var trackName = track?.Name ?? "UNKNOWN TRACK";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initializing Telemetry — @vehicleName</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0a0a0c;
            color: #e0e0e0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        /* Subtle grid background */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .loading-container {
            text-align: center;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
        }

        .vehicle-name {
            font-size: 2.5rem;
            font-weight: bold;
            letter-spacing: 4px;
            color: #fff;
            text-shadow: 0 0 20px rgba(255,255,255,0.15);
        }

        .vehicle-class {
            font-size: 1.1rem;
            color: #ff4500;
            letter-spacing: 3px;
            margin-top: -15px;
        }

        .status-title {
            font-size: 0.85rem;
            color: #555;
            letter-spacing: 2px;
            margin-top: 10px;
        }

        /* Checklist */
        .checklist {
            list-style: none;
            text-align: left;
            font-family: monospace;
            font-size: 0.95rem;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 260px;
        }

        .checklist li {
            color: #444;
            transition: color 0.4s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .checklist li.done {
            color: #00ffcc;
        }

        .checklist li.active {
            color: #ff4500;
        }

        .check-icon {
            width: 16px;
            display: inline-block;
            text-align: center;
        }

        /* Ready text */
        .ready-text {
            font-size: 1.2rem;
            letter-spacing: 4px;
            color: #00ffcc;
            opacity: 0;
            transition: opacity 0.5s;
            text-shadow: 0 0 15px rgba(0,255,204,0.5);
        }

        .ready-text.visible {
            opacity: 1;
        }

        /* Progress bar */
        .progress-wrapper {
            width: 300px;
        }

        .progress-track {
            height: 6px;
            background: #1a1a24;
            border: 1px solid #2a2a36;
            border-radius: 3px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #ff4500, #00ffcc);
            border-radius: 3px;
            transition: width 0.4s ease;
        }

        .progress-pct {
            font-family: monospace;
            font-size: 0.85rem;
            color: #555;
            margin-top: 6px;
            letter-spacing: 2px;
        }
        /* Vehicle Silhouette */
        .silhouette-wrapper {
            width: 500px;
            height: 250px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            border: 1px solid rgba(0, 212, 255, 0.25);
            background: rgba(0, 20, 28, 0.35);
            border-radius: 6px;
            box-shadow: inset 0 0 25px rgba(0, 212, 255, 0.05), 0 0 15px rgba(0, 212, 255, 0.1);
        }

        /* Tech frame corner brackets */
        .silhouette-wrapper::before,
        .silhouette-wrapper::after {
            content: '';
            position: absolute;
            width: 18px;
            height: 18px;
            border-color: #00d4ff;
            border-style: solid;
            pointer-events: none;
        }
        .silhouette-wrapper::before {
            top: -1px; left: -1px;
            border-width: 2px 0 0 2px;
        }
        .silhouette-wrapper::after {
            top: -1px; right: -1px;
            border-width: 2px 2px 0 0;
        }
        .corner-bl, .corner-br {
            position: absolute;
            width: 18px;
            height: 18px;
            border-color: #00d4ff;
            border-style: solid;
            pointer-events: none;
        }
        .corner-bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; }
        .corner-br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }

        .ground-line {
            position: absolute;
            bottom: 22px;
            left: 5%;
            width: 90%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0,212,255,0.15), rgba(0,212,255,0.35), rgba(0,212,255,0.15), transparent);
            z-index: 1;
        }

        .silhouette-svg {
            width: 92%;
            height: 88%;
            opacity: 0;
            transition: opacity 0.8s ease;
            filter: drop-shadow(0 0 12px rgba(0, 212, 255, 0.35));
            z-index: 2;
        }
        .silhouette-svg.visible { opacity: 1; }

        .silhouette-path {
            fill: none;
            stroke: #00d4ff;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 1200;
            stroke-dashoffset: 1200;
            transition: stroke-dashoffset 3s ease-in-out;
        }
        .silhouette-path.thin {
            stroke-width: 1.4;
            opacity: 0.75;
        }
        .silhouette-path.ground {
            stroke-width: 1.2;
            stroke-dasharray: 400;
            stroke-dashoffset: 400;
            opacity: 0.4;
        }
        .silhouette-path.accent {
            stroke-width: 2.5;
        }

        .silhouette-svg.visible .silhouette-path {
            stroke-dashoffset: 0;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <div class="vehicle-name">@vehicleName</div>
        <div class="vehicle-class">@vehicleClass | @trackName</div>

        <div class="status-title">INITIALIZING TELEMETRY SYSTEM</div>

        <ul class="checklist" id="checklist">
            <li id="step-0"><span class="check-icon">○</span> Vehicle Configuration</li>
            <li id="step-1"><span class="check-icon">○</span> Telemetry Channels</li>
            <li id="step-2"><span class="check-icon">○</span> Track Database</li>
            <li id="step-3"><span class="check-icon">○</span> Session Data</li>
            <li id="step-4"><span class="check-icon">○</span> Finalizing</li>
        </ul>

        <div class="silhouette-wrapper">
            <div class="corner-bl"></div>
            <div class="corner-br"></div>
            <div class="ground-line"></div>
            @if (isBike)
            {
                <svg class="silhouette-svg" id="silhouette" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
                    <!-- Technical Axis / Ground Grid -->
                    <line x1="20" y1="168" x2="380" y2="168" class="silhouette-path ground" />
                    <line x1="15" y1="172" x2="385" y2="172" class="silhouette-path ground" style="stroke-dasharray: 8 6;" />

                    <!-- Front Wheel & Disc Brake -->
                    <circle cx="305" cy="144" r="24" class="silhouette-path accent" />
                    <circle cx="305" cy="144" r="16" class="silhouette-path thin" />
                    <circle cx="305" cy="144" r="9" class="silhouette-path thin" style="stroke-dasharray: 4 3;" />
                    <circle cx="305" cy="144" r="4" class="silhouette-path" />
                    <!-- Front Wheel Spokes -->
                    <line x1="305" y1="128" x2="305" y2="160" class="silhouette-path thin" />
                    <line x1="289" y1="144" x2="321" y2="144" class="silhouette-path thin" />
                    <line x1="294" y1="133" x2="316" y2="155" class="silhouette-path thin" />
                    <line x1="294" y1="155" x2="316" y2="133" class="silhouette-path thin" />

                    <!-- Rear Wheel, Sprocket & Brake -->
                    <circle cx="95" cy="144" r="24" class="silhouette-path accent" />
                    <circle cx="95" cy="144" r="16" class="silhouette-path thin" />
                    <circle cx="95" cy="144" r="11" class="silhouette-path thin" style="stroke-dasharray: 4 3;" />
                    <circle cx="95" cy="144" r="4" class="silhouette-path" />
                    <!-- Rear Wheel Spokes -->
                    <line x1="95" y1="128" x2="95" y2="160" class="silhouette-path thin" />
                    <line x1="79" y1="144" x2="111" y2="144" class="silhouette-path thin" />
                    <line x1="84" y1="133" x2="106" y2="155" class="silhouette-path thin" />
                    <line x1="84" y1="155" x2="106" y2="133" class="silhouette-path thin" />

                    <!-- Front Mudguard / Tire Hugger -->
                    <path d="M 326 132 C 326 116, 292 112, 282 128" class="silhouette-path thin" />

                    <!-- Inverted Front Forks & Triple Clamp -->
                    <path d="M 305 144 L 268 64" class="silhouette-path accent" />
                    <path d="M 299 144 L 263 66" class="silhouette-path thin" />
                    <path d="M 260 62 L 274 65" class="silhouette-path" />

                    <!-- Clip-on Handlebars & Lever -->
                    <path d="M 264 63 L 252 58 L 246 62" class="silhouette-path accent" />
                    <path d="M 252 58 L 244 55" class="silhouette-path thin" />

                    <!-- Front Nose Fairing & Aerodynamic Windscreen -->
                    <path d="M 318 84 L 326 92 L 302 98 L 282 82 L 268 56 C 264 42, 252 38, 240 44 L 248 58" class="silhouette-path accent" />

                    <!-- Fairing Winglet / Aero Element -->
                    <path d="M 314 90 L 328 92 L 320 98 L 306 96" class="silhouette-path" />

                    <!-- Muscular Fuel Tank & Airbox Cover -->
                    <path d="M 248 58 C 238 52, 222 52, 206 60 C 194 66, 185 78, 178 86" class="silhouette-path accent" />
                    <path d="M 226 56 C 218 64, 212 74, 208 84" class="silhouette-path thin" />

                    <!-- Twin-Spar Aluminum Perimeter Frame -->
                    <path d="M 264 68 L 220 88 L 182 112 L 174 134" class="silhouette-path accent" />
                    <path d="M 220 88 L 210 114 L 182 112" class="silhouette-path thin" />

                    <!-- Aggressive Racing Seat & Upswept Aerodynamic Tail Cowl -->
                    <path d="M 178 86 C 168 96, 154 98, 142 96 L 96 66 L 72 58 L 78 70 L 114 96 L 142 104" class="silhouette-path accent" />
                    <path d="M 142 96 L 140 104" class="silhouette-path thin" />
                    <path d="M 96 66 L 118 86" class="silhouette-path thin" />

                    <!-- Racing Belly Pan & Side Fairing -->
                    <path d="M 302 98 L 286 122 L 262 144 L 218 154 L 172 152 L 174 134 L 204 126 L 246 116 L 282 82" class="silhouette-path" />
                    <!-- Side Fairing Air Extractor Vents -->
                    <path d="M 272 108 L 254 122" class="silhouette-path thin" />
                    <path d="M 262 118 L 248 130" class="silhouette-path thin" />

                    <!-- Rear Swingarm (Gull-wing / TracTive style) -->
                    <path d="M 174 134 L 140 126 L 95 144" class="silhouette-path accent" />
                    <path d="M 174 134 L 135 142 L 95 144" class="silhouette-path thin" />
                    <circle cx="174" cy="134" r="3" class="silhouette-path" />

                    <!-- Rear Monoshock Suspension -->
                    <path d="M 168 108 L 160 130" class="silhouette-path thin" />
                    <path d="M 163 114 L 167 124" class="silhouette-path thin" style="stroke-dasharray: 2 2;" />

                    <!-- High-Mount Akrapovič-Style Titanium Exhaust & Link Pipe -->
                    <path d="M 202 152 C 180 156, 160 154, 145 146 L 118 128 L 76 98 L 70 105 L 112 136 L 136 148" class="silhouette-path" />
                    <!-- Exhaust Endcap & Carbon Band -->
                    <path d="M 76 98 L 70 105 L 68 103 L 74 96 Z" class="silhouette-path accent" />
                    <line x1="92" y1="110" x2="88" y2="116" class="silhouette-path thin" />

                    <!-- Technical Telemetry Reticle Marks -->
                    <path d="M 388 50 L 395 50 L 395 57" class="silhouette-path thin" />
                    <path d="M 12 50 L 5 50 L 5 57" class="silhouette-path thin" />
                </svg>
            }
            else
            {
                <svg class="silhouette-svg" id="silhouette" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
                    <!-- Technical Axis / Ground Grid -->
                    <line x1="20" y1="168" x2="380" y2="168" class="silhouette-path ground" />
                    <line x1="15" y1="172" x2="385" y2="172" class="silhouette-path ground" style="stroke-dasharray: 8 6;" />

                    <!-- Rear Wing & Endplate -->
                    <path d="M 45 68 L 92 68 L 86 78 L 48 78 Z" class="silhouette-path accent" />
                    <path d="M 42 60 L 50 60 L 46 95 L 38 95 Z" class="silhouette-path" />
                    <path d="M 68 78 L 74 112" class="silhouette-path" />
                    <path d="M 82 78 L 86 108" class="silhouette-path thin" />

                    <!-- Shark Fin -->
                    <path d="M 185 64 L 125 96 L 125 110" class="silhouette-path thin" />

                    <!-- Main Body Silhouette (Nose to Tail via Roofline) -->
                    <path d="M 382 152 
                             L 384 158 
                             L 352 158 
                             L 350 148 
                             C 345 125, 305 125, 300 148 
                             L 155 148 
                             C 150 125, 110 125, 105 148 
                             L 58 148 
                             L 52 158 
                             L 44 158 
                             L 48 138 
                             C 55 125, 75 116, 105 112 
                             L 165 106 
                             L 182 64 
                             L 228 64 
                             C 255 64, 280 88, 305 115 
                             L 355 132 
                             C 372 138, 380 145, 382 152 Z" class="silhouette-path accent" />

                    <!-- Front Aero / Splitter & Canards -->
                    <path d="M 358 134 L 386 142" class="silhouette-path" />
                    <path d="M 352 142 L 382 148" class="silhouette-path thin" />
                    <path d="M 370 158 L 388 158 L 390 162 L 350 162" class="silhouette-path" />

                    <!-- Cockpit Canopy / Windshield / Windows -->
                    <path d="M 224 68 
                             C 246 68, 268 88, 288 112 
                             L 205 112 
                             L 188 72 
                             L 224 68 Z" class="silhouette-path" />
                    <path d="M 235 72 L 230 110" class="silhouette-path thin" />

                    <!-- Side Intake & Aero Body Crease -->
                    <path d="M 288 118 C 255 124, 215 124, 185 116 L 175 138 L 195 142 L 275 136" class="silhouette-path thin" />
                    <path d="M 185 116 L 145 120" class="silhouette-path thin" />

                    <!-- Rear Diffuser Strakes -->
                    <path d="M 44 158 L 56 166 L 75 166" class="silhouette-path" />
                    <line x1="55" y1="158" x2="62" y2="166" class="silhouette-path thin" />
                    <line x1="65" y1="158" x2="70" y2="166" class="silhouette-path thin" />

                    <!-- Front Wheel Assembly -->
                    <circle cx="325" cy="148" r="20" class="silhouette-path accent" />
                    <circle cx="325" cy="148" r="14" class="silhouette-path thin" />
                    <circle cx="325" cy="148" r="4" class="silhouette-path" />
                    <!-- Front Wheel Spokes -->
                    <line x1="325" y1="134" x2="325" y2="162" class="silhouette-path thin" />
                    <line x1="311" y1="148" x2="339" y2="148" class="silhouette-path thin" />
                    <line x1="315" y1="138" x2="335" y2="158" class="silhouette-path thin" />
                    <line x1="315" y1="158" x2="335" y2="138" class="silhouette-path thin" />

                    <!-- Rear Wheel Assembly -->
                    <circle cx="130" cy="148" r="20" class="silhouette-path accent" />
                    <circle cx="130" cy="148" r="14" class="silhouette-path thin" />
                    <circle cx="130" cy="148" r="4" class="silhouette-path" />
                    <!-- Rear Wheel Spokes -->
                    <line x1="130" y1="134" x2="130" y2="162" class="silhouette-path thin" />
                    <line x1="116" y1="148" x2="144" y2="148" class="silhouette-path thin" />
                    <line x1="120" y1="138" x2="140" y2="158" class="silhouette-path thin" />
                    <line x1="120" y1="158" x2="140" y2="138" class="silhouette-path thin" />

                    <!-- Technical Telemetry Reticle Marks -->
                    <path d="M 388 50 L 395 50 L 395 57" class="silhouette-path thin" />
                    <path d="M 12 50 L 5 50 L 5 57" class="silhouette-path thin" />
                </svg>
            }
        </div>

        <div class="ready-text" id="ready-text">TELEMETRY READY</div>

        <div class="progress-wrapper">
            <div class="progress-track">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <div class="progress-pct" id="progress-pct">0%</div>
        </div>
    </div>

    <script>
        const steps = [
            { el: document.getElementById('step-0'), pct: 20, delay: 0 },
            { el: document.getElementById('step-1'), pct: 40, delay: 500 },
            { el: document.getElementById('step-2'), pct: 65, delay: 1000 },
            { el: document.getElementById('step-3'), pct: 85, delay: 1700 },
            { el: document.getElementById('step-4'), pct: 100, delay: 2400 }
        ];

        const fill = document.getElementById('progress-fill');
        const pct = document.getElementById('progress-pct');
        const readyText = document.getElementById('ready-text');
        const silhouette = document.getElementById('silhouette');

        const trackId = '@(track?.TrackId ?? 0)';

        // Start drawing the silhouette
        setTimeout(() => {
            if (silhouette) silhouette.classList.add('visible');
        }, 200);

        steps.forEach((step, i) => {
            setTimeout(() => {
                // Mark previous as complete
                if (i > 0) {
                    const prevStep = document.getElementById('step-' + (i - 1));
                    prevStep.classList.remove('active');
                    prevStep.classList.add('completed');
                    prevStep.querySelector('.check-icon').innerText = '✓';
                }

                // Mark current as active
                const currStep = document.getElementById('step-' + i);
                currStep.classList.add('active');
                currStep.querySelector('.check-icon').innerText = '●';
                
                // Update progress bar
                const percentage = Math.round(((i + 1) / steps.length) * 100);
                fill.style.width = percentage + '%';
                pct.innerText = percentage + '%';

                // If last step, wait and finish
                if (i === steps.length - 1) {
                    setTimeout(() => {
                        currStep.classList.remove('active');
                        currStep.classList.add('completed');
                        currStep.querySelector('.check-icon').innerText = '✓';
                        
                        // Show READY
                        readyText.classList.add('visible');

                        // Navigate to telemetry page
                        setTimeout(() => {
                            window.location.href = '/Telemetry?vehicleId=@vehicleId&trackId=' + trackId;
                        }, 800);
                    }, 500);
                }
            }, step.delay);
        });
    </script>
</body>
</html>

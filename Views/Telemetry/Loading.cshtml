@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var vehicle = ViewBag.Vehicle as RacingTelemetryAnalyzer.Models.Vehicle;
    var track = ViewBag.Track as RacingTelemetryAnalyzer.Models.Track;
    var isBike = vehicle != null && vehicle.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Bike;
    var vehicleName = vehicle?.Name ?? "UNKNOWN VEHICLE";
    var vehicleClass = vehicle?.Class ?? "RACE";
    var vehicleId = vehicle?.VehicleId ?? 1;
    var trackName = track?.Name ?? "MONZA";
    var trackId = track?.TrackId ?? 1;

    // Load universal category SVG directly from wwwroot for guaranteed in-DOM vector animation
    var svgFileName = isBike ? "motogp-racing-loader.svg" : "gt3-racing-loader.svg";
    var svgFilePath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "images", "loading", svgFileName);
    var rawSvg = System.IO.File.Exists(svgFilePath) ? System.IO.File.ReadAllText(svgFilePath) : "";

    // Prefix IDs in the dormant layer to eliminate DOM ID collisions
    var dormantSvg = rawSvg.Replace("id=\"", "id=\"dormant-").Replace("url(#", "url(#dormant-").Replace("href=\"#", "href=\"#dormant-");
    var activeSvg = rawSvg;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Initializing Telemetry — @vehicleName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/racing-design-system.css" />
    <style>
        :root {
            --rta-bg-abyss:         #060709;
            --rta-bg-surface-1:     #0d1017;
            --rta-bg-surface-2:     #131722;
            --rta-orange:           #ff5a1f;
            --rta-orange-glow:      rgba(255, 90, 31, 0.40);
            --rta-cyan:             #00d2ff;
            --rta-cyan-bright:      #00f0ff;
            --rta-cyan-glow:        rgba(0, 210, 255, 0.45);
            --rta-text-primary:     #f4f4f5;
            --rta-text-secondary:   #8e95a5;
            --rta-text-muted:       #4b5263;
            --rta-font-ui:          'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --rta-font-mono:        'JetBrains Mono', 'Consolas', 'SF Mono', monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--rta-bg-abyss, #060709);
            color: var(--rta-text-primary, #f4f4f5);
            font-family: var(--rta-font-ui, sans-serif);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* 32px Technical CAD Coordinate Grid */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                radial-gradient(circle at 1px 1px, rgba(0, 210, 255, 0.08) 1px, transparent 0),
                linear-gradient(to right, rgba(0, 210, 255, 0.025) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 210, 255, 0.025) 1px, transparent 1px);
            background-size: 32px 32px;
            pointer-events: none;
            z-index: 0;
        }

        /* Ambient Cyan Telemetry Spotlight */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at 50% 48%, rgba(0, 210, 255, 0.07) 0%, rgba(6, 7, 9, 0.88) 75%);
            pointer-events: none;
            z-index: 1;
        }

        /* ======================================================== */
        /* CLEAN CENTERED RACING TELEMETRY ANALYZER LOADING STACK   */
        /* ======================================================== */
        .loading-workstation {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 100%;
            max-width: 960px;
            padding: 20px;
            gap: 16px;
        }

        /* 1. Header HUD Pill & Titles */
        .hud-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: var(--rta-font-mono);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            color: var(--rta-cyan, #00d2ff);
            background: rgba(0, 210, 255, 0.06);
            border: 1px solid rgba(0, 210, 255, 0.22);
            border-radius: 4px;
            padding: 5px 14px;
            text-transform: uppercase;
            box-shadow: 0 0 12px rgba(0, 210, 255, 0.15);
        }

        .hud-status-dot {
            width: 6px;
            height: 6px;
            background: var(--rta-cyan, #00d2ff);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--rta-cyan, #00d2ff);
            animation: pulse-dot 1.4s infinite ease-in-out;
        }

        .vehicle-title {
            font-family: var(--rta-font-ui);
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 4px;
            color: #ffffff;
            text-transform: uppercase;
            text-shadow: 0 0 24px rgba(255, 255, 255, 0.18);
            line-height: 1.1;
            margin-top: 2px;
        }

        .session-subtitle {
            font-family: var(--rta-font-mono);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 2.5px;
            color: var(--rta-orange, #ff5a1f);
            text-transform: uppercase;
            text-shadow: 0 0 10px rgba(255, 90, 31, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .session-subtitle .divider {
            color: var(--rta-text-muted, #4b5263);
        }

        .session-subtitle .track-tag {
            color: var(--rta-cyan, #00d2ff);
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.35);
        }

        /* ======================================================== */
        /* 2. HERO VEHICLE SHOWCASE STAGE (LARGE & CENTERED)       */
        /* ======================================================== */
        .hero-stage-container {
            position: relative;
            width: 100%;
            max-width: 940px;
            height: 430px;
            background: radial-gradient(circle at 50% 50%, rgba(0, 210, 255, 0.06) 0%, rgba(8, 10, 15, 0.85) 80%);
            border: 1px solid rgba(0, 210, 255, 0.20);
            border-radius: 8px;
            box-shadow: 
                inset 0 0 35px rgba(0, 210, 255, 0.05),
                0 16px 45px rgba(0, 0, 0, 0.65);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin: 6px 0;
        }

        /* Corner Framing Brackets `[` and `]` matching RTA Identity */
        .corner-bracket {
            position: absolute;
            width: 22px;
            height: 22px;
            border-color: var(--rta-cyan, #00d2ff);
            border-style: solid;
            pointer-events: none;
            filter: drop-shadow(0 0 8px rgba(0, 210, 255, 0.8));
            z-index: 10;
        }
        .bracket-tl { top: 12px; left: 14px; border-width: 2.5px 0 0 2.5px; }
        .bracket-tr { top: 12px; right: 14px; border-width: 2.5px 2.5px 0 0; }
        .bracket-bl { bottom: 12px; left: 14px; border-width: 0 0 2.5px 2.5px; }
        .bracket-br { bottom: 12px; right: 14px; border-width: 0 2.5px 2.5px 0; }

        /* Vehicle Viewport */
        .vehicle-viewport {
            position: relative;
            width: 94%;
            height: 92%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* ======================================================== */
        /* PHASE 1: DORMANT WIREFRAME LAYER (0.0s - 0.6s)          */
        /* Faint 12% opacity outline visible from initial render    */
        /* ======================================================== */
        .layer-dormant {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0.12;
            filter: drop-shadow(0 0 2px rgba(0, 210, 255, 0.25));
            pointer-events: none;
            z-index: 5;
        }

        /* ======================================================== */
        /* PHASE 2: ACTIVE RECONSTRUCTION (0.6s - 2.0s)             */
        /* Laser scan sweeps from left to right via clip-path       */
        /* ======================================================== */
        .layer-active {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 6;
            filter: 
                drop-shadow(0 0 8px rgba(0, 210, 255, 0.75)) 
                drop-shadow(0 0 20px rgba(0, 210, 255, 0.40));
            /* Start fully clipped from right edge */
            clip-path: inset(0% 100% 0% 0%);
            /* Hardware-accelerated sweep reveal timed at 0.6s - 2.0s */
            animation: 
                sweepReveal 1.4s linear 0.6s both,
                vectorLockGlow 0.5s ease-out 2.0s forwards;
        }

        @@keyframes sweepReveal {
            0% {
                clip-path: inset(0% 100% 0% 0%);
            }
            100% {
                clip-path: inset(0% 0% 0% 0%);
            }
        }

        @@keyframes vectorLockGlow {
            0% {
                filter: drop-shadow(0 0 8px rgba(0, 210, 255, 0.75)) drop-shadow(0 0 20px rgba(0, 210, 255, 0.40));
            }
            50% {
                filter: drop-shadow(0 0 16px rgba(0, 240, 255, 0.95)) drop-shadow(0 0 34px rgba(0, 210, 255, 0.60));
            }
            100% {
                filter: drop-shadow(0 0 10px rgba(0, 210, 255, 0.85)) drop-shadow(0 0 24px rgba(0, 210, 255, 0.45));
            }
        }

        /* SVG Path Stroke Drawing Animation */
        .layer-active .stroke-animate {
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
            animation: drawStroke 1.3s ease-out 0.6s forwards;
        }

        @@keyframes drawStroke {
            0% {
                stroke-dashoffset: 1;
            }
            100% {
                stroke-dashoffset: 0;
            }
        }

        /* ======================================================== */
        /* HIGH-VISIBILITY CYAN LASER SCAN BEAM                    */
        /* Crosses smoothly from left to right (0.6s - 2.0s)        */
        /* ======================================================== */
        .scan-laser-beam {
            position: absolute;
            top: 4px;
            bottom: 4px;
            width: 4px;
            left: 0;
            opacity: 0;
            transform: translateX(-50%);
            pointer-events: none;
            z-index: 25;
            background: #ffffff;
            box-shadow: 
                0 0 4px #ffffff,
                0 0 12px #00f0ff,
                0 0 24px #00d2ff,
                0 0 40px rgba(0, 210, 255, 0.95),
                0 0 70px rgba(0, 210, 255, 0.60);
            animation: laserSweep 1.4s linear 0.6s both;
        }

        .scan-laser-beam::before,
        .scan-laser-beam::after {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 10px;
            height: 10px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 10px #ffffff, 0 0 20px #00f0ff, 0 0 30px #00d2ff;
        }
        .scan-laser-beam::before { top: -2px; }
        .scan-laser-beam::after { bottom: -2px; }

        .laser-trail {
            position: absolute;
            top: 0;
            bottom: 0;
            right: 100%;
            width: 120px;
            background: linear-gradient(90deg, transparent 0%, rgba(0, 210, 255, 0.04) 40%, rgba(0, 210, 255, 0.32) 100%);
            pointer-events: none;
        }

        @@keyframes laserSweep {
            0% {
                left: 0%;
                opacity: 0;
            }
            1% {
                opacity: 1;
            }
            99% {
                opacity: 1;
            }
            100% {
                left: 100%;
                opacity: 0;
            }
        }

        /* ======================================================== */
        /* PHASE 3: VECTOR LOCK PULSES (1.8s - 2.6s)                */
        /* Wheel hubs pulse, aero pulses, ground line activates     */
        /* ======================================================== */
        .layer-active .gt3-wheel-group,
        .layer-active .gp-wheel-group {
            animation: wheelPulse 0.5s ease-out 2.0s forwards;
        }

        @@keyframes wheelPulse {
            0% { filter: drop-shadow(0 0 4px #00d2ff); }
            50% { filter: drop-shadow(0 0 18px #00f0ff) drop-shadow(0 0 28px #00d2ff); transform: scale(1.02); }
            100% { filter: drop-shadow(0 0 6px #00d2ff); transform: scale(1); }
        }

        .layer-active .gt3-aero-group,
        .layer-active .gp-aero-group {
            animation: aeroPulse 0.5s ease-out 2.0s forwards;
        }

        @@keyframes aeroPulse {
            0% { opacity: 0.85; }
            50% { opacity: 1; filter: drop-shadow(0 0 16px #00f0ff); }
            100% { opacity: 1; filter: drop-shadow(0 0 8px #00d2ff); }
        }

        .layer-active .ground-stroke {
            animation: groundSurge 0.5s ease-out 2.0s forwards;
        }

        @@keyframes groundSurge {
            0% { stroke-width: 1.8; opacity: 0.8; }
            50% { stroke-width: 3.0; opacity: 1; filter: drop-shadow(0 0 14px #00f0ff); }
            100% { stroke-width: 1.8; opacity: 0.8; }
        }

        /* ======================================================== */
        /* PHASE 4: DIAGNOSTICS TERMINAL (2.4s - 3.2s)              */
        /* Sequential reveal with subtle fade & status transition   */
        /* ======================================================== */
        .diagnostics-terminal {
            width: 380px;
            max-width: 90vw;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-family: var(--rta-font-mono);
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            margin-top: 4px;
        }

        .diag-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #3b4252;
            opacity: 0.45;
            transform: translateY(3px);
            transition: opacity 0.25s ease, transform 0.25s ease, color 0.25s ease;
        }

        .diag-line.revealed {
            opacity: 1;
            transform: translateY(0);
            color: #d1d5db;
        }

        .diag-label {
            font-weight: 700;
            white-space: nowrap;
        }

        .diag-dots {
            flex-grow: 1;
            overflow: hidden;
            letter-spacing: 3px;
            color: #272a38;
            margin: 0 8px;
            white-space: nowrap;
        }

        .diag-status {
            font-weight: 800;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: #4b5263;
            min-width: 36px;
            text-align: right;
            transition: color 0.25s ease, text-shadow 0.25s ease;
        }

        .diag-line.revealed .diag-status {
            color: var(--rta-cyan, #00d2ff);
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.7);
        }

        /* ======================================================== */
        /* PHASE 5: SYSTEM READY BANNER (3.2s - 3.7s)               */
        /* ======================================================== */
        .system-ready-banner {
            font-family: var(--rta-font-mono);
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: 5px;
            color: var(--rta-cyan, #00d2ff);
            opacity: 0;
            transform: translateY(6px);
            min-height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .system-ready-banner.visible {
            opacity: 1;
            transform: translateY(0);
            animation: readyGlowPulse 0.4s ease-out forwards;
        }

        @@keyframes readyGlowPulse {
            0% {
                opacity: 0;
                transform: translateY(6px) scale(0.96);
            }
            50% {
                opacity: 1;
                transform: translateY(0) scale(1.03);
                text-shadow: 0 0 25px rgba(0, 240, 255, 0.95), 0 0 45px rgba(0, 210, 255, 0.5);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                text-shadow: 0 0 16px rgba(0, 210, 255, 0.8), 0 0 30px rgba(0, 210, 255, 0.4);
            }
        }

        @@keyframes pulse-dot {
            0%, 100% { opacity: 0.5; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.2); }
        /* Responsive Scaling */
        @@media (max-width: 1400px) {
            .hero-stage-container { height: 380px; max-width: 860px; }
            .vehicle-title { font-size: 1.9rem; }
        }

        @@media (max-height: 800px) {
            .hero-stage-container { height: 320px; max-width: 780px; }
            .vehicle-title { font-size: 1.6rem; }
            .loading-workstation { gap: 10px; }
        }
    </style>
</head>
<body>
    <div class="loading-workstation">

        <!-- 1. HEADER HUD IDENTITY -->
        <div class="hud-status-badge">
            <span class="hud-status-dot"></span> RACING TELEMETRY ANALYZER
        </div>

        <div class="vehicle-title">@vehicleName</div>
        <div class="session-subtitle">
            <span>@(isBike ? "MOTOGP RACING MOTORCYCLE" : "GT3 RACING CAR")</span>
            <span class="divider">/</span>
            <span class="track-tag">@trackName</span>
        </div>

        <!-- 2. HERO VEHICLE SHOWCASE STAGE (LARGE & CENTERED) -->
        <div class="hero-stage-container" id="heroStage">
            <!-- Corner Framing Brackets -->
            <div class="corner-bracket bracket-tl"></div>
            <div class="corner-bracket bracket-tr"></div>
            <div class="corner-bracket bracket-bl"></div>
            <div class="corner-bracket bracket-br"></div>

            <!-- Vehicle Viewport & Dual-Layer In-DOM SVG Stack -->
            <div class="vehicle-viewport">
                <!-- PHASE 1: DORMANT WIREFRAME LAYER (12% Opacity, visible from t=0.0s) -->
                <div class="layer-dormant">
                    @Html.Raw(dormantSvg)
                </div>

                <!-- PHASE 2: ACTIVE RECONSTRUCTION (Progressively revealed by CSS sweepReveal) -->
                <div class="layer-active" id="activeLayer">
                    @Html.Raw(activeSvg)
                </div>

                <!-- HIGH-VISIBILITY LASER SCAN BEAM (Sweeps left-to-right 0.6s - 2.0s) -->
                <div class="scan-laser-beam" id="scanBeam">
                    <div class="laser-trail"></div>
                </div>
            </div>
        </div>

        <!-- 3. DIAGNOSTICS TERMINAL -->
        <div class="diagnostics-terminal">
            <div class="diag-line" id="diag-0">
                <span class="diag-label">VEHICLE SYSTEM</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-0">--</span>
            </div>
            <div class="diag-line" id="diag-1">
                <span class="diag-label">TELEMETRY</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-1">--</span>
            </div>
            <div class="diag-line" id="diag-2">
                <span class="diag-label">TRACK</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-2">--</span>
            </div>
            <div class="diag-line" id="diag-3">
                <span class="diag-label">SESSION</span>
                <span class="diag-dots">...........................</span>
                <span class="diag-status" id="status-3">--</span>
            </div>
        </div>

        <!-- 4. SYSTEM READY BANNER -->
        <div class="system-ready-banner" id="readyBanner">
            <span>[ SYSTEM READY ]</span>
        </div>

    </div>

    <!-- ======================================================== -->
    <!-- LIGHTWEIGHT TIMELINE ORCHESTRATION SCRIPT                -->
    <!-- No RAF loops — pure CSS controls the visual rendering   -->
    <!-- ======================================================== -->
    <script>
        const vehicleId = '@vehicleId';
        const trackId = '@trackId';
        const readyBanner = document.getElementById('readyBanner');

        // Robust animation guarantee: if OS reduced-motion collapsed CSS duration to <100ms, run via WAAPI
        const beamEl = document.getElementById('scanBeam');
        const activeEl = document.getElementById('activeLayer');
        const beamAnims = beamEl?.getAnimations();
        if (beamAnims && beamAnims.length > 0 && (beamAnims[0].effect?.getTiming()?.duration || 0) < 100) {
            beamEl.animate([
                { left: '0%', opacity: 0 },
                { opacity: 1, offset: 0.01 },
                { opacity: 1, offset: 0.99 },
                { left: '100%', opacity: 0 }
            ], { duration: 1400, delay: 600, fill: 'both', easing: 'linear' });

            activeEl?.animate([
                { clipPath: 'inset(0% 100% 0% 0%)' },
                { clipPath: 'inset(0% 0% 0% 0%)' }
            ], { duration: 1400, delay: 600, fill: 'both', easing: 'linear' });
        }

        // PHASE 4: DIAGNOSTICS SEQUENTIAL REVEAL (2.4s - 3.2s)
        const diagSchedule = [
            { id: 'diag-0', statusId: 'status-0', at: 2400 },
            { id: 'diag-1', statusId: 'status-1', at: 2650 },
            { id: 'diag-2', statusId: 'status-2', at: 2900 },
            { id: 'diag-3', statusId: 'status-3', at: 3150 }
        ];

        diagSchedule.forEach(item => {
            setTimeout(() => {
                const row = document.getElementById(item.id);
                const status = document.getElementById(item.statusId);
                if (row) row.classList.add('revealed');
                if (status) status.textContent = 'OK';
            }, item.at);
        });

        // PHASE 5: SYSTEM READY (3.25s)
        setTimeout(() => {
            if (readyBanner) readyBanner.classList.add('visible');
        }, 3250);

        // PHASE 6: SEAMLESS TRANSITION TO WORKSTATION (3.75s)
        setTimeout(() => {
            window.location.href = '/Telemetry?vehicleId=' + vehicleId + '&trackId=' + trackId;
        }, 3750);
    </script>
</body>
</html>

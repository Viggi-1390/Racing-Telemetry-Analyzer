@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    Layout = null;
    var vehicle = ViewBag.Vehicle as RacingTelemetryAnalyzer.Models.Vehicle;
    var track = ViewBag.Track as RacingTelemetryAnalyzer.Models.Track;
    var isBike = vehicle != null && vehicle.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Bike;
    var vehicleName = vehicle?.Name ?? "AUDI R8 LMS";
    var vehicleId = vehicle?.VehicleId ?? 1;
    var trackName = track?.Name ?? "LAGUNA SECA";
    var trackId = track?.TrackId ?? 1;
    var sessionId = ViewBag.SessionId as int?;

    // Determine vehicle image path with robust fallback priority
    var imagePath = !string.IsNullOrEmpty(vehicle?.ImagePath) 
        ? vehicle.ImagePath 
        : (isBike ? "/images/bikes/MotoGPStudio.jpg" : "/images/cars/CadillacVSeriesR.jpg");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Loading Telemetry — @vehicleName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --rta-black:            #050608;
            --rta-charcoal:         #0a0c10;
            --rta-surface:          #10131a;
            --rta-red:              #ff1f38;
            --rta-red-bright:       #ff3b50;
            --rta-red-glow:         rgba(255, 31, 56, 0.45);
            --rta-red-deep-glow:    rgba(255, 31, 56, 0.18);
            --rta-text-white:       #ffffff;
            --rta-text-light:       #e2e5eb;
            --rta-text-muted:       #7a8294;
            --rta-text-dim:         #474e5d;
            --rta-border:           rgba(255, 255, 255, 0.07);
            --rta-font-main:        'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --rta-font-mono:        'JetBrains Mono', monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: var(--rta-black);
            font-family: var(--rta-font-main);
            color: var(--rta-text-white);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ======================================================== */
        /* 1. CINEMATIC MOTORSPORT BACKGROUND ENVIRONMENT          */
        /* ======================================================== */
        .cinematic-bg {
            position: fixed;
            inset: 0;
            background-image: url('/images/loading/pit-garage-background.jpg');
            background-size: cover;
            background-position: center 46%;
            background-repeat: no-repeat;
            z-index: 1;
            filter: brightness(0.92) contrast(1.08);
        }

        /* Ambient dark vignette & atmospheric contrast overlay */
        .cinematic-overlay {
            position: fixed;
            inset: 0;
            background: 
                radial-gradient(ellipse at 50% 48%, rgba(5, 6, 8, 0.15) 0%, rgba(5, 6, 8, 0.65) 60%, rgba(5, 6, 8, 0.95) 100%),
                linear-gradient(to bottom, rgba(5, 6, 8, 0.85) 0%, transparent 18%, transparent 72%, rgba(5, 6, 8, 0.92) 100%);
            z-index: 2;
            pointer-events: none;
        }

        /* ======================================================== */
        /* 2. SIGNATURE RED VERTICAL NEON LIGHT BARS               */
        /* ======================================================== */
        .vertical-neon-bar {
            position: fixed;
            width: 4px;
            top: 29%;
            bottom: 39%;
            background: #ff1f38;
            border-radius: 2px;
            z-index: 20;
            box-shadow: 
                0 0 4px #ffffff,
                0 0 10px #ff1f38,
                0 0 25px rgba(255, 31, 56, 0.85),
                0 0 50px rgba(255, 31, 56, 0.45);
        }
        .neon-left { left: 32px; }
        .neon-right { right: 32px; }

        /* ======================================================== */
        /* 3. MINIMAL TECHNICAL HEADER NAVIGATION                   */
        /* ======================================================== */
        .rta-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 64px;
            padding: 0 42px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(8, 9, 13, 0.72);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--rta-border);
            z-index: 50;
        }

        /* Brand Left */
        .brand-cluster {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .brand-logo-r {
            width: 32px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .brand-title {
            font-size: 0.88rem;
            font-weight: 800;
            letter-spacing: 2.2px;
            color: var(--rta-text-white);
            text-transform: uppercase;
        }

        /* Nav Center */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
            height: 100%;
        }
        .nav-item {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--rta-text-muted);
            text-decoration: none;
            height: 100%;
            padding: 0 4px;
        }
        .nav-item:hover {
            color: var(--rta-text-light);
        }
        .nav-item.active {
            color: var(--rta-red);
            font-weight: 600;
        }
        .nav-item.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: -4px;
            right: -4px;
            height: 2px;
            background: var(--rta-red);
            box-shadow: 0 0 8px var(--rta-red);
        }
        .nav-icon {
            width: 15px;
            height: 15px;
            fill: currentColor;
            opacity: 0.85;
        }

        /* Selectors Right */
        .selectors-cluster {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .selector-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(18, 21, 28, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--rta-text-light);
            text-decoration: none;
        }
        .selector-pill:hover {
            border-color: rgba(255, 255, 255, 0.18);
            background: rgba(24, 28, 38, 0.8);
        }
        .selector-icon {
            width: 14px;
            height: 14px;
            fill: #9ca3af;
        }
        .selector-caret {
            width: 10px;
            height: 10px;
            fill: #6b7280;
            margin-left: 2px;
        }

        /* ======================================================== */
        /* 4. MAIN CENTRAL STAGE (DYNAMIC VEHICLE SHOWCASE)        */
        /* ======================================================== */
        .stage-container {
            position: relative;
            z-index: 10;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-top: 24px;
        }

        /* Vehicle Showcase Frame */
        .vehicle-hero-wrap {
            position: relative;
            width: 100%;
            max-width: 900px;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 1000px;
        }

        /* Central Staging Floor Light & Ground Shadow */
        .vehicle-hero-wrap::before {
            content: '';
            position: absolute;
            bottom: 24px;
            width: 78%;
            height: 46px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.6) 50%, transparent 75%);
            filter: blur(12px);
            z-index: 1;
            pointer-events: none;
        }

        /* Floor Reflection Tint */
        .vehicle-hero-wrap::after {
            content: '';
            position: absolute;
            bottom: 6px;
            width: 65%;
            height: 38px;
            background: radial-gradient(ellipse at center, rgba(255, 31, 56, 0.16) 0%, rgba(255, 31, 56, 0.05) 55%, transparent 75%);
            filter: blur(10px);
            z-index: 2;
            pointer-events: none;
        }

        /* Main Vehicle Hero Image */
        .vehicle-hero-img {
            position: relative;
            z-index: 5;
            max-width: 840px;
            max-height: 400px;
            width: auto;
            height: auto;
            object-fit: contain;
            filter: 
                drop-shadow(0 0 35px rgba(255, 31, 56, 0.25)) 
                drop-shadow(0 20px 40px rgba(0, 0, 0, 0.98))
                contrast(1.08)
                brightness(0.97);
            opacity: 1;
            transform: scale(1);
            mask-image: radial-gradient(ellipse 72% 64% at 50% 50%, #000000 52%, rgba(0, 0, 0, 0.92) 70%, transparent 97%);
            -webkit-mask-image: radial-gradient(ellipse 72% 64% at 50% 50%, #000000 52%, rgba(0, 0, 0, 0.92) 70%, transparent 97%);
        }

        /* Floor Mirror Reflection Layer */
        .vehicle-floor-reflect-img {
            position: absolute;
            bottom: -32px;
            max-width: 780px;
            max-height: 180px;
            width: auto;
            height: auto;
            object-fit: contain;
            transform: scaleY(-0.35) scaleX(0.96);
            filter: blur(4px) brightness(0.6) contrast(1.1);
            opacity: 0.28;
            mask-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 70%);
            -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 70%);
            pointer-events: none;
            z-index: 2;
        }

        /* ======================================================== */
        /* 5. CENTER LOADING HUD OVERLAY                            */
        /* ======================================================== */
        .loading-hud-cluster {
            position: relative;
            z-index: 20;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            margin-top: -6px;
        }

        /* Red Racing Logo Icon */
        .center-racing-logo {
            width: 36px;
            height: 24px;
            margin-bottom: 14px;
            filter: drop-shadow(0 0 10px rgba(255, 31, 56, 0.75));
        }

        /* LOADING TELEMETRY... Title */
        .loading-title {
            font-size: 1.28rem;
            font-weight: 800;
            letter-spacing: 3.5px;
            color: var(--rta-text-white);
            text-transform: uppercase;
            margin-bottom: 8px;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
        }

        /* Vehicle Name | Track Name Subtitle */
        .loading-meta-subtitle {
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            color: var(--rta-text-muted);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .meta-pipe {
            color: var(--rta-red);
            font-weight: 700;
            text-shadow: 0 0 8px rgba(255, 31, 56, 0.8);
        }

        /* Vehicle Silhouette Contour Icon Above Bar */
        .progress-vehicle-icon {
            width: 82px;
            height: 26px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            filter: drop-shadow(0 0 8px rgba(255, 31, 56, 0.35));
        }

        /* Red Progress Bar */
        .progress-bar-track {
            position: relative;
            width: 380px;
            max-width: 85vw;
            height: 3px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 2px;
            overflow: visible;
            margin-bottom: 14px;
        }

        .progress-bar-fill {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 100%;
            background: var(--rta-red);
            border-radius: 2px;
            box-shadow: 
                0 0 6px var(--rta-red),
                0 0 16px rgba(255, 31, 56, 0.85);
        }

        /* Glowing leading edge head on progress line */
        .progress-bar-fill::after {
            content: '';
            position: absolute;
            right: -2px;
            top: -2px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 0 8px #ffffff, 0 0 14px var(--rta-red);
        }

        /* Status Text Below Bar */
        .loading-step-status {
            font-size: 0.82rem;
            font-weight: 400;
            letter-spacing: 0.8px;
            color: var(--rta-text-dim);
            min-height: 1.2rem;
        }

        /* ======================================================== */
        /* 6. BOTTOM HUD CORNERS                                   */
        /* ======================================================== */
        .bottom-hud-card {
            position: fixed;
            bottom: 34px;
            left: 42px;
            z-index: 50;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 20px;
            background: rgba(14, 17, 24, 0.78);
            backdrop-filter: blur(12px);
            border: 1px solid var(--rta-border);
            border-radius: 8px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.65);
        }

        .spinner-ring {
            width: 20px;
            height: 20px;
            border: 2.5px solid rgba(255, 31, 56, 0.2);
            border-top-color: var(--rta-red);
            border-right-color: var(--rta-red-bright);
            border-radius: 50%;
            filter: drop-shadow(0 0 6px rgba(255, 31, 56, 0.65));
        }

        .hud-text-stack {
            display: flex;
            flex-direction: column;
            text-align: left;
            gap: 2px;
        }
        .hud-text-primary {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--rta-text-light);
            letter-spacing: 0.4px;
        }
        .hud-text-secondary {
            font-size: 0.72rem;
            color: var(--rta-text-dim);
            letter-spacing: 0.2px;
        }

        /* Bottom-Right Motorsport Quote */
        .bottom-quote-wrap {
            position: fixed;
            bottom: 34px;
            right: 42px;
            z-index: 50;
            text-align: right;
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-style: italic;
        }
        .quote-phrase {
            font-size: 0.84rem;
            color: #7b8396;
            letter-spacing: 0.5px;
        }
        .quote-author {
            font-size: 0.75rem;
            color: #4b5262;
            letter-spacing: 0.8px;
        }

        /* ======================================================== */
        /* 7. RESPONSIVE MEDIA QUERIES (1920x1080 OPTIMIZED)        */
        /* ======================================================== */
        @@media (max-width: 1400px) {
            .vehicle-hero-wrap { height: 350px; max-width: 780px; }
            .vehicle-hero-img { max-width: 720px; max-height: 320px; }
            .vertical-neon-bar { top: 32%; bottom: 36%; }
        }

        @@media (max-height: 820px) {
            .vehicle-hero-wrap { height: 300px; max-width: 680px; }
            .vehicle-hero-img { max-width: 620px; max-height: 270px; }
            .loading-title { font-size: 1.15rem; margin-bottom: 6px; }
            .loading-meta-subtitle { margin-bottom: 14px; font-size: 0.82rem; }
            .center-racing-logo { width: 30px; height: 20px; margin-bottom: 10px; }
            .progress-vehicle-icon { margin-bottom: 6px; }
            .bottom-hud-card { bottom: 22px; left: 32px; }
            .bottom-quote-wrap { bottom: 22px; right: 32px; }
        }
    </style>
</head>
<body>

    <!-- 1. CINEMATIC MOTORSPORT BACKGROUND -->
    <div class="cinematic-bg"></div>
    <div class="cinematic-overlay"></div>

    <!-- 2. SIGNATURE RED VERTICAL NEON BARS -->
    <div class="vertical-neon-bar neon-left"></div>
    <div class="vertical-neon-bar neon-right"></div>

    <!-- 3. TOP TECHNICAL HEADER NAVIGATION -->
    <header class="rta-header">
        <!-- Brand Left -->
        <div class="brand-cluster">
            <div class="brand-logo-r">
                <svg width="28" height="20" viewBox="0 0 32 24" fill="none">
                    <path d="M4 22L12 4H22C26.5 4 29 6.5 29 10C29 13.5 26.5 16 22 16H10L8 22H4Z" stroke="#ff1f38" stroke-width="2.5" stroke-linejoin="round" />
                    <path d="M18 16L24 22" stroke="#ff1f38" stroke-width="2.5" stroke-linecap="round" />
                </svg>
            </div>
            <span class="brand-title">Racing Telemetry Analyzer</span>
        </div>


        <!-- Right Quick Selectors -->
        <div class="selectors-cluster">
            <div class="selector-pill">
                @if (isBike)
                {
                    <svg class="selector-icon" viewBox="0 0 24 24"><path d="M5 20.5A3.5 3.5 0 0 1 1.5 17 3.5 3.5 0 0 1 5 13.5 3.5 3.5 0 0 1 8.5 17 3.5 3.5 0 0 1 5 20.5M5 12a5 5 0 1 0 5 5 5 5 0 0 0-5-5m14 8.5a3.5 3.5 0 0 1-3.5-3.5 3.5 3.5 0 0 1 3.5-3.5 3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m0-8.5a5 5 0 1 0 5 5 5 5 0 0 0-5-5M15 6.5A1.5 1.5 0 1 1 13.5 5 1.5 1.5 0 0 1 15 6.5M7.8 11.2l2.4-3.7 2.8 1.8V12h2V8.5L12.7 7l-1.9-1.2A3 3 0 0 0 6 7l-2 3.1 1.6 1.1z"/></svg>
                }
                else
                {
                    <svg class="selector-icon" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z"/><circle cx="7.5" cy="14.5" r="1.5"/><circle cx="16.5" cy="14.5" r="1.5"/></svg>
                }
                <span>@vehicleName</span>
                <svg class="selector-caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
            </div>
            <div class="selector-pill">
                <svg class="selector-icon" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>@trackName</span>
                <svg class="selector-caret" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"/></svg>
            </div>
        </div>
    </header>

    <!-- 4. MAIN CENTRAL WORKSTATION STAGE -->
    <main class="stage-container">

        <!-- DYNAMIC VEHICLE SHOWCASE -->
        <div class="vehicle-hero-wrap">
            <img id="vehicleHero"
                 src="@imagePath"
                 alt="@vehicleName"
                 class="vehicle-hero-img"
                 onerror="handleVehicleImageError(this, @(isBike ? "true" : "false"))" />
            
            <img id="vehicleHeroReflection"
                 src="@imagePath"
                 alt=""
                 class="vehicle-floor-reflect-img"
                 aria-hidden="true"
                 onerror="handleVehicleImageError(this, @(isBike ? "true" : "false"))" />
            
        </div>

        <!-- CENTER LOADING HUD OVERLAY -->
        <div class="loading-hud-cluster">
            
            <!-- Stylized Red Racing Logo -->
            <div class="center-racing-logo">
                <svg width="36" height="24" viewBox="0 0 32 24" fill="none">
                    <path d="M4 22L12 4H22C26.5 4 29 6.5 29 10C29 13.5 26.5 16 22 16H10L8 22H4Z" stroke="#ff1f38" stroke-width="2.6" stroke-linejoin="round" />
                    <path d="M18 16L24 22" stroke="#ff1f38" stroke-width="2.6" stroke-linecap="round" />
                </svg>
            </div>

            <!-- Title -->
            <h1 class="loading-title">Loading Telemetry...</h1>

            <!-- Vehicle & Track Metadata Subtitle -->
            <div class="loading-meta-subtitle">
                <span>@vehicleName</span>
                <span class="meta-pipe">|</span>
                <span>@trackName</span>
            </div>

            <!-- Wireframe Silhouette Contour Directly Above Progress Bar -->
            <div class="progress-vehicle-icon">
                @if (isBike)
                {
                    <!-- Racing Motorcycle Minimal Vector Contour -->
                    <svg width="74" height="24" viewBox="0 0 100 36" fill="none">
                        <circle cx="18" cy="25" r="9" stroke="#687082" stroke-width="1.8" />
                        <circle cx="82" cy="25" r="9" stroke="#687082" stroke-width="1.8" />
                        <circle cx="18" cy="25" r="4" stroke="#ff1f38" stroke-width="1.4" />
                        <circle cx="82" cy="25" r="4" stroke="#ff1f38" stroke-width="1.4" />
                        <path d="M18 25L32 18L44 8L55 12L68 6L76 14L82 25" stroke="#ff1f38" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M32 18H58L68 18" stroke="#8d95a5" stroke-width="1.4" stroke-linecap="round"/>
                        <path d="M44 8C48 4 56 4 60 7" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                }
                else
                {
                    <!-- GT3 / Racing Sports Car Minimal Vector Contour -->
                    <svg width="86" height="24" viewBox="0 0 120 32" fill="none">
                        <!-- Rear Wing -->
                        <path d="M12 11H26M18 11V18" stroke="#ff1f38" stroke-width="1.8" stroke-linecap="round" />
                        <!-- Car Body Profile Contour -->
                        <path d="M18 19C24 18 28 17 38 12C46 8 62 7 74 11C84 15 95 18 106 19C110 19.5 114 21 114 23C114 24.5 110 25 106 25H16C12 25 10 23.5 10 22C10 20.5 14 19.5 18 19Z" 
                              stroke="#687082" stroke-width="1.6" stroke-linejoin="round" />
                        <!-- Cockpit Glass & Roof -->
                        <path d="M42 12C50 7.5 62 7 72 10.5L80 16H36L42 12Z" stroke="#ff1f38" stroke-width="1.6" stroke-linejoin="round" />
                        <!-- Wheels -->
                        <circle cx="28" cy="24" r="5.5" stroke="#ff1f38" stroke-width="1.8" />
                        <circle cx="92" cy="24" r="5.5" stroke="#ff1f38" stroke-width="1.8" />
                        <!-- Splitter Line -->
                        <path d="M102 25H116" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                }
            </div>

            <!-- Red Progress Bar -->
            <div class="progress-bar-track">
                <div class="progress-bar-fill" id="progressBar"></div>
            </div>

            <!-- Dynamic Subtitle Status -->
            <div class="loading-step-status" id="stepStatus">Telemetry ready</div>

        </div>

    </main>

    <!-- 5. BOTTOM HUD STATUS CARD (LEFT) -->
    <div class="bottom-hud-card">
        <div class="spinner-ring"></div>
        <div class="hud-text-stack">
            <span class="hud-text-primary" id="hudPrimaryText">Session verified</span>
            <span class="hud-text-secondary" id="hudSecondaryText">Opening telemetry workstation</span>
        </div>
    </div>

    <!-- 6. BOTTOM MOTORSPORT QUOTE (RIGHT) -->
    <div class="bottom-quote-wrap">
        <span class="quote-phrase">“Speed is nothing without data.”</span>
        <span class="quote-author">— Ayrton Senna</span>
    </div>

    <!-- ======================================================== -->
    <!-- INITIALIZATION TIMELINE & REDIRECTION SCRIPT            -->
    <!-- ======================================================== -->
    <script>
        const vehicleId = '@vehicleId';
        const trackId = '@trackId';
        const sessionId = '@(sessionId.HasValue ? sessionId.Value.ToString() : "")';

        // Robust image fallback handler
        function handleVehicleImageError(img, isBike) {
            console.warn("Vehicle image failed to load:", img.src);
            if (isBike) {
                if (!img.src.includes('MotoGPStudio.jpg')) {
                    img.src = '/images/bikes/MotoGPStudio.jpg';
                } else if (!img.src.includes('placeholder_bike.png')) {
                    img.src = '/images/placeholder_bike.png';
                }
            } else {
                if (!img.src.includes('CadillacVSeriesR.jpg')) {
                    img.src = '/images/cars/CadillacVSeriesR.jpg';
                } else if (!img.src.includes('AudiR8LMS.jpg')) {
                    img.src = '/images/cars/AudiR8LMS.jpg';
                } else {
                    img.src = '/images/placeholder_car.png';
                }
            }
        }

        // Intentional 2-second cinematic display paired with parallel initialization
        (function() {
            if (window.location.search.includes('preview=1')) {
                return;
            }

            const minimumDisplayTime = 2000; // 2 seconds preferred

            let targetUrl = '/Telemetry?vehicleId=' + vehicleId + '&trackId=' + trackId;
            if (sessionId && sessionId.length > 0 && sessionId !== '0') {
                targetUrl += '&sessionId=' + sessionId;
            }

            // 1. Minimum display duration timer (approx 2s)
            const displayTimer = new Promise(resolve => {
                setTimeout(resolve, minimumDisplayTime);
            });

            // 2. Perform genuinely required initialization in parallel (warm up target Telemetry endpoint)
            const requiredInit = fetch(targetUrl, { method: 'GET', credentials: 'same-origin' })
                .catch(err => {
                    console.debug('Telemetry initialization ready:', err);
                });

            // 3. Navigate only when BOTH are true:
            //    A) required initialization is complete
            //    B) minimum display time (about 2 seconds) has elapsed
            Promise.all([requiredInit, displayTimer]).then(() => {
                window.location.replace(targetUrl);
            });
        })();
    </script>
</body>
</html>

        flex-direction: column;
        gap: 2px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.88);
        font-size: 0.78rem;
        z-index: 25;
        border-top: 2px solid #00d2ff;
        transition: opacity 0.1s;
    }
    .custom-tooltip.opacity-0 { opacity: 0; }
    .custom-tooltip .tt-header { border-bottom: 1px solid #252532; padding-bottom: 3px; margin-bottom: 3px; display: flex; justify-content: space-between; }
    .custom-tooltip .tt-row { display: flex; align-items: center; justify-content: space-between; padding: 1px 0; }
    .custom-tooltip .tt-val { font-size: 0.78rem; font-weight: bold; font-family: monospace; }

    /* Colors */
    .text-purple { color: #a200ff !important; }
    .text-cyan { color: #00d2ff !important; }
    .text-orange { color: #ff5a1f !important; }
    .text-green { color: #00ff41 !important; }
    .text-red { color: #ff0000 !important; }
    .text-magenta { color: #ff00ff !important; }
</style>

@section Scripts {
    @{
        var allRawPoints = (telemetry ?? new List<TelemetryPoint>()).ToList();
    }
    <script>
        const isBike = @isBike.ToString().ToLower();

        // 1. RAW TELEMETRY DATASET (CACHED UPFRONT IN MEMORY)
        const rawTelemetry = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allRawPoints.Select(t => {
            var lap = allLaps.FirstOrDefault(l => l.LapId == t.LapId);
            return new {
                lap = lap?.LapNumber ?? 1,
                lapId = t.LapId,
                lapDist = t.Distance,
                speed = t.Speed,
                rpm = t.RPM,
                thr = t.Throttle,
                brk = t.Brake,
                steer = t.Steering ?? (t.LeanAngle ?? 0.0),
                t = t.Timestamp.TotalSeconds
            };
        })));

        // 1.1 ORDERED LIST OF LAPS FROM IMPORTED TELEMETRY DATA (CHRONOLOGICAL LAP 1 -> FINAL)
        const availableLaps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allLaps.OrderBy(l => l.LapNumber).Select(l => new {
            lap = l.LapNumber,
            lapId = l.LapId,
            lapTime = l.LapTime.ToString(@"mm\:ss\.fff")
        })));
        const availableLapNumbers = availableLaps.map(l => l.lap);

        // 2. COMPUTE CONTINUOUS CUMULATIVE DISTANCE ACROSS LAPS
        let cumDist = 0;
        let prevLapId = null;
        let lapStartCumDist = 0;
        let maxLapDistSeen = 0;
        const lapBoundaries = [];

        for (let i = 0; i < rawTelemetry.length; i++) {
            const pt = rawTelemetry[i];
            if (prevLapId !== null && pt.lapId !== prevLapId) {
                cumDist += maxLapDistSeen > 0 ? maxLapDistSeen : 4309;
                lapBoundaries.push({ lapNumber: pt.lap, dist: cumDist });
                lapStartCumDist = cumDist;
                maxLapDistSeen = 0;
            }
            prevLapId = pt.lapId;
            if (pt.lapDist > maxLapDistSeen) maxLapDistSeen = pt.lapDist;
            pt.cumDist = lapStartCumDist + pt.lapDist;
        }

        // 3. TELEMETRY DATA & VIEWPORT ENGINE
        const canvas = document.getElementById('telemetryCanvas');
        const ctx = canvas ? canvas.getContext('2d') : null;
        const slider = document.getElementById('replaySlider');
        const distEl = document.getElementById('replayDistance');
        const speedEl = document.getElementById('replaySpeed');
        const btnPlay = document.getElementById('btnPlay');
        const btnPause = document.getElementById('btnPause');
        const btnReset = document.getElementById('btnReset');
        const lapEl = document.getElementById('replayLap');
        const timeDisplayEl = document.getElementById('replayTimeDisplay');
        const scrubberHud = document.getElementById('liveScrubberHud');
        const hudSpeedReadout = document.getElementById('hudSpeedReadout');

        // G-FORCE ELEMENTS
        const latGEl = document.getElementById('gforce-lat');
        const longGEl = document.getElementById('gforce-long');
        const vertGEl = document.getElementById('gforce-vert');
        const gforceDot = document.getElementById('gforce-dot');

        let currentSelectedLap = (availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1);
        let activeLapPoints = [];
        let lapTotalDistance = 2802;

        const telemetryData = rawTelemetry;
        let currentTelemetryIndex = 0;
        let playbackFractionalIndex = 0;

        let isRollingActive = false; // Rolling window ONLY engages during active playback
        let isRollingModeSetting = true;
        let windowDistance = 1000.0; // 1.0 km rolling window
        const SCRUBBER_X_RATIO = 0.80; // Scrubber pinned at 80% during rolling playback

        let isPlaying = false;
        let playbackRate = 1;
        let animFrameId = null;
        let lastFrameTime = 0;

        // Current visible window distance bounds (used by hover engine)
        let currentWindowStartDist = 0;
        let currentWindowEndDist = 2802;

        // Interactive Oscilloscope Hover Engine State
        let isHovering = false;
        let hoverCanvasX = null;
        let hoverPoint = null;

        // Channel visibility state
        const channelVisibility = {
            speed: true,
            rpm: true,
            throttle: true,
            brake: true,
            steering: true
        };

        function initLapData(lapNum, lapId) {
            currentSelectedLap = lapNum || (availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1);
            // Filter complete dataset for the selected lap
            activeLapPoints = telemetryData.filter(p => p.lap === currentSelectedLap || (lapId && p.lapId === lapId));
            if (activeLapPoints.length === 0) {
                activeLapPoints = telemetryData;
            }

            // Compute exact lap distance span
            const maxD = (activeLapPoints.length > 0) ? activeLapPoints[activeLapPoints.length - 1].lapDist : 0;
            lapTotalDistance = maxD > 0 ? maxD : 2802;

            const startIdx = telemetryData.findIndex(p => p.lap === currentSelectedLap || (lapId && p.lapId === lapId));
            currentTelemetryIndex = startIdx !== -1 ? startIdx : 0;
            playbackFractionalIndex = currentTelemetryIndex;
            isRollingActive = false; // Full lap fit on load/selection

            if (slider) {
                slider.min = 0;
                slider.max = Math.max(1, telemetryData.length - 1);
                slider.value = currentTelemetryIndex;
            }

            const lapMeta = availableLaps.find(l => l.lap === currentSelectedLap);
            if (timeDisplayEl && lapMeta) {
                timeDisplayEl.textContent = '00:00.000 / ' + lapMeta.lapTime;
            }
            if (lapEl) {
                lapEl.textContent = currentSelectedLap;
            }
        }

        // Initialize active lap strictly with Lap 1 (start of session)
        const initialLapNum = availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1;
        const initialLapId = availableLaps.length > 0 ? availableLaps[0].lapId : 0;
        initLapData(initialLapNum, initialLapId);

        function resizeCanvas() {
            if (!canvas) return;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            if (ctx) ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
            renderCanvas();
        }

        window.addEventListener('resize', resizeCanvas);

        function binarySearchLower(dataset, targetDist) {
            let low = 0, high = dataset.length - 1, ans = 0;
            while (low <= high) {
                const mid = (low + high) >> 1;
                if (dataset[mid].lapDist >= targetDist) {
                    ans = mid;
                    high = mid - 1;
                } else {
                    low = mid + 1;
                }
            }
            return ans;
        }

        function binarySearchUpper(dataset, targetDist) {
            let low = 0, high = dataset.length - 1, ans = dataset.length - 1;
            while (low <= high) {
                const mid = (low + high) >> 1;
                if (dataset[mid].lapDist <= targetDist) {
                    ans = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }
            return ans;
        }

        function updateGForce(pt) {
            if (!pt) return;
            const steerVal = Number(pt.steer || 0);
            const speedMs = Number(pt.speed || 0) / 3.6;
            const throttleVal = Number(pt.thr || 0);
            const brakeVal = Number(pt.brk || 0);

            let latG = (speedMs > 4 && Math.abs(steerVal) > 0.3)
                ? (speedMs * speedMs * Math.sin(Math.abs(steerVal) * Math.PI / 180.0)) / (9.81 * 75.0)
                : 0;
            latG = Math.min(4.5, Math.max(0, latG));
            if (steerVal < 0) latG = -latG;

            let longG = (throttleVal / 100.0 * 1.35) - (brakeVal / 100.0 * 2.85);
            let vertG = 0.20 + (speedMs / 100.0 * 0.12);

            if (latGEl) latGEl.textContent = (latG >= 0 ? '+' : '') + latG.toFixed(2) + ' G';
            if (longGEl) longGEl.textContent = (longG >= 0 ? '+' : '') + longG.toFixed(2) + ' G';
            if (vertGEl) vertGEl.textContent = vertG.toFixed(2) + ' G';

            if (gforceDot) {
                let topPct = 50 - (longG * 18);
                let leftPct = 50 + (latG * 18);
                gforceDot.style.top = Math.max(10, Math.min(90, topPct)) + '%';
                gforceDot.style.left = Math.max(10, Math.min(90, leftPct)) + '%';
            }
        }

        function formatSeconds(sec) {
            const mins = Math.floor(sec / 60);
            const remainderSec = (sec % 60).toFixed(3);
            return (mins < 10 ? '0' : '') + mins + ':' + (remainderSec < 10 ? '0' : '') + remainderSec;
        }

        // MAIN CANVAS RENDER FUNCTION (60 FPS HARDWARE ACCELERATED)
        function renderCanvas() {
            if (!canvas || !ctx || activeLapPoints.length === 0) return;

            const width = canvas.width / window.devicePixelRatio;
            const height = canvas.height / window.devicePixelRatio;

            ctx.fillStyle = '#08080d';
            ctx.fillRect(0, 0, width, height);

            const pt = telemetryData[currentTelemetryIndex] || activeLapPoints[0] || { speed: 0, rpm: 0, thr: 0, brk: 0, steer: 0, lapDist: 0, t: 0 };
            const currentDist = pt.lapDist;

            let windowStartDist, windowEndDist;

            if (isRollingActive && isRollingModeSetting) {
                // Rolling Window Viewport during Playback: Scrubber pinned at 80%
                windowStartDist = currentDist - (windowDistance * SCRUBBER_X_RATIO);
                windowEndDist = windowStartDist + windowDistance;
            } else {
                // Initial Load / Lap Selection: FIT COMPLETE LAP DATA (0m to lapTotalDistance)
                windowStartDist = 0;
                windowEndDist = lapTotalDistance;
            }

            // Record bounds for hover engine
            currentWindowStartDist = windowStartDist;
            currentWindowEndDist = windowEndDist;

            // Draw Background Grid & Dynamic X-Axis
            drawGrid(width, height, windowStartDist, windowEndDist, pt);

            // Viewport Culling: Retrieve only visible slice for this lap
            const startIdx = binarySearchLower(activeLapPoints, windowStartDist);
            const endIdx = binarySearchUpper(activeLapPoints, windowEndDist);

            if (startIdx <= endIdx && startIdx < activeLapPoints.length) {
                const slice = activeLapPoints.slice(startIdx, endIdx + 1);
                const getX = (dist) => ((dist - windowStartDist) / (windowEndDist - windowStartDist)) * width;

                // Channel 1: Speed (Green: #00ff41, 0-400 km/h) -> Top 45% of height
                if (channelVisibility.speed) {
                    drawCurve(slice, getX, (p) => (height * 0.44) * (1.0 - (p.speed / 400.0)) + 4, '#00ff41', 2.0);
                }

                // Channel 2: RPM (Purple: #a200ff, 0-15000 RPM) -> Top 45% height overlay
                if (channelVisibility.rpm) {
                    drawCurve(slice, getX, (p) => (height * 0.44) * (1.0 - (p.rpm / 15000.0)) + 4, '#a200ff', 1.5);
                }

                // Channel 3: Throttle (Cyan: #00d2ff, 0-100%) -> Bottom 48% of height
                if (channelVisibility.throttle) {
                    drawCurve(slice, getX, (p) => (height * 0.52) + (height * 0.42) * (1.0 - (p.thr / 100.0)), '#00d2ff', 1.5);
                }

                // Channel 4: Brake (Red: #ff0000, 0-100%) -> Bottom 48% height
                if (channelVisibility.brake) {
                    drawCurve(slice, getX, (p) => (height * 0.52) + (height * 0.42) * (1.0 - (p.brk / 100.0)), '#ff0000', 1.8);
                }

                // Channel 5: Steering (Magenta: #ff00ff, ±50°)
                if (channelVisibility.steering) {
                    drawCurve(slice, getX, (p) => (height * 0.52) + (height * 0.42) * (0.5 - (p.steer / 100.0)), '#ff00ff', 1.5);
                }
            }

            // Draw Scrubber Indicator & HUD (only when playing, scrolling, or scrubbed)
            const showScrubber = isPlaying || isRollingActive || currentTelemetryIndex > 0;
            let scrubberX = (isRollingActive && isRollingModeSetting)
                ? (SCRUBBER_X_RATIO * width)
                : (((currentDist - windowStartDist) / (windowEndDist - windowStartDist)) * width);

            if (showScrubber) {
                ctx.strokeStyle = '#ff5a1f';
                ctx.lineWidth = 2.0;
                ctx.shadowColor = '#ff5a1f';
                ctx.shadowBlur = 8;
                ctx.beginPath();
                ctx.moveTo(scrubberX, 0);
                ctx.lineTo(scrubberX, height);
                ctx.stroke();
                ctx.shadowBlur = 0;

                if (scrubberHud) {
                    scrubberHud.style.display = 'block';
                    scrubberHud.style.left = scrubberX + 'px';
                    if (hudSpeedReadout) hudSpeedReadout.textContent = Math.round(pt.speed) + ' km/h';
                }
            } else {
                if (scrubberHud) {
                    scrubberHud.style.display = 'none';
                }
            }

            // Draw Interactive Oscilloscope Hover Guide Line & Curve Target Dots
            if (isHovering && hoverCanvasX !== null && hoverPoint) {
                const hX = hoverCanvasX;
                ctx.save();

                // 1. Vertical Guide Line (Electric Cyan)
                ctx.strokeStyle = 'rgba(0, 229, 255, 0.85)';
                ctx.lineWidth = 1.5;
                ctx.setLineDash([4, 3]);
                ctx.beginPath();
                ctx.moveTo(hX, 0);
                ctx.lineTo(hX, height);
                ctx.stroke();
                ctx.setLineDash([]);

                // 2. Glowing Intersection Target Dots on Active Curves
                if (channelVisibility.speed) {
                    const ySpeed = (height * 0.44) * (1.0 - (hoverPoint.speed / 400.0)) + 4;
                    drawHoverTargetDot(hX, ySpeed, '#00ff41');
                }
                if (channelVisibility.rpm) {
                    const yRpm = (height * 0.44) * (1.0 - (hoverPoint.rpm / 15000.0)) + 4;
                    drawHoverTargetDot(hX, yRpm, '#a200ff');
                }
                if (channelVisibility.throttle) {
                    const yThr = (height * 0.52) + (height * 0.42) * (1.0 - (hoverPoint.thr / 100.0));
                    drawHoverTargetDot(hX, yThr, '#00d2ff');
                }
                if (channelVisibility.brake) {
                    const yBrk = (height * 0.52) + (height * 0.42) * (1.0 - (hoverPoint.brk / 100.0));
                    drawHoverTargetDot(hX, yBrk, '#ff0000');
                }
                if (channelVisibility.steering) {
                    const yStr = (height * 0.52) + (height * 0.42) * (0.5 - (hoverPoint.steer / 100.0));
                    drawHoverTargetDot(hX, yStr, '#ff00ff');
                }

                // 3. Top Crosshair Distance Badge
                const distStr = hoverPoint.lapDist >= 1000 
                    ? (hoverPoint.lapDist / 1000.0).toFixed(2) + ' km' 
                    : Math.round(hoverPoint.lapDist) + ' m';
                const badgeWidth = 66;
                const badgeX = Math.max(2, Math.min(width - badgeWidth - 2, hX - badgeWidth / 2));
                ctx.fillStyle = '#00e5ff';
                ctx.fillRect(badgeX, 2, badgeWidth, 16);
                ctx.fillStyle = '#0a0c12';
                ctx.font = 'bold 10px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(distStr, badgeX + badgeWidth / 2, 14);

                ctx.restore();
            }

            // Sync Top Channel Toolbar Spans (reflects hovered point if user is hovering)
            const readoutPt = (isHovering && hoverPoint) ? hoverPoint : pt;
            const tbSpeed = document.getElementById('tbSpeedVal');
            const tbRpm = document.getElementById('tbRpmVal');
            const tbThr = document.getElementById('tbThrVal');
            const tbBrk = document.getElementById('tbBrkVal');
            const tbStr = document.getElementById('tbStrVal');

            if (tbSpeed) tbSpeed.textContent = Math.round(readoutPt.speed) + ' km/h';
            if (tbRpm) tbRpm.textContent = Math.round(readoutPt.rpm).toLocaleString();
            if (tbThr) tbThr.textContent = Math.round(readoutPt.thr) + '%';
            if (tbBrk) tbBrk.textContent = Math.round(readoutPt.brk) + '%';
            if (tbStr) tbStr.textContent = (readoutPt.steer >= 0 ? '+' : '') + Number(readoutPt.steer).toFixed(1) + '°';

            // Sync HUD & Sidebar
            if (slider) slider.value = currentTelemetryIndex;
            if (lapEl) lapEl.textContent = currentSelectedLap;
            if (distEl) distEl.textContent = Math.round(pt.lapDist).toLocaleString() + ' m / ' + Math.round(lapTotalDistance).toLocaleString() + ' m';
            if (speedEl) speedEl.textContent = Math.round(pt.speed) + ' KM/H';
            if (timeDisplayEl && pt.t != null) {
                const lapMeta = availableLaps.find(l => l.lap === currentSelectedLap);
                const lapDuration = lapMeta ? lapMeta.lapTime : '@ViewBag.CurrentLapTime';
                timeDisplayEl.textContent = formatSeconds(pt.t) + ' / ' + lapDuration;
            }

            updateGForce(pt);
        }

        function drawCurve(slice, getX, getY, color, lineWidth) {
            if (slice.length < 2) return;
            ctx.strokeStyle = color;
            ctx.lineWidth = lineWidth;
            ctx.beginPath();
            for (let i = 0; i < slice.length; i++) {
                const x = getX(slice[i].lapDist);
                const y = getY(slice[i]);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }

        function drawGrid(width, height, startDist, endDist, pt) {
            ctx.strokeStyle = '#14141e';
            ctx.lineWidth = 1;

            // Horizontal Grid Lines
            const hLines = [0.15, 0.30, 0.44, 0.52, 0.73, 0.94];
            hLines.forEach(ratio => {
                const y = height * ratio;
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(width, y);
                ctx.stroke();
            });

            // Mid Category Separator Line
            ctx.strokeStyle = '#222234';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(0, height * 0.48);
            ctx.lineTo(width, height * 0.48);
            ctx.stroke();

            // Dynamic X-Axis Distance & Lap Ticks (Complete Lap Scaled to Viewport)
            const span = endDist - startDist;
            const step = span <= 1200 ? 200 : (span <= 3500 ? 500 : 1000);
            const firstTick = Math.ceil(startDist / step) * step;

            ctx.font = 'bold 12px "Segoe UI", Roboto, monospace';
            ctx.textAlign = 'center';

            for (let d = firstTick; d <= endDist; d += step) {
                const x = ((d - startDist) / span) * width;
                ctx.strokeStyle = '#181826';
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, height);
                ctx.stroke();

                // Display Clean Distance in Kilometers / Meters
                const distLabel = d >= 1000 ? (d / 1000.0).toFixed(1) + ' km' : d + ' m';
                ctx.fillStyle = '#e5e7eb';
                ctx.fillText(`LAP ${currentSelectedLap} • ${distLabel}`, x, height - 7);
            }

            // Lap End Boundary Marker
            if (lapTotalDistance >= startDist && lapTotalDistance <= endDist) {
                const endX = ((lapTotalDistance - startDist) / span) * width;
                ctx.save();
                ctx.setLineDash([4, 4]);
                ctx.strokeStyle = '#00ff41';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(endX, 0);
                ctx.lineTo(endX, height);
                ctx.stroke();
                ctx.restore();

                // Finish Line Flag
                ctx.fillStyle = '#00ff41';
                ctx.fillRect(Math.max(40, endX - 50), height - 24, 95, 18);
                ctx.fillStyle = '#000000';
                ctx.font = 'bold 11px monospace';
                ctx.textAlign = 'center';
                ctx.fillText(`LAP ${currentSelectedLap} FINISH`, Math.max(40, endX - 50) + 47, height - 11);
            }
        }

        // PLAYBACK ANIMATION LOOP
        // PLAYBACK ANIMATION LOOP — CONTINUOUS CHRONOLOGICAL REPLAY
        function animLoop(now) {
            if (!isPlaying) return;
            if (!now) now = performance.now();
            const dt = Math.min(0.1, (now - lastFrameTime) / 1000.0);
            lastFrameTime = now;

            // Natural 1x playback pace: ~20 telemetry samples per second * playbackRate
            const deltaPoints = dt * playbackRate * 20.0;
            playbackFractionalIndex += deltaPoints;
            currentTelemetryIndex = Math.floor(playbackFractionalIndex);

            // STOP ONLY when session reaches the final telemetry point of the final lap
            if (currentTelemetryIndex >= telemetryData.length - 1) {
                currentTelemetryIndex = telemetryData.length - 1;
                playbackFractionalIndex = currentTelemetryIndex;
                pausePlayback();
                renderCanvas();
                return;
            }

            // Continuous playback: Check for lap transition (Lap 1 -> Lap 2 -> ... -> Lap N)
            const pt = telemetryData[currentTelemetryIndex];
            if (pt && pt.lap !== currentSelectedLap) {
                currentSelectedLap = pt.lap;
                activeLapPoints = telemetryData.filter(p => p.lap === currentSelectedLap);
                const maxD = (activeLapPoints.length > 0) ? activeLapPoints[activeLapPoints.length - 1].lapDist : 0;
                lapTotalDistance = maxD > 0 ? maxD : 2802;

                if (lapEl) lapEl.textContent = currentSelectedLap;

                // Sync active styling on sidebar items and table rows without pause or reset
                document.querySelectorAll('.lap-item').forEach(item => {
                    item.classList.toggle('active', item.getAttribute('data-lap') == currentSelectedLap);
                });
                document.querySelectorAll('.lap-table-row').forEach(row => {
                    row.classList.toggle('table-active', row.getAttribute('data-lap-num') == currentSelectedLap);
                    row.classList.toggle('text-warning', row.getAttribute('data-lap-num') == currentSelectedLap);
                });
            }

            renderCanvas();
            animFrameId = requestAnimationFrame(animLoop);
        }

        window.startPlayback = function() {
            isPlaying = true;
            isRollingActive = true; // Engage rolling window during playback
            if (btnPlay) btnPlay.classList.add('active');
            if (btnPause) btnPause.classList.remove('active');
            if (btnReset) btnReset.classList.remove('active');

            // If user was at the final telemetry point of the final lap, loop back to Lap 1
            if (currentTelemetryIndex >= telemetryData.length - 1) {
                const firstLapNum = availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1;
                jumpToLap(firstLapNum, null, null, false);
                currentTelemetryIndex = 0;
                playbackFractionalIndex = 0;
            } else {
                playbackFractionalIndex = currentTelemetryIndex;
            }

            lastFrameTime = performance.now();
            if (!animFrameId) animLoop(lastFrameTime);
        };

        window.pausePlayback = function() {
            isPlaying = false;
            if (animFrameId) {
                cancelAnimationFrame(animFrameId);
                animFrameId = null;
            }
            if (btnPlay) btnPlay.classList.remove('active');
            if (btnPause) btnPause.classList.add('active');
            renderCanvas();
        };

        window.resetPlayback = function() {
            pausePlayback();
            // Requirement 12: Reset returns to the beginning of Lap 1
            const firstLapNum = availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1;
            const firstLapMeta = availableLaps.find(l => l.lap === firstLapNum);
            jumpToLap(firstLapNum, firstLapMeta ? firstLapMeta.lapId : null, null, true);
            currentTelemetryIndex = 0;
            playbackFractionalIndex = 0;
            isRollingActive = false; // Full lap fit view
            if (slider) slider.value = 0;
            if (btnReset) btnReset.classList.add('active');
            if (btnPause) btnPause.classList.remove('active');
            renderCanvas();
            setTimeout(() => { if (btnReset) btnReset.classList.remove('active'); }, 300);
        };

        window.seekToSlider = function(val) {
            pausePlayback();
            currentTelemetryIndex = Math.max(0, Math.min(telemetryData.length - 1, parseInt(val)));
            playbackFractionalIndex = currentTelemetryIndex;
            const pt = telemetryData[currentTelemetryIndex];
            if (pt && pt.lap !== currentSelectedLap) {
                currentSelectedLap = pt.lap;
                activeLapPoints = telemetryData.filter(p => p.lap === currentSelectedLap);
                const maxD = (activeLapPoints.length > 0) ? activeLapPoints[activeLapPoints.length - 1].lapDist : 0;
                lapTotalDistance = maxD > 0 ? maxD : 2802;
                if (lapEl) lapEl.textContent = currentSelectedLap;
                document.querySelectorAll('.lap-item').forEach(item => {
                    item.classList.toggle('active', item.getAttribute('data-lap') == currentSelectedLap);
                });
                document.querySelectorAll('.lap-table-row').forEach(row => {
                    row.classList.toggle('table-active', row.getAttribute('data-lap-num') == currentSelectedLap);
                    row.classList.toggle('text-warning', row.getAttribute('data-lap-num') == currentSelectedLap);
                });
            }
            isRollingActive = false;
            renderCanvas();
        };

        window.setSpeedMultiplier = function(mult, btn) {
            playbackRate = mult;
            document.querySelectorAll('.btn-speed-mult').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
        };

        window.toggleRollingChannel = function(channel, btn) {
            if (channelVisibility[channel] !== undefined) {
                channelVisibility[channel] = !channelVisibility[channel];
                btn.classList.toggle('active', channelVisibility[channel]);
                btn.classList.toggle('disabled-ch', !channelVisibility[channel]);
                renderCanvas();
            }
        };

        window.toggleViewMode = function() {
            isRollingModeSetting = !isRollingModeSetting;
            const modeBtn = document.getElementById('btnViewMode');
            const modeText = document.getElementById('modeText');
            if (modeText) modeText.textContent = isRollingModeSetting ? 'ROLLING VIEWPORT' : 'FULL LAP';
            if (modeBtn) modeBtn.classList.toggle('active', isRollingModeSetting);
            renderCanvas();
        };

        window.changeWindowSize = function(val) {
            windowDistance = parseFloat(val);
            renderCanvas();
        };

        // ON LAP SELECTION: LOAD COMPLETE DATASET & FIT ENTIRE LAP TO VIEWPORT
        window.jumpToLap = function(lapNumber, lapId, el, shouldPause = true) {
            if (shouldPause) {
                pausePlayback();
            }
            const targetLap = lapNumber || (availableLapNumbers.length > 0 ? availableLapNumbers[0] : 1);
            currentSelectedLap = targetLap;
            activeLapPoints = telemetryData.filter(p => p.lap === currentSelectedLap || (lapId && p.lapId === lapId));
            if (activeLapPoints.length === 0) activeLapPoints = telemetryData;

            const maxD = (activeLapPoints.length > 0) ? activeLapPoints[activeLapPoints.length - 1].lapDist : 0;
            lapTotalDistance = maxD > 0 ? maxD : 2802;

            const startIdx = telemetryData.findIndex(p => p.lap === currentSelectedLap || (lapId && p.lapId === lapId));
            currentTelemetryIndex = startIdx !== -1 ? startIdx : 0;
            playbackFractionalIndex = currentTelemetryIndex;
            if (shouldPause) isRollingActive = false;

            if (slider) slider.value = currentTelemetryIndex;
            if (lapEl) lapEl.textContent = currentSelectedLap;

            const lapMeta = availableLaps.find(l => l.lap === currentSelectedLap);
            if (timeDisplayEl && lapMeta) {
                timeDisplayEl.textContent = '00:00.000 / ' + lapMeta.lapTime;
            }

            // Highlight active items
            document.querySelectorAll('.lap-item').forEach(item => {
                item.classList.toggle('active', item.getAttribute('data-lap') == currentSelectedLap);
            });
            document.querySelectorAll('.lap-table-row').forEach(row => {
                row.classList.toggle('table-active', row.getAttribute('data-lap-num') == currentSelectedLap);
                row.classList.toggle('text-warning', row.getAttribute('data-lap-num') == currentSelectedLap);
            });

            const targetItem = el || document.querySelector(`.lap-item[data-lap="${lapNumber}"]`) || document.querySelector(`.lap-item-num-${lapNumber}`);
            if (targetItem) {
                if (targetItem.classList.contains('lap-item')) {
                    targetItem.classList.add('active');
                } else if (targetItem.classList.contains('lap-table-row')) {
                    targetItem.classList.add('table-active', 'text-warning');
                }
            }

            // Scroll view smoothly up to centerpiece graph only on manual click
            if (shouldPause) {
                const graphWrapper = document.getElementById('telemetry-wrapper');
                if (graphWrapper && window.scrollY > 320) {
                    graphWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
            renderCanvas();
        };

        function drawHoverTargetDot(x, y, color) {
            ctx.save();
            ctx.shadowColor = color;
            ctx.shadowBlur = 10;
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, y, 4.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.stroke();
            ctx.restore();
        }

        // Exact Telemetry Point Interpolation for High Precision Oscilloscope Cursor
        function getInterpolatedPointAtDist(dist) {
            if (!activeLapPoints || activeLapPoints.length === 0) return null;
            if (dist <= activeLapPoints[0].lapDist) return activeLapPoints[0];
            if (dist >= activeLapPoints[activeLapPoints.length - 1].lapDist) return activeLapPoints[activeLapPoints.length - 1];

            let low = 0, high = activeLapPoints.length - 1;
            while (low <= high) {
                const mid = (low + high) >> 1;
                if (activeLapPoints[mid].lapDist < dist) {
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }
            const idx2 = Math.min(activeLapPoints.length - 1, Math.max(0, low));
            const idx1 = Math.max(0, idx2 - 1);
            const p1 = activeLapPoints[idx1];
            const p2 = activeLapPoints[idx2];
            if (p1 === p2 || p2.lapDist === p1.lapDist) return p1;

            const frac = Math.max(0, Math.min(1, (dist - p1.lapDist) / (p2.lapDist - p1.lapDist)));
            const lerp = (a, b) => a + (b - a) * frac;

            return {
                lap: p1.lap,
                lapDist: dist,
                t: lerp(p1.t ?? 0, p2.t ?? 0),
                speed: lerp(p1.speed, p2.speed),
                rpm: lerp(p1.rpm, p2.rpm),
                thr: lerp(p1.thr, p2.thr),
                brk: lerp(p1.brk, p2.brk),
                steer: lerp(p1.steer, p2.steer),
                gear: frac < 0.5 ? p1.gear : p2.gear
            };
        }

        // INTERACTIVE TELEMETRY HOVER ENGINE
        function initHoverEngine() {
            if (!canvas) return;

            const tooltip = document.getElementById('cursor-tooltip');
            const thLap = document.getElementById('thLap');
            const thDist = document.getElementById('thDist');
            const thTime = document.getElementById('thTime');
            const thSpeed = document.getElementById('thSpeed');
            const thRpm = document.getElementById('thRpm');
            const thThr = document.getElementById('thThr');
            const thThrBar = document.getElementById('thThrBar');
            const thBrk = document.getElementById('thBrk');
            const thBrkBar = document.getElementById('thBrkBar');
            const thSteer = document.getElementById('thSteer');

            const thRowSpeed = document.getElementById('thRowSpeed');
            const thRowRpm = document.getElementById('thRowRpm');
            const thRowThr = document.getElementById('thRowThr');
            const thRowBrk = document.getElementById('thRowBrk');
            const thRowSteer = document.getElementById('thRowSteer');

            function onMouseMove(e) {
                if (!canvas || activeLapPoints.length === 0) return;
                const rect = canvas.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;

                if (mouseX < 0 || mouseX > rect.width || mouseY < 0 || mouseY > rect.height) {
                    onMouseLeave();
                    return;
                }

                isHovering = true;
                hoverCanvasX = mouseX;

                const span = currentWindowEndDist - currentWindowStartDist;
                if (span <= 0) return;
                const ratio = Math.max(0, Math.min(1, mouseX / rect.width));
                const hoveredDist = currentWindowStartDist + ratio * span;

                hoverPoint = getInterpolatedPointAtDist(hoveredDist);
                if (!hoverPoint) return;

                // 1. Update Tooltip Header
                if (thLap) thLap.textContent = hoverPoint.lap;
                if (thDist) thDist.textContent = hoverPoint.lapDist >= 1000 
                    ? (hoverPoint.lapDist / 1000.0).toFixed(3) + ' km' 
                    : Math.round(hoverPoint.lapDist) + ' m';
                if (thTime) thTime.textContent = formatSeconds(hoverPoint.t);

                // 2. Update Channel Values
                if (thSpeed) thSpeed.textContent = Math.round(hoverPoint.speed) + ' km/h';
                if (thRpm) thRpm.textContent = Math.round(hoverPoint.rpm).toLocaleString();
                if (thThr) thThr.textContent = Math.round(hoverPoint.thr) + '%';
                if (thThrBar) thThrBar.style.width = Math.min(100, Math.max(0, hoverPoint.thr)) + '%';
                if (thBrk) thBrk.textContent = Math.round(hoverPoint.brk) + '%';
                if (thBrkBar) thBrkBar.style.width = Math.min(100, Math.max(0, hoverPoint.brk)) + '%';
                if (thSteer) thSteer.textContent = (hoverPoint.steer >= 0 ? '+' : '') + Number(hoverPoint.steer).toFixed(1) + '°';

                // 3. Update Disabled/Visible Styling matching channel buttons
                if (thRowSpeed) thRowSpeed.classList.toggle('disabled-ch', !channelVisibility.speed);
                if (thRowRpm) thRowRpm.classList.toggle('disabled-ch', !channelVisibility.rpm);
                if (thRowThr) thRowThr.classList.toggle('disabled-ch', !channelVisibility.throttle);
                if (thRowBrk) thRowBrk.classList.toggle('disabled-ch', !channelVisibility.brake);
                if (thRowSteer) thRowSteer.classList.toggle('disabled-ch', !channelVisibility.steering);

                // 4. Position Floating Tooltip HUD
                if (tooltip) {
                    tooltip.classList.remove('d-none');
                    const tooltipWidth = tooltip.offsetWidth || 320;
                    const tooltipHeight = tooltip.offsetHeight || 230;
                    let tipX = mouseX + 20;
                    let tipY = mouseY - 30;

                    // Auto-flip horizontally if overflowing right side
                    if (tipX + tooltipWidth > rect.width - 8) {
                        tipX = mouseX - tooltipWidth - 18;
                    }
                    if (tipX < 8) tipX = 8;

                    // Clamp vertically within wrapper
                    if (tipY < 8) tipY = 8;
                    if (tipY + tooltipHeight > rect.height - 8) {
                        tipY = rect.height - tooltipHeight - 8;
                    }

                    tooltip.style.transform = `translate(${tipX}px, ${tipY}px)`;
                }

                // Render crosshair and dots immediately if not playing
                if (!isPlaying) {
                    renderCanvas();
                }
            }

            function onMouseLeave() {
                isHovering = false;
                hoverCanvasX = null;
                hoverPoint = null;
                if (tooltip) tooltip.classList.add('d-none');
                if (!isPlaying) {
                    renderCanvas();
                }
            }

            canvas.addEventListener('mousemove', onMouseMove);
            canvas.addEventListener('mouseleave', onMouseLeave);

            // Click on graph to jump replay to that exact position
            canvas.addEventListener('click', function(e) {
                if (!hoverPoint || telemetryData.length === 0) return;
                const targetLap = hoverPoint.lap;
                const targetDist = hoverPoint.lapDist;
                let closestIdx = 0;
                let minDiff = Infinity;
                for (let i = 0; i < telemetryData.length; i++) {
                    if (telemetryData[i].lap === targetLap) {
                        const diff = Math.abs(telemetryData[i].lapDist - targetDist);
                        if (diff < minDiff) {
                            minDiff = diff;
                            closestIdx = i;
                        }
                    }
                }
                seekToSlider(closestIdx);
            });
        }

        // Initialize on load
        setTimeout(() => {
            resizeCanvas();
            initHoverEngine();
        }, 100);
    </script>
}

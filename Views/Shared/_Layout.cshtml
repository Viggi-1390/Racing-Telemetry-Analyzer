<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Racing Telemetry Analyzer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/racing-design-system.css" rel="stylesheet">
    <style>
        body {
            background-color: var(--rta-bg-canvas);
            color: var(--rta-text-primary);
            font-family: var(--rta-font-ui);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }
        .navbar-slim {
            background: rgba(13, 15, 22, 0.80) !important;
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid var(--rta-border-subtle);
            height: 52px;
            padding: 0 1.5rem !important;
            box-shadow: 0 1px 0 var(--rta-border-subtle);
            z-index: 1030;
            position: sticky;
            top: 0;
        }
        .navbar-slim::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--rta-orange), transparent);
            opacity: 0.6;
        }
        .navbar-brand {
            font-weight: 800;
            color: #ffffff !important;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: var(--rta-font-ui);
        }
        .navbar-brand .accent-text {
            color: var(--rta-orange) !important;
        }
        .nav-link {
            color: var(--rta-text-secondary) !important;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 1.2px;
            padding: 8px 16px !important;
            border-radius: var(--rta-radius-sm);
            transition: all var(--rta-duration-quick) ease;
            position: relative;
            font-family: var(--rta-font-ui);
        }
        .nav-link:hover {
            color: var(--rta-text-primary) !important;
            background: rgba(255, 255, 255, 0.04);
        }
        .nav-link.active {
            color: #ffffff !important;
            background: var(--rta-orange-subtle);
        }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 50%;
            transform: translateX(-50%);
            width: 24px;
            height: 2px;
            background: var(--rta-orange);
            border-radius: 1px;
        }
        .header-telemetry-badge {
            font-family: var(--rta-font-mono);
            font-size: 0.7rem;
            color: var(--rta-text-muted);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .status-dot-live {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: var(--rta-green);
            box-shadow: 0 0 8px var(--rta-green);
            display: inline-block;
            margin-right: 6px;
        }
        .app-main-viewport {
            min-height: calc(100vh - 52px);
            display: flex;
            flex-direction: column;
            position: relative;
        }
    </style>
</head>
<body class="rta-bg-grid rta-bg-noise">
    <header>
        <nav class="navbar navbar-expand navbar-dark navbar-slim">
            <div class="container-fluid p-0 d-flex justify-content-between align-items-center">
                <a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7l10 5 10-5-10-5z" fill="var(--rta-orange)" opacity="0.9"/>
                        <path d="M2 17l10 5 10-5" stroke="var(--rta-orange)" stroke-width="2" fill="none" opacity="0.5"/>
                        <path d="M2 12l10 5 10-5" stroke="var(--rta-orange)" stroke-width="2" fill="none" opacity="0.7"/>
                    </svg>
                    <span>RACING TELEMETRY <span class="accent-text">ANALYZER</span></span>
                </a>
                
                <div class="d-flex align-items-center gap-1">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">GARAGE</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Telemetry" ? "active" : "")" asp-area="" asp-controller="Telemetry" asp-action="Index">TELEMETRY</a>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Track" ? "active" : "")" asp-area="" asp-controller="Track" asp-action="Index">TRACKS</a>
                </div>

                <div class="header-telemetry-badge d-none d-lg-flex">
                    <span><span class="status-dot-live"></span>SYSTEM ONLINE</span>
                    <span style="color: var(--rta-text-disabled);">|</span>
                    <span style="color: var(--rta-cyan);">RTA PRO v2.0</span>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="app-main-viewport">
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

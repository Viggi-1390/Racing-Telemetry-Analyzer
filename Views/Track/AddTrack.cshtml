@model RacingTelemetryAnalyzer.Models.Track
@{
    ViewData["Title"] = "Add Track";
}

<div class="add-track-container mx-auto" style="max-width: 600px; margin-top: 40px;">
    <h1 class="page-title text-center mb-4">ADD <span class="text-orange">TRACK</span></h1>
    
    <div class="card p-4 form-card">
        <form asp-action="AddTrack" asp-route-vehicleId="@ViewBag.VehicleId" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label">TRACK NAME</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            
            <div class="mb-3">
                <label asp-for="Country" class="form-label">LOCATION / COUNTRY</label>
                <input asp-for="Country" class="form-control" required />
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Length" class="form-label">TRACK LENGTH (KM)</label>
                    <input asp-for="Length" type="number" step="0.001" min="0.1" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NumberOfTurns" class="form-label">NUMBER OF TURNS</label>
                    <input asp-for="NumberOfTurns" type="number" min="1" class="form-control" required />
                </div>
            </div>

            <!-- Virtual / UI Only Fields -->
            <div class="mb-3">
                <label for="TrackType" class="form-label">TRACK TYPE</label>
                <select id="TrackType" name="TrackType" class="form-select form-control" required>
                    <option value="">SELECT TYPE...</option>
                    <option value="Circuit">Permanent Circuit</option>
                    <option value="Street">Street Circuit</option>
                    <option value="Oval">Oval</option>
                    <option value="Dirt">Dirt Track</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="Description" class="form-label">DESCRIPTION (OPTIONAL)</label>
                <textarea id="Description" name="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label for="ImageFile" class="form-label">TRACK IMAGE (OPTIONAL)</label>
                <input type="file" id="ImageFile" name="ImageFile" class="form-control file-input" accept="image/*" />
            </div>
            
            <div class="d-flex justify-content-between mt-4">
                <a href="/Track?vehicleId=@ViewBag.VehicleId" class="btn-cancel">CANCEL</a>
                <button type="submit" class="btn-save">SAVE TRACK</button>
            </div>
        </form>
    </div>
</div>

<style>
    body { background-color: #0a0a0c; color: #fff; }
    .page-title { font-weight: 800; letter-spacing: 3px; font-size: 2rem; }
    .text-orange { color: #ff4500; }
    
    .form-card {
        background-color: #111116;
        border: 1px solid #333;
        border-radius: 8px;
    }

    .form-label {
        font-size: 0.85rem;
        color: #00ffcc;
        letter-spacing: 1px;
        font-weight: bold;
    }

    .form-control, .form-select {
        background-color: #1a1a24;
        border: 1px solid #333;
        color: #fff;
    }
    .form-control:focus, .form-select:focus {
        background-color: #222230;
        border-color: #ff4500;
        color: #fff;
        box-shadow: 0 0 8px rgba(255,69,0,0.3);
    }
    
    .file-input {
        color: #888;
    }
    
    .btn-save {
        background: #ff4500;
        border: none;
        color: #fff;
        padding: 10px 24px;
        font-weight: bold;
        letter-spacing: 2px;
        border-radius: 4px;
        transition: all 0.3s;
    }
    .btn-save:hover {
        background: #e03e00;
        box-shadow: 0 0 15px rgba(255,69,0,0.4);
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid #555;
        color: #aaa;
        padding: 10px 24px;
        font-weight: bold;
        letter-spacing: 2px;
        border-radius: 4px;
        transition: all 0.3s;
        text-decoration: none;
    }
    .btn-cancel:hover {
        border-color: #fff;
        color: #fff;
    }
</style>

@model RacingTelemetryAnalyzer.Models.Track
@{
    ViewData["Title"] = "Add Track";
}

<div class="cinematic-track-bg"></div>
<div class="cinematic-track-overlay"></div>

<div class="add-track-container mx-auto">
    <div class="text-center mb-4">
        <div class="track-micro-tag">// CIRCUIT REGISTRATION</div>
        <h1 class="page-title">ADD <span class="text-red">TRACK</span></h1>
        <p class="page-subtitle">CONFIGURE CIRCUIT SPECIFICATIONS AND TELEMETRIC PARAMETERS</p>
    </div>
    
    <div class="form-card">
        <form asp-action="AddTrack" asp-route-vehicleId="@ViewBag.VehicleId" method="post" enctype="multipart/form-data">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small mb-3"></div>
            }
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label micro-label">TRACK NAME</label>
                <input asp-for="Name" class="form-control form-control-dark" placeholder="e.g. MONZA CIRCUIT" required />
            </div>
            
            <div class="mb-3">
                <label asp-for="Country" class="form-label micro-label">LOCATION / COUNTRY</label>
                <input asp-for="Country" class="form-control form-control-dark" placeholder="e.g. Italy" required />
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Length" class="form-label micro-label">TRACK LENGTH (KM)</label>
                    <input asp-for="Length" type="number" step="0.001" min="0.1" class="form-control form-control-dark" placeholder="5.793" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NumberOfTurns" class="form-label micro-label">NUMBER OF TURNS</label>
                    <input asp-for="NumberOfTurns" type="number" min="1" class="form-control form-control-dark" placeholder="11" required />
                </div>
            </div>

            <div class="mb-4">
                <label for="ImageFile" class="form-label micro-label">CIRCUIT MAP SCHEMATIC (OPTIONAL)</label>
                <input type="file" id="ImageFile" name="ImageFile" class="form-control form-control-dark file-input" accept="image/*" />
                <div class="form-text">High-contrast white or line schematic on dark or transparent background recommended.</div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top-subtle">
                <a href="/Track?vehicleId=@ViewBag.VehicleId" class="btn btn-outline-secondary px-4">CANCEL</a>
                <button type="submit" class="btn btn-motorsport-primary px-4">SAVE CIRCUIT</button>
            </div>
        </form>
    </div>
</div>

<style>
    .cinematic-track-bg {
        position: fixed;
        inset: 0;
        background-color: #06080c;
        background-image: 
            radial-gradient(circle at 50% 15%, rgba(255, 31, 56, 0.08) 0%, transparent 60%),
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 100% 100%, 36px 36px, 36px 36px;
        z-index: 1;
        pointer-events: none;
    }

    .cinematic-track-overlay {
        position: fixed;
        inset: 0;
        background: radial-gradient(ellipse at 50% 50%, rgba(6, 8, 12, 0.35) 0%, rgba(6, 8, 12, 0.95) 100%);
        z-index: 2;
        pointer-events: none;
    }

    .add-track-container {
        max-width: 620px;
        margin-top: 40px;
        margin-bottom: 60px;
        padding: 0 15px;
        position: relative;
        z-index: 10;
    }

    .track-micro-tag {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--rta-red);
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .page-title {
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 2rem;
        color: #ffffff;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .page-subtitle {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 1.5px;
        color: var(--rta-text-muted);
        text-transform: uppercase;
        margin-bottom: 0;
    }

    .text-red {
        color: var(--rta-red);
    }
    
    .form-card {
        background-color: rgba(11, 14, 20, 0.92);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 31, 56, 0.35);
        border-radius: 8px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 31, 56, 0.15);
        padding: 2rem;
    }

    .micro-label {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 1.2px;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .form-control-dark {
        background: rgba(5, 7, 10, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 0.88rem;
        border-radius: 4px;
        padding: 10px 14px;
    }

    .form-control-dark:focus {
        background: rgba(8, 11, 16, 0.95);
        border-color: var(--rta-red);
        box-shadow: 0 0 12px rgba(255, 31, 56, 0.35);
        color: #ffffff;
    }

    .btn-motorsport-primary {
        background: linear-gradient(135deg, #ff1f38 0%, #b8051a 100%);
        border: none;
        color: #ffffff;
        font-weight: 800;
        letter-spacing: 1.5px;
        box-shadow: 0 4px 16px rgba(255, 31, 56, 0.4);
        transition: all 0.2s ease;
    }

    .btn-motorsport-primary:hover {
        background: linear-gradient(135deg, #ff3b50 0%, #d60822 100%);
        box-shadow: 0 6px 20px rgba(255, 31, 56, 0.6);
        color: #ffffff;
    }

    .form-text {
        font-size: 0.72rem;
        color: var(--rta-text-muted);
        margin-top: 6px;
    }

    .border-top-subtle {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
</style>

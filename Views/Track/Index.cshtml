    }

    .context-menu-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
        margin: 2px 0;
    }
</style>

<script>
    const vehicleId = @vehicleId;
    let selectedTrackId = null;

    // In-memory data store serialized from backend
    const tracksData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(t => new {
        id = t.TrackId,
        name = t.Name,
        country = t.Country,
        length = t.Length,
        numberOfTurns = t.NumberOfTurns,
        imagePath = t.ImagePath
    })));

    function getCountryFlag(country) {
        if (!country) return "🏁";
        const c = country.trim().toUpperCase();
        switch (c) {
            case "ITALY": return "🇮🇹";
            case "UNITED KINGDOM":
            case "UK": return "🇬🇧";
            case "FRANCE": return "🇫🇷";
            case "BELGIUM": return "🇧🇪";
            case "JAPAN": return "🇯🇵";
            case "GERMANY": return "🇩🇪";
            case "BRAZIL": return "🇧🇷";
            case "USA":
            case "UNITED STATES":
            case "AMERICA": return "🇺🇸";
            case "AUSTRALIA": return "🇦🇺";
            case "SPAIN": return "🇪🇸";
            case "NETHERLANDS": return "🇳🇱";
            case "AUSTRIA": return "🇦🇹";
            case "CANADA": return "🇨🇦";
            default: return "🏁";
        }
    }

    function selectTrack(trackId) {
        selectedTrackId = trackId;
        const track = tracksData.find(t => t.id === trackId);
        
        // 1. Highlight Active Card
        document.querySelectorAll('.track-card').forEach(card => card.classList.remove('active'));
        const activeCard = document.getElementById('track-' + trackId);
        if (activeCard) activeCard.classList.add('active');

        // 2. Update Bottom Bar Information
        const nameEl = document.getElementById('barTrackName');
        const metaEl = document.getElementById('barTrackMeta');
        const btnContinue = document.getElementById('btnContinueTelemetry');

        if (track) {
            if (nameEl) nameEl.innerText = track.name;
            if (metaEl) metaEl.innerText = `// ${track.country.toUpperCase()} — ${track.length.toFixed(3)} KM, ${track.numberOfTurns} TURNS`;
        }

        // 3. Enable and point "PROCEED TO TELEMETRY"
        if (btnContinue) {
            btnContinue.classList.remove('disabled');
            btnContinue.href = '/Telemetry/Loading?vehicleId=' + vehicleId + '&trackId=' + trackId;
        }
    }

    function handleTrackImgError(img) {
        if (!img) return;
        img.onerror = null;
        img.style.display = 'none';
        const fallback = img.nextElementSibling;
        if (fallback) fallback.classList.remove('d-none');
    }

    // ==========================================================================
    // TRACK MANAGEMENT: RIGHT-CLICK CONTEXT MENU, ADD, EDIT & DELETE
    // ==========================================================================
    let contextTrackId = null;

    function initTrackContextMenu() {
        const menu = document.getElementById('trackContextMenu');

        document.addEventListener('contextmenu', (e) => {
            const card = e.target.closest('.track-card');
            if (card) {
                e.preventDefault();
                const id = parseInt(card.getAttribute('data-id'));
                const track = tracksData.find(t => t.id === id);
                if (!track) return;

                contextTrackId = id;
                const titleEl = document.getElementById('ctxTrackTitle');
                if (titleEl) titleEl.innerText = track.name;

                menu.classList.remove('d-none');
                const menuWidth = menu.offsetWidth || 220;
                const menuHeight = menu.offsetHeight || 110;

                let left = e.clientX + 4;
                let top = e.clientY + 4;

                if (left + menuWidth > window.innerWidth - 10) {
                    left = Math.max(10, e.clientX - menuWidth - 4);
                }
                if (top + menuHeight > window.innerHeight - 10) {
                    top = Math.max(10, e.clientY - menuHeight - 4);
                }

                menu.style.left = left + 'px';
                menu.style.top = top + 'px';
            } else {
                hideTrackContextMenu();
            }
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('#trackContextMenu')) {
                hideTrackContextMenu();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                hideTrackContextMenu();
            }
        });

        window.addEventListener('resize', hideTrackContextMenu);
        window.addEventListener('scroll', hideTrackContextMenu, true);
    }

    function hideTrackContextMenu() {
        const menu = document.getElementById('trackContextMenu');
        if (menu) menu.classList.add('d-none');
    }

    // --- ADD TRACK MODAL ---
    function previewAddTrackImage(input) {
        if (input.files && input.files[0]) {
            const previewImg = document.getElementById('addTrackImagePreview');
            if (previewImg) {
                previewImg.src = URL.createObjectURL(input.files[0]);
            }
        }
    }

    async function submitAddTrack(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }

        const form = document.getElementById('addTrackForm');
        const btnSave = document.getElementById('btnAddTrackSubmit');
        const btnText = document.getElementById('btnAddTrackText');
        const alertError = document.getElementById('addTrackAlertError');

        if (alertError) {
            alertError.classList.add('d-none');
            alertError.innerText = '';
        }

        const tName = document.getElementById('addTrackName').value.trim();
        const tCountry = document.getElementById('addTrackCountry').value.trim();
        const tLength = parseFloat(document.getElementById('addTrackLength').value);
        const tTurns = parseInt(document.getElementById('addTrackTurns').value);

        if (!tName || !tCountry || isNaN(tLength) || tLength <= 0 || isNaN(tTurns) || tTurns <= 0) {
            if (alertError) {
                alertError.innerText = 'Please provide all required circuit metrics (Name, Country, Length > 0, Turns > 0).';
                alertError.classList.remove('d-none');
            }
            return;
        }

        if (btnSave) btnSave.disabled = true;
        if (btnText) btnText.innerText = 'SAVING...';

        const formData = new FormData(form);

        try {
            const response = await fetch('/Track/AddTrack?vehicleId=' + vehicleId, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });

            if (!response.ok) {
                let errorMsg = `Server error (HTTP ${response.status})`;
                try {
                    const errorJson = await response.json();
                    if (errorJson.message) errorMsg = errorJson.message;
                } catch (_) {}
                throw new Error(errorMsg);
            }

            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'Failed to add circuit.');
            }

            // Reload to render complete Razor markup seamlessly or select newly created
            window.location.href = '/Track?vehicleId=' + vehicleId;
        } catch (err) {
            if (alertError) {
                alertError.innerText = 'Registration failed: ' + err.message;
                alertError.classList.remove('d-none');
            }
        } finally {
            if (btnSave) btnSave.disabled = false;
            if (btnText) btnText.innerText = 'SAVE CIRCUIT';
        }
    }

    // --- EDIT TRACK MODAL ---
    function populateEditTrackForm(track) {
        document.getElementById('editTrackId').value = track.id;
        document.getElementById('editTrackName').value = track.name || '';
        document.getElementById('editTrackCountry').value = track.country || '';
        document.getElementById('editTrackLength').value = track.length || '';
        document.getElementById('editTrackTurns').value = track.numberOfTurns || '';

        const previewImg = document.getElementById('editTrackImagePreview');
        if (previewImg) {
            const fallbackPath = '/images/tracks/default-track.jpg';
            previewImg.onerror = function() {
                this.onerror = null;
                this.src = fallbackPath;
            };
            previewImg.src = track.imagePath || fallbackPath;
        }

        const fileInput = document.getElementById('editTrackImageFile');
        if (fileInput) fileInput.value = '';
    }

    async function onContextEditTrackClicked() {
        hideTrackContextMenu();
        if (!contextTrackId) return;

        const alertError = document.getElementById('editTrackAlertError');
        if (alertError) {
            alertError.classList.add('d-none');
            alertError.innerText = '';
        }

        const targetId = contextTrackId;
        const cached = tracksData.find(t => t.id === targetId);
        if (cached) {
            populateEditTrackForm(cached);
        }

        const editModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editTrackModal'));
        editModal.show();

        try {
            const response = await fetch(`/Track/GetTrack?id=${targetId}`);
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.track) {
                    populateEditTrackForm(data.track);
                    const idx = tracksData.findIndex(t => t.id === data.track.id);
                    if (idx !== -1) {
                        tracksData[idx] = data.track;
                    }
                }
            }
        } catch (_) {}
    }

    function previewTrackEditImage(input) {
        if (input.files && input.files[0]) {
            const previewImg = document.getElementById('editTrackImagePreview');
            if (previewImg) {
                previewImg.src = URL.createObjectURL(input.files[0]);
            }
        }
    }

    async function submitEditTrack(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }

        const form = document.getElementById('editTrackForm');
        const btnSave = document.getElementById('btnSaveTrack');
        const btnSaveText = document.getElementById('btnSaveTrackText');
        const alertError = document.getElementById('editTrackAlertError');

        if (alertError) {
            alertError.classList.add('d-none');
            alertError.innerText = '';
        }

        const tName = document.getElementById('editTrackName').value.trim();
        const tCountry = document.getElementById('editTrackCountry').value.trim();
        const tLength = parseFloat(document.getElementById('editTrackLength').value);
        const tTurns = parseInt(document.getElementById('editTrackTurns').value);

        if (!tName || !tCountry || isNaN(tLength) || tLength <= 0 || isNaN(tTurns) || tTurns <= 0) {
            if (alertError) {
                alertError.innerText = 'Please provide valid values for all fields.';
                alertError.classList.remove('d-none');
            }
            return;
        }

        if (btnSave) btnSave.disabled = true;
        if (btnSaveText) btnSaveText.innerText = 'SAVING...';

        const formData = new FormData(form);

        try {
            const response = await fetch('/Track/EditTrack', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                let errorMsg = `Server error (HTTP ${response.status})`;
                try {
                    const errorJson = await response.json();
                    if (errorJson.message) errorMsg = errorJson.message;
                } catch (_) {}
                throw new Error(errorMsg);
            }

            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'Failed to update track.');
            }

            const updated = result.track;
            const idx = tracksData.findIndex(t => t.id === updated.id);
            if (idx !== -1) {
                tracksData[idx] = updated;
            } else {
                tracksData.push(updated);
            }

            // Update DOM Card
            const card = document.querySelector(`.track-card[data-id="${updated.id}"]`);
            if (card) {
                card.setAttribute('data-name', updated.name);
                card.setAttribute('data-country', updated.country);
                card.setAttribute('data-length', updated.length);
                card.setAttribute('data-turns', updated.numberOfTurns);
                card.setAttribute('data-img', updated.imagePath);

                const nameEl = card.querySelector('.track-card-name');
                if (nameEl) nameEl.innerText = updated.name;

                const flagEmoji = getCountryFlag(updated.country);
                const flagIcon = card.querySelector('.track-flag-icon');
                if (flagIcon) flagIcon.innerText = flagEmoji;

                const countryName = card.querySelector('.track-country-name');
                if (countryName) countryName.innerText = updated.country.toUpperCase();

                const lengthEl = card.querySelector('.track-stat-length');
                if (lengthEl) lengthEl.innerText = updated.length.toFixed(3) + ' KM';

                const turnsEl = card.querySelector('.track-stat-turns');
                if (turnsEl) turnsEl.innerText = updated.numberOfTurns;

                const imgEl = card.querySelector('.track-circuit-img');
                if (imgEl && updated.imagePath) {
                    imgEl.src = updated.imagePath;
                    imgEl.style.display = 'block';
                    const fallbackEl = card.querySelector('.track-fallback-schematic');
                    if (fallbackEl) fallbackEl.classList.add('d-none');
                }
            }

            // Update bottom bar if this track is currently active
            if (selectedTrackId === updated.id) {
                selectTrack(updated.id);
            }

            const modalEl = document.getElementById('editTrackModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            form.reset();
        } catch (err) {
            if (alertError) {
                alertError.innerText = 'Save failed: ' + err.message;
                alertError.classList.remove('d-none');
            }
        } finally {
            if (btnSave) btnSave.disabled = false;
            if (btnSaveText) btnSaveText.innerText = 'SAVE CHANGES';
        }
    }

    // --- DELETE TRACK MODAL ---
    function onContextDeleteTrackClicked() {
        hideTrackContextMenu();
        if (!contextTrackId) return;
        const track = tracksData.find(t => t.id === contextTrackId);
        if (!track) return;

        const nameEl = document.getElementById('deleteTrackName');
        if (nameEl) nameEl.innerText = `"${track.name}"`;

        const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteTrackModal'));
        deleteModal.show();
    }

    async function confirmDeleteTrack() {
        if (!contextTrackId) return;
        const btnDelete = document.getElementById('btnConfirmDeleteTrack');
        const textDelete = document.getElementById('btnDeleteTrackText');
        if (btnDelete) btnDelete.disabled = true;
        if (textDelete) textDelete.innerText = 'DELETING...';

        try {
            const response = await fetch('/Track/DeleteTrack', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'id=' + contextTrackId
            });

            if (!response.ok) {
                let errorMsg = `Server error (HTTP ${response.status})`;
                try {
                    const errorJson = await response.json();
                    if (errorJson.message) errorMsg = errorJson.message;
                } catch (_) {}
                throw new Error(errorMsg);
            }

            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'Failed to delete track.');
            }

            const deletedId = contextTrackId;

            const idx = tracksData.findIndex(t => t.id === deletedId);
            if (idx !== -1) {
                tracksData.splice(idx, 1);
            }

            const card = document.querySelector(`.track-card[data-id="${deletedId}"]`);
            if (card) card.remove();

            const modalEl = document.getElementById('deleteTrackModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            if (selectedTrackId === deletedId) {
                const remainingCards = Array.from(document.querySelectorAll('.track-card'));
                if (remainingCards.length > 0) {
                    const newId = parseInt(remainingCards[0].getAttribute('data-id'));
                    selectTrack(newId);
                } else {
                    selectedTrackId = null;
                    const btnContinue = document.getElementById('btnContinueTelemetry');
                    if (btnContinue) {
                        btnContinue.classList.add('disabled');
                        btnContinue.href = '#';
                    }
                    const nameEl = document.getElementById('barTrackName');
                    if (nameEl) nameEl.innerText = 'NO TRACKS IN SYSTEM';
                    const metaEl = document.getElementById('barTrackMeta');
                    if (metaEl) metaEl.innerText = '// USE "+ ADD TRACK" TO REGISTER CIRCUITS';
                }
            }
        } catch (err) {
            alert('Failed to delete track: ' + err.message);
        } finally {
            if (btnDelete) btnDelete.disabled = false;
            if (textDelete) textDelete.innerText = 'DELETE CIRCUIT';
            contextTrackId = null;
        }
    }

    // Modal Cleanup Listeners
    const editTrackModalEl = document.getElementById('editTrackModal');
    if (editTrackModalEl) {
        editTrackModalEl.addEventListener('hidden.bs.modal', function () {
            const alertError = document.getElementById('editTrackAlertError');
            if (alertError) {
                alertError.classList.add('d-none');
                alertError.innerText = '';
            }
            const form = document.getElementById('editTrackForm');
            if (form) form.reset();
            const fileInput = document.getElementById('editTrackImageFile');
            if (fileInput) fileInput.value = '';
        });
    }

    const addTrackModalEl = document.getElementById('addTrackModal');
    if (addTrackModalEl) {
        addTrackModalEl.addEventListener('hidden.bs.modal', function () {
            const alertError = document.getElementById('addTrackAlertError');
            if (alertError) {
                alertError.classList.add('d-none');
                alertError.innerText = '';
            }
            const form = document.getElementById('addTrackForm');
            if (form) form.reset();
            const fileInput = document.getElementById('addTrackImageFile');
            if (fileInput) fileInput.value = '';
            const preview = document.getElementById('addTrackImagePreview');
            if (preview) preview.src = '/images/tracks/default-track.jpg';
        });
    }

    // Initialize on Load: Auto-select initial track
    window.addEventListener('DOMContentLoaded', () => {
        initTrackContextMenu();

        const urlParams = new URLSearchParams(window.location.search);
        const reqTrackId = parseInt(urlParams.get('trackId'));

        if (reqTrackId && tracksData.some(t => t.id === reqTrackId)) {
            selectTrack(reqTrackId);
        } else if (tracksData.length > 0) {
            const preferredTrack = tracksData.find(t => t.name.toUpperCase().includes('MONZA')) 
                                || tracksData.find(t => t.name.toUpperCase().includes('LAGUNA'))
                                || tracksData[0];
            selectTrack(preferredTrack.id);
        }
    });
</script>

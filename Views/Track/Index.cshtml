@model IEnumerable<RacingTelemetryAnalyzer.Models.Track>
@{
    ViewData["Title"] = "Track Selection";
    var assignedVehicle = ViewBag.Vehicle as RacingTelemetryAnalyzer.Models.Vehicle;
    int vehicleId = (ViewBag.VehicleId != null && (int)ViewBag.VehicleId > 0) ? (int)ViewBag.VehicleId : (assignedVehicle?.VehicleId ?? 1);
}

<!-- CINEMATIC MOTORSPORT BACKGROUND ENVIRONMENT & REFLECTION SYSTEM -->
<div class="cinematic-track-bg"></div>
<div class="cinematic-track-overlay"></div>

<div class="track-workstation-container">
    <!-- TOP HEADER / CONTROL STRIP -->
    <div class="track-header-bar">
        <div class="track-title-block">
            <div class="track-micro-tag">// CIRCUIT WORKSTATION</div>
            <h1 class="track-page-title">TRACK <span class="text-red">SELECTION</span></h1>
            <p class="track-page-desc">SELECT TARGET CIRCUIT FOR TELEMETRIC DATA ANALYSIS & PERFORMANCE ACQUISITION</p>
        </div>

        <div class="track-header-actions">
            @if (assignedVehicle != null)
            {
                <div class="assigned-vehicle-badge">
                    <span class="micro-indicator-dot"></span>
                    <span class="badge-lbl">ASSIGNED MACHINE:</span>
                    <span class="badge-val">@assignedVehicle.Name</span>
                    <span class="badge-tag">@(assignedVehicle.Class ?? (assignedVehicle.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Car ? "RACE" : "BIKE"))</span>
                </div>
            }

            <button type="button" class="btn-add-track-nav" data-bs-toggle="modal" data-bs-target="#addTrackModal">
                <span class="plus-sign">+</span>
                <span>ADD TRACK</span>
            </button>
        </div>
    </div>

    <!-- MAIN CIRCUITS GRID VIEWPORT -->
    <div class="track-grid-viewport">
        <div class="track-grid" id="trackGrid">
            @foreach (var track in Model)
            {
                string flagEmoji = track.Country.ToUpper() switch {
                    "ITALY" => "🇮🇹",
                    "UNITED KINGDOM" or "UK" => "🇬🇧",
                    "FRANCE" => "🇫🇷",
                    "BELGIUM" => "🇧🇪",
                    "JAPAN" => "🇯🇵",
                    "GERMANY" => "🇩🇪",
                    "BRAZIL" => "🇧🇷",
                    "USA" or "UNITED STATES" or "AMERICA" => "🇺🇸",
                    "AUSTRALIA" => "🇦🇺",
                    "SPAIN" => "🇪🇸",
                    "NETHERLANDS" => "🇳🇱",
                    "AUSTRIA" => "🇦🇹",
                    "CANADA" => "🇨🇦",
                    _ => "🏁"
                };

                <div class="track-card" id="track-@track.TrackId" 
                     data-id="@track.TrackId"
                     data-name="@track.Name"
                     data-country="@track.Country"
                     data-length="@track.Length"
                     data-turns="@track.NumberOfTurns"
                     data-img="@track.ImagePath"
                     onclick="selectTrack(@track.TrackId)">
                    
                    <!-- CARD HEADER: ACTIVE BADGE & LOCATION -->
                    <div class="track-card-header">
                        <div class="active-indicator-pill">
                            <span class="active-dot-pulse"></span>
                            <span>ACTIVE</span>
                        </div>
                        <div class="track-flag-country">
                            <span class="track-flag-icon">@flagEmoji</span>
                            <span class="track-country-name">@track.Country.ToUpper()</span>
                        </div>
                    </div>

                    <!-- CIRCUIT NAME -->
                    <div class="track-card-title-wrap">
                        <h2 class="track-card-name">@track.Name</h2>
                        <span class="track-card-index">// TRK-@track.TrackId.ToString("D2")</span>
                    </div>

                    <!-- CIRCUIT SCHEMATIC VIEWPORT -->
                    <div class="track-map-viewport">
                        <!-- HUD CORNER RETICLES -->
                        <div class="hud-reticle hud-tl">+</div>
                        <div class="hud-reticle hud-tr">+</div>
                        <div class="hud-reticle hud-bl">+</div>
                        <div class="hud-reticle hud-br">+</div>

                        <img src="@track.ImagePath" alt="@track.Name Circuit Schematic" class="track-circuit-img" onerror="handleTrackImgError(this)" />
                        
                        <div class="track-fallback-schematic d-none">
                            <svg viewBox="0 0 100 50" class="fallback-circuit-svg">
                                <path d="M 15,25 C 25,5 45,5 50,25 C 55,45 75,45 85,25 C 75,5 55,5 50,25 C 45,45 25,45 15,25 Z" fill="none" stroke="#ff1f38" stroke-width="1.6" stroke-dasharray="3 3" />
                            </svg>
                            <span class="fallback-circuit-text">CIRCUIT SCHEMATIC STANDBY</span>
                        </div>

                        <!-- AMBIENT CIRCUIT UNDERGLOW -->
                        <div class="circuit-ambient-glow"></div>
                    </div>

                    <!-- CIRCUIT SPECIFICATIONS -->
                    <div class="track-card-specs">
                        <div class="spec-col">
                            <span class="spec-label">LENGTH</span>
                            <span class="spec-value text-cyan track-stat-length">@track.Length.ToString("F3") KM</span>
                        </div>
                        <div class="spec-divider"></div>
                        <div class="spec-col">
                            <span class="spec-label">TURNS</span>
                            <span class="spec-value text-white track-stat-turns">@track.NumberOfTurns</span>
                        </div>
                        <div class="spec-divider"></div>
                        <div class="spec-col">
                            <span class="spec-label">DIRECTION</span>
                            <span class="spec-value text-muted">CLOCKWISE</span>
                        </div>
                    </div>

                    <!-- CARD BOTTOM RED ACCENT STRIP -->
                    <div class="card-bottom-accent"></div>
                </div>
            }
        </div>
    </div>

    <!-- BOTTOM ACTION BAR: SELECTED READOUT & PROCEED BUTTON -->
    <div class="track-bottom-bar">
        <div class="bottom-selected-summary">
            <span class="status-dot-green"></span>
            <span class="summary-prefix">TARGET CIRCUIT:</span>
            <span class="summary-track-name" id="barTrackName">SELECT CIRCUIT</span>
            <span class="summary-track-meta" id="barTrackMeta">// AWAITING OPERATOR INPUT</span>
        </div>

        <div class="bottom-action-container">
            <a href="#" id="btnContinueTelemetry" class="btn-proceed-telemetry disabled">
                <span class="btn-caption">PROCEED TO TELEMETRY</span>
                <span class="btn-arrow">➔</span>
            </a>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- CONTEXT MENU: RIGHT-CLICK ON TRACK CARD                                    -->
<!-- ========================================================================== -->
<div id="trackContextMenu" class="track-context-menu d-none">
    <div class="context-menu-header">
        <span class="context-track-name" id="ctxTrackTitle">TRACK</span>
        <span class="context-pill">// ACTIONS</span>
    </div>
    <div class="context-menu-items">
        <button type="button" class="context-menu-item" id="ctxBtnEditTrack" onclick="onContextEditTrackClicked()">
            <span class="ctx-icon">✏️</span>
            <span class="ctx-label">Edit Track Details</span>
        </button>
        <div class="context-menu-divider"></div>
        <button type="button" class="context-menu-item item-danger" id="ctxBtnDeleteTrack" onclick="onContextDeleteTrackClicked()">
            <span class="ctx-icon">🗑️</span>
            <span class="ctx-label">Delete Track</span>
        </button>
    </div>
</div>

<!-- ========================================================================== -->
<!-- MODAL: ADD NEW TRACK                                                       -->
<!-- ========================================================================== -->
<div class="modal fade" id="addTrackModal" tabindex="-1" aria-labelledby="addTrackModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-motorsport">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="addTrackModalLabel">
                    <span class="text-red">🏁</span> REGISTER NEW CIRCUIT SPECIFICATION
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addTrackForm" onsubmit="submitAddTrack(event)">
                <div class="modal-body p-4">
                    <div id="addTrackAlertError" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                    <!-- SECTION 1: IDENTITY -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 01 CIRCUIT IDENTITY</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label micro-label">CIRCUIT NAME</label>
                                <input type="text" id="addTrackName" name="Name" class="form-control form-control-dark" required placeholder="e.g. MONZA CIRCUIT">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label micro-label">COUNTRY / LOCATION</label>
                                <input type="text" id="addTrackCountry" name="Country" class="form-control form-control-dark" required placeholder="e.g. Italy">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: SPECIFICATIONS -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 02 CIRCUIT METRICS</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label micro-label">CIRCUIT LENGTH (KM)</label>
                                <input type="number" id="addTrackLength" name="Length" class="form-control form-control-dark" step="0.001" min="0.1" max="100" required placeholder="5.793">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label micro-label">NUMBER OF TURNS</label>
                                <input type="number" id="addTrackTurns" name="NumberOfTurns" class="form-control form-control-dark" min="1" max="200" required placeholder="11">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: CIRCUIT MAP IMAGE -->
                    <div class="modal-section-box">
                        <div class="modal-section-title">// 03 CIRCUIT MAP SCHEMATIC</div>
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <div class="edit-img-preview-box">
                                    <img id="addTrackImagePreview" src="/images/tracks/default-track.jpg" alt="Track Preview" />
                                </div>
                            </div>
                            <div class="col">
                                <label class="form-label micro-label">UPLOAD CIRCUIT SCHEMATIC</label>
                                <input type="file" id="addTrackImageFile" name="ImageFile" accept="image/*" class="form-control form-control-dark" onchange="previewAddTrackImage(this)">
                                <small class="text-muted d-block mt-1">High-contrast white or line schematic on transparent or dark background recommended.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-motorsport-primary px-4" id="btnAddTrackSubmit">
                        <span id="btnAddTrackText">SAVE CIRCUIT</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- MODAL: EDIT TRACK DETAILS                                                  -->
<!-- ========================================================================== -->
<div class="modal fade" id="editTrackModal" tabindex="-1" aria-labelledby="editTrackModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-motorsport">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="editTrackModalLabel">
                    <span class="text-red">✏️</span> EDIT CIRCUIT SPECIFICATIONS
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editTrackForm" onsubmit="submitEditTrack(event)">
                <input type="hidden" id="editTrackId" name="TrackId" value="" />
                <div class="modal-body p-4">
                    <div id="editTrackAlertError" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                    <!-- SECTION 1: IDENTITY -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 01 CIRCUIT IDENTITY</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label micro-label">CIRCUIT NAME</label>
                                <input type="text" id="editTrackName" name="Name" class="form-control form-control-dark" required placeholder="e.g. MONZA">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label micro-label">COUNTRY / LOCATION</label>
                                <input type="text" id="editTrackCountry" name="Country" class="form-control form-control-dark" required placeholder="e.g. Italy">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: SPECIFICATIONS -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 02 CIRCUIT METRICS</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label micro-label">CIRCUIT LENGTH (KM)</label>
                                <input type="number" id="editTrackLength" name="Length" class="form-control form-control-dark" step="0.001" min="0.1" max="100" required placeholder="5.793">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label micro-label">NUMBER OF TURNS</label>
                                <input type="number" id="editTrackTurns" name="NumberOfTurns" class="form-control form-control-dark" min="1" max="200" required placeholder="11">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: CIRCUIT MAP IMAGE -->
                    <div class="modal-section-box">
                        <div class="modal-section-title">// 03 CIRCUIT MAP SCHEMATIC</div>
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <div class="edit-img-preview-box">
                                    <img id="editTrackImagePreview" src="/images/tracks/default-track.jpg" alt="Track Preview" onerror="this.onerror=null; this.src='/images/tracks/default-track.jpg';" />
                                </div>
                            </div>
                            <div class="col">
                                <label class="form-label micro-label">UPDATE CIRCUIT SCHEMATIC</label>
                                <input type="file" id="editTrackImageFile" name="ImageFile" accept="image/*" class="form-control form-control-dark" onchange="previewTrackEditImage(this)">
                                <small class="text-muted d-block mt-1">Leave empty to keep current schematic. Supports JPG, PNG, WEBP, SVG.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-motorsport-primary px-4" id="btnSaveTrack">
                        <span id="btnSaveTrackText">SAVE CHANGES</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================== -->
<!-- MODAL: DELETE TRACK CONFIRMATION                                           -->
<!-- ========================================================================== -->
<div class="modal fade" id="deleteTrackModal" tabindex="-1" aria-labelledby="deleteTrackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-motorsport border-danger">
            <div class="modal-header border-danger-subtle">
                <h5 class="modal-title d-flex align-items-center gap-2 text-danger" id="deleteTrackModalLabel">
                    <span>⚠️</span> DELETE CIRCUIT SPECIFICATION?
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="mb-2 text-secondary">Are you sure you want to permanently remove:</p>
                <h4 class="text-white fw-bold mb-3" id="deleteTrackName">CIRCUIT NAME</h4>
                <div class="alert alert-danger py-2 px-3 small border-0" style="background: rgba(255, 31, 56, 0.15); color: #ff8595;">
                    This action cannot be undone. All telemetry sessions and laps registered for this circuit will be isolated or deleted.
                </div>
            </div>
            <div class="modal-footer justify-content-center gap-3">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                <button type="button" class="btn btn-danger px-4 fw-bold" id="btnConfirmDeleteTrack" onclick="confirmDeleteTrack()">
                    <span id="btnDeleteTrackText">DELETE CIRCUIT</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* --------------------------------------------------------------------------
       1. CINEMATIC MOTORSPORT ENVIRONMENT
       -------------------------------------------------------------------------- */
    .cinematic-track-bg {
        position: fixed;
        inset: 0;
        background-color: #06080c;
        background-image: 
            radial-gradient(circle at 50% 15%, rgba(255, 31, 56, 0.08) 0%, transparent 60%),
            radial-gradient(circle at 10% 85%, rgba(14, 20, 32, 0.6) 0%, transparent 50%),
            radial-gradient(circle at 90% 85%, rgba(14, 20, 32, 0.6) 0%, transparent 50%),
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 100% 100%, 36px 36px, 36px 36px;
        z-index: 1;
        pointer-events: none;
    }

    .cinematic-track-overlay {
        position: fixed;
        inset: 0;
        background: 
            radial-gradient(ellipse at 50% 50%, rgba(6, 8, 12, 0.35) 0%, rgba(6, 8, 12, 0.88) 70%, rgba(6, 8, 12, 0.98) 100%),
            linear-gradient(to bottom, rgba(6, 8, 12, 0.85) 0%, transparent 15%, transparent 75%, rgba(6, 8, 12, 0.95) 100%);
        z-index: 2;
        pointer-events: none;
    }

    /* --------------------------------------------------------------------------
       2. WORKSTATION MAIN CONTAINER
       -------------------------------------------------------------------------- */
    .track-workstation-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 52px);
        position: relative;
        z-index: 10;
        overflow: hidden;
        user-select: none;
    }

    /* --------------------------------------------------------------------------
       3. TOP HEADER / CONTROL STRIP
       -------------------------------------------------------------------------- */
    .track-header-bar {
        height: 72px;
        flex: 0 0 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        background: rgba(9, 12, 18, 0.85);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
        z-index: 12;
    }

    .track-title-block {
        display: flex;
        flex-direction: column;
    }

    .track-micro-tag {
        font-family: var(--font-mono);
        font-size: 0.64rem;
        font-weight: 800;
        color: var(--rta-red);
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 1px;
    }

    .track-page-title {
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: #ffffff;
        margin: 0;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .track-page-desc {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 1.2px;
        margin: 0;
        text-transform: uppercase;
    }

    .text-red {
        color: var(--rta-red);
    }

    .track-header-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .assigned-vehicle-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(18, 22, 32, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 6px 14px;
        border-radius: 6px;
        font-family: var(--font-mono);
    }

    .micro-indicator-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--rta-red);
        box-shadow: 0 0 8px var(--rta-red);
        display: inline-block;
    }

    .badge-lbl {
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--rta-text-muted);
        letter-spacing: 1px;
    }

    .badge-val {
        font-size: 0.8rem;
        font-weight: 900;
        color: #ffffff;
        letter-spacing: 1px;
    }

    .badge-tag {
        font-size: 0.66rem;
        font-weight: 800;
        background: rgba(255, 31, 56, 0.16);
        color: var(--rta-red);
        border: 1px solid rgba(255, 31, 56, 0.4);
        padding: 1px 6px;
        border-radius: 4px;
        letter-spacing: 0.8px;
    }

    .btn-add-track-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 31, 56, 0.10);
        border: 1.5px dashed var(--rta-red);
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 1.8px;
        padding: 7px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

    .btn-add-track-nav:hover {
        background: var(--rta-red);
        box-shadow: 0 0 20px var(--rta-red-glow);
        border-style: solid;
        color: #ffffff;
    }

    .btn-add-track-nav .plus-sign {
        font-size: 1.1rem;
        font-weight: 900;
        line-height: 1;
        color: var(--rta-red);
        transition: color 0.2s ease;
    }

    .btn-add-track-nav:hover .plus-sign {
        color: #ffffff;
    }

    /* --------------------------------------------------------------------------
       4. MAIN CIRCUITS GRID VIEWPORT
       -------------------------------------------------------------------------- */
    .track-grid-viewport {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 24px 32px 32px 32px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 31, 56, 0.4) rgba(10, 14, 22, 0.6);
    }

    .track-grid-viewport::-webkit-scrollbar {
        width: 6px;
    }
    .track-grid-viewport::-webkit-scrollbar-track {
        background: rgba(10, 14, 22, 0.6);
    }
    .track-grid-viewport::-webkit-scrollbar-thumb {
        background: rgba(255, 31, 56, 0.4);
        border-radius: 3px;
    }
    .track-grid-viewport::-webkit-scrollbar-thumb:hover {
        background: var(--rta-red);
    }

    .track-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        max-width: 1840px;
        margin: 0 auto;
    }

    @@media (max-width: 1680px) {
        .track-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 1200px) {
        .track-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .track-grid {
            grid-template-columns: 1fr;
        }
    }

    /* --------------------------------------------------------------------------
       5. TRACK CARD DESIGN
       -------------------------------------------------------------------------- */
    .track-card {
        background: rgba(11, 14, 20, 0.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
        position: relative;
        overflow: hidden;
    }

    .track-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 31, 56, 0.45);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.85), 0 0 16px rgba(255, 31, 56, 0.2);
    }

    .track-card.active {
        border-color: var(--rta-red) !important;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.9), 0 0 25px rgba(255, 31, 56, 0.4), inset 0 0 15px rgba(255, 31, 56, 0.12) !important;
    }

    /* CARD HEADER */
    .track-card-header {

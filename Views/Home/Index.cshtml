@model IEnumerable<RacingTelemetryAnalyzer.Models.Vehicle>
@{
    ViewData["Title"] = "Garage — Vehicle Selection";
}

<!-- CINEMATIC MOTORSPORT BACKGROUND ENVIRONMENT & REFLECTION SYSTEM -->
<div class="cinematic-garage-bg"></div>
<div class="cinematic-garage-overlay"></div>


<div class="garage-workstation-container">
    <!-- UPPER 68% SECTION: THREE MAIN ENGINEERING PANELS -->
    <div class="workstation-upper-grid">
        <!-- 1. LEFT COLUMN: REAL-TIME PERFORMANCE & TYRE DYNAMICS PANEL -->
        <div class="dash-panel panel-performance">
            <div class="panel-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="panel-tag">// 01</span>
                    <span class="panel-title">PERFORMANCE</span>
                </div>
                <div class="status-indicator-wrap">
                    <span class="status-dot-pulse"></span>
                    <span class="status-label">CALIBRATED</span>
                </div>
            </div>

            <!-- SPEED RADIAL GAUGE -->
            <div class="gauge-container">
                <svg class="radial-gauge-svg" viewBox="0 0 220 220">
                    <circle cx="110" cy="110" r="90" class="gauge-track-bg" />
                    <circle cx="110" cy="110" r="90" class="gauge-bar-fill" id="perfGaugeArc" stroke-dasharray="565" stroke-dashoffset="141" />
                </svg>

                <div class="gauge-center-content">
                    <div class="gauge-speed-label">TOP SPEED</div>
                    <div class="gauge-speed-val" id="perfSpeedVal">338</div>
                    <div class="gauge-speed-unit">KM/H</div>
                </div>
            </div>

            <!-- GAUGE SUB-METRICS -->
            <div class="gauge-submetrics">
                <div class="submetric-box">
                    <span class="submetric-label">PEAK RPM</span>
                    <span class="submetric-val text-cyan" id="perfRpmVal">8,800</span>
                </div>
                <div class="submetric-box">
                    <span class="submetric-label">GEARBOX</span>
                    <span class="submetric-val text-white" id="perfGearVal">GEAR 7</span>
                </div>
                <div class="submetric-box">
                    <span class="submetric-label" id="perfPowerOrLeanLabel">POWER</span>
                    <span class="submetric-val text-red" id="perfPowerOrLeanVal">670 HP</span>
                </div>
            </div>

            <!-- TYRE TEMPERATURE SECTION -->
            <div class="tyre-temp-section">
                <div class="section-micro-header">
                    <span class="d-flex align-items-center gap-2">
                        <span class="red-bullet">▪</span> TYRE THERMAL TELEMETRY
                    </span>
                    <span class="text-muted font-monospace" id="tyreStatusText">OPTIMAL WINDOW</span>
                </div>

                <!-- 4-WHEEL CAR TYRE GRID -->
                <div class="tyre-grid-car" id="tyreGridCar">
                    <div class="tyre-box">
                        <span class="tyre-pos">FL</span>
                        <span class="tyre-val" id="tyreFL">84°C</span>
                    </div>
                    <div class="tyre-box">
                        <span class="tyre-pos">FR</span>
                        <span class="tyre-val" id="tyreFR">86°C</span>
                    </div>
                    <div class="tyre-box">
                        <span class="tyre-pos">RL</span>
                        <span class="tyre-val" id="tyreRL">81°C</span>
                    </div>
                    <div class="tyre-box">
                        <span class="tyre-pos">RR</span>
                        <span class="tyre-val" id="tyreRR">83°C</span>
                    </div>
                </div>

                <!-- 2-WHEEL MOTORCYCLE TYRE GRID -->
                <div class="tyre-grid-bike d-none" id="tyreGridBike">
                    <div class="tyre-box">
                        <span class="tyre-pos">FRONT</span>
                        <span class="tyre-val" id="tyreFront">85°C</span>
                    </div>
                    <div class="tyre-box">
                        <span class="tyre-pos">REAR</span>
                        <span class="tyre-val" id="tyreRear">89°C</span>
                    </div>
                    <div class="tyre-box">
                        <span class="tyre-pos">LEAN MAX</span>
                        <span class="tyre-val text-cyan" id="tyreLean">64.0°</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CENTER COLUMN: CINEMATIC HERO VEHICLE DISPLAY & LIVE CHANNELS -->
        <div class="dash-panel panel-hero-vehicle">
            <div class="panel-header justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="panel-tag">// 02</span>
                    <span class="panel-title">SELECTED MACHINE</span>
                </div>
                <div class="hero-vehicle-badge" id="heroVehicleBadge">CADILLAC V-SERIES.R GTP — LIVE VIEW</div>
            </div>

            <!-- HERO VEHICLE IMAGE CONTAINER WITH REFLECTION & UNDERGLOW -->
            <div class="hero-image-stage">
                <div class="stage-crosshair top-left">+</div>
                <div class="stage-crosshair top-right">+</div>
                <div class="stage-crosshair bottom-left">+</div>
                <div class="stage-crosshair bottom-right">+</div>

                <!-- Red ambient lighting glow under the chassis -->
                <div class="hero-ambient-underglow"></div>

                <!-- Primary Vehicle Image -->
                <img id="heroVehicleImg" 
                     src="/images/cars/CadillacVSeriesR.jpg" 
                     alt="Selected Vehicle Preview" 
                     class="hero-vehicle-img"
                     onerror="handleImageError(this)" />

                <!-- Mirrored Floor Reflection onto Wet Pit Floor -->
                <img id="heroVehicleReflectImg"
                     src="/images/cars/CadillacVSeriesR.jpg"
                     alt="Vehicle Reflection"
                     class="hero-vehicle-reflect-img" />

                <!-- Fallback when image is not present -->
                <div id="heroFallback" class="hero-fallback d-none">
                    <div class="fallback-icon">🏎️</div>
                    <div class="fallback-title">VEHICLE IMAGE NOT AVAILABLE</div>
                    <div class="fallback-sub">Custom vehicle is active. A photo can be attached via Add Vehicle or Edit Vehicle.</div>
                </div>
            </div>

            <!-- LIVE CHANNELS STRIP (THROTTLE, BRAKING, FUEL) -->
            <div class="telemetry-channels-strip">
                <div class="channel-metric-card">
                    <div class="channel-head">
                        <span class="channel-name">THROTTLE CALIBRATION</span>
                        <span class="channel-val text-cyan" id="liveThrottleVal">95%</span>
                    </div>
                    <div class="channel-progress-bg">
                        <div class="channel-progress-bar bg-cyan" id="barThrottle" style="width: 95%;"></div>
                    </div>
                </div>

                <div class="channel-metric-card">
                    <div class="channel-head">
                        <span class="channel-name">BRAKING RESPONSE</span>
                        <span class="channel-val text-red" id="liveBrakingVal">0%</span>
                    </div>
                    <div class="channel-progress-bg">
                        <div class="channel-progress-bar bg-red" id="barBraking" style="width: 0%;"></div>
                    </div>
                </div>

                <div class="channel-metric-card">
                    <div class="channel-head">
                        <span class="channel-name">FUEL CAPACITY</span>
                        <span class="channel-val text-red" id="liveFuelVal">87 L</span>
                    </div>
                    <div class="channel-progress-bg">
                        <div class="channel-progress-bar bg-red" id="barFuel" style="width: 87%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. RIGHT COLUMN: VEHICLE SPECIFICATIONS & TELEMETRY ACTION -->
        <div class="dash-panel panel-vehicle-stats">
            <div class="panel-header">
                <span class="panel-tag">// 03</span>
                <span class="panel-title">SPECIFICATIONS</span>
            </div>

            <div class="vehicle-identity-header">
                <h1 class="stats-name" id="statsVehicleName">CADILLAC V-SERIES.R</h1>
                <div class="stats-classification">
                    <span class="badge-class" id="statsClassBadge">GTP / LMDh</span>
                    <span class="badge-manufacturer" id="statsManufacturer">CADILLAC</span>
                </div>
            </div>

            <!-- TECHNICAL SPECIFICATION GRID -->
            <div class="spec-table-list">
                <div class="spec-row">
                    <span class="spec-title">POWER OUTPUT</span>
                    <span class="spec-num text-red" id="statsPowerVal">670 HP</span>
                </div>
                <div class="spec-row">
                    <span class="spec-title">CHASSIS WEIGHT</span>
                    <span class="spec-num" id="statsWeightVal">1030 KG</span>
                </div>
                <div class="spec-row">
                    <span class="spec-title">MAX VELOCITY</span>
                    <span class="spec-num text-cyan" id="statsSpeedVal">338 KM/H</span>
                </div>
                <div class="spec-row">
                    <span class="spec-title">POWERTRAIN</span>
                    <span class="spec-num text-truncate" style="max-width: 190px;" id="statsEngineVal">5.5L DOHC V8 Hybrid</span>
                </div>
                <div class="spec-row">
                    <span class="spec-title">PWR-TO-WEIGHT</span>
                    <span class="spec-num" id="statsPtwVal">0.65 HP/KG</span>
                </div>
                <div class="spec-row">
                    <span class="spec-title" id="statsExtraLabel">DRIVETRAIN</span>
                    <span class="spec-num text-truncate" style="max-width: 190px;" id="statsExtraVal">RWD Hybrid</span>
                </div>
            </div>

            <!-- ANALYZE VEHICLE ACTION BUTTON -->
            <div class="analyze-btn-container">
                <a href="/Track?vehicleId=1" class="btn-analyze-primary" id="btnAnalyzeVehicle">
                    <span class="btn-caption">PROCEED TO TRACK</span>
                    <span class="btn-icon">➔</span>
                </a>
            </div>
        </div>
    </div>

    <!-- LOWER SECTION: CATEGORY SIDEBAR + VEHICLE CARDS CAROUSEL -->
    <div class="workstation-carousel-container">
        <!-- LEFT CATEGORY FILTER SIDEBAR -->
        <div class="vehicle-filter-sidebar">
            <div class="sidebar-micro-tag">// CATEGORIES</div>
            <button type="button" class="sidebar-filter-btn active" data-filter="all" onclick="applyCategoryFilter('all', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">ALL MACHINES</span>
            </button>
            <button type="button" class="sidebar-filter-btn" data-filter="gt3" onclick="applyCategoryFilter('gt3', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">GT3 RACING</span>
            </button>
            <button type="button" class="sidebar-filter-btn" data-filter="gtp" onclick="applyCategoryFilter('gtp', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">GTP / LMDh</span>
            </button>
            <button type="button" class="sidebar-filter-btn" data-filter="f1" onclick="applyCategoryFilter('f1', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">FORMULA 1</span>
            </button>
            <button type="button" class="sidebar-filter-btn" data-filter="bike" onclick="applyCategoryFilter('bike', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">MOTORCYCLE</span>
            </button>
            <button type="button" class="sidebar-filter-btn" data-filter="production" onclick="applyCategoryFilter('production', this)">
                <span class="filter-dot"></span>
                <span class="filter-text">PRODUCTION</span>
            </button>
            <div class="sidebar-divider"></div>
            <button type="button" class="sidebar-add-btn" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
                <span class="plus-sign">+</span>
                <span>ADD VEHICLE</span>
            </button>
        </div>

        <!-- CAROUSEL PREV BUTTON -->
        <button class="carousel-arrow-btn prev-btn" id="carouselPrevBtn" title="Previous Vehicles">
            <span>‹</span>
        </button>

        <!-- HORIZONTAL CAROUSEL TRACK -->
        <div class="carousel-viewport-track" id="vehicleCarouselTrack">
            @foreach (var v in Model)
            {
                var vType = v.VehicleType.ToString().ToLower();
                var vCat = v.VehicleCategory.ToString().ToLower();

                <div class="vehicle-card" 
                     data-id="@v.VehicleId"
                     data-type="@vType" 
                     data-category="@vCat"
                     data-name="@v.Name"
                     data-manufacturer="@v.Manufacturer"
                     data-class="@(v.Class ?? "Racing")"
                     data-engine="@(v.Engine ?? "Race Engine")"
                     data-power="@v.Power"
                     data-weight="@v.Weight"
                     data-speed="@v.TopSpeed"
                     data-img="@v.ImagePath"
                     onclick="onVehicleCardClicked(this)">
                     
                     <div class="card-active-indicator">
                         <span class="card-indicator-dot"></span>
                         <span class="card-indicator-text">ACTIVE</span>
                     </div>

                     <div class="card-image-box">
                         <img src="@v.ImagePath" alt="@v.Name" class="card-thumb" onerror="handleThumbError(this)" />
                         <div class="card-gradient-overlay"></div>
                         <div class="card-top-tags">
                             <span class="badge-mini-class">@(v.Class ?? "LMDh")</span>
                             <span class="badge-mini-spec">@v.Power HP</span>
                         </div>
                     </div>

                     <div class="card-info-box">
                         <div class="card-vehicle-title" title="@v.Name">@v.Name</div>
                         <div class="card-vehicle-sub">
                             <span class="card-mfg-badge">@v.Manufacturer</span>
                             <span class="card-speed-badge">@v.TopSpeed KM/H</span>
                         </div>
                     </div>
                </div>
            }
        </div>

        <!-- CAROUSEL NEXT BUTTON -->
        <button class="carousel-arrow-btn next-btn" id="carouselNextBtn" title="Next Vehicles">
            <span>›</span>
        </button>
    </div>
</div>

<!-- MODAL: ADD VEHICLE WITH IMAGE UPLOAD -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-labelledby="addVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-motorsport">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="addVehicleModalLabel">
                    <span class="text-red">🏁</span> REGISTER NEW VEHICLE SPECIFICATION
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Home/AddVehicle" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label micro-label">VEHICLE NAME</label>
                            <input type="text" name="Name" class="form-control form-control-dark" placeholder="e.g. FERRARI 499P" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label micro-label">MANUFACTURER</label>
                            <input type="text" name="Manufacturer" class="form-control form-control-dark" placeholder="e.g. Ferrari" required>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label micro-label">TYPE</label>
                            <select name="VehicleType" class="form-select form-control-dark">
                                <option value="Car">Car</option>
                                <option value="Bike">Bike</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label micro-label">CATEGORY</label>
                            <select name="VehicleCategory" class="form-select form-control-dark">
                                <option value="Race">Race</option>
                                <option value="Production">Production</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label micro-label">CLASS / DIVISION</label>
                            <input type="text" name="Class" class="form-control form-control-dark" placeholder="e.g. Hypercar, GT3">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label micro-label">ENGINE / MOTOR</label>
                            <input type="text" name="Engine" class="form-control form-control-dark" placeholder="e.g. Twin-Turbo V6">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label micro-label">POWER (HP)</label>
                            <input type="number" name="Power" class="form-control form-control-dark" placeholder="680" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label micro-label">WEIGHT (KG)</label>
                            <input type="number" name="Weight" class="form-control form-control-dark" placeholder="1030" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label micro-label">TOP SPEED (KM/H)</label>
                            <input type="number" name="TopSpeed" class="form-control form-control-dark" placeholder="330" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label micro-label">VEHICLE IMAGE UPLOAD</label>
                            <input type="file" name="ImageFile" accept="image/*" class="form-control form-control-dark">
                            <small class="text-muted d-block mt-1">Uploaded vehicle image will be preserved and rendered in the central hero workstation and carousel cards.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-red-primary px-4">SAVE & REGISTER VEHICLE</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CONTEXT MENU: RIGHT-CLICK ON VEHICLE CARD -->
<div id="vehicleContextMenu" class="vehicle-context-menu d-none">
    <div class="context-menu-header">
        <span class="context-vehicle-name" id="ctxVehicleTitle">VEHICLE</span>
        <span class="context-pill">// ACTIONS</span>
    </div>
    <div class="context-menu-items">
        <button type="button" class="context-menu-item" id="ctxBtnEdit" onclick="onContextEditClicked()">
            <span class="ctx-icon">✏️</span>
            <span class="ctx-label">Edit Vehicle Stats</span>
        </button>
        <div class="context-menu-divider"></div>
        <button type="button" class="context-menu-item item-danger" id="ctxBtnDelete" onclick="onContextDeleteClicked()">
            <span class="ctx-icon">🗑️</span>
            <span class="ctx-label">Delete Vehicle</span>
        </button>
    </div>
</div>

<!-- MODAL: EDIT VEHICLE STATS -->
<div class="modal fade" id="editVehicleModal" tabindex="-1" aria-labelledby="editVehicleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-motorsport">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="editVehicleModalLabel">
                    <span class="text-red">✏️</span> EDIT VEHICLE SPECIFICATIONS
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editVehicleForm" onsubmit="submitEditVehicle(event)">
                <input type="hidden" id="editVehicleId" name="VehicleId" value="" />
                <div class="modal-body p-4">
                    <div id="editAlertError" class="alert alert-danger d-none py-2 px-3 small mb-3"></div>

                    <!-- SECTION 1: VEHICLE IDENTITY -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 01 VEHICLE IDENTITY</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label micro-label">MANUFACTURER</label>
                                <input type="text" id="editManufacturer" name="Manufacturer" class="form-control form-control-dark" required placeholder="e.g. Ferrari">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label micro-label">VEHICLE NAME</label>
                                <input type="text" id="editName" name="Name" class="form-control form-control-dark" required placeholder="e.g. 499P">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label micro-label">VEHICLE TYPE</label>
                                <select id="editVehicleType" name="VehicleType" class="form-select form-control-dark">
                                    <option value="Car">Car</option>
                                    <option value="Bike">Bike</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label micro-label">CATEGORY</label>
                                <select id="editVehicleCategory" name="VehicleCategory" class="form-select form-control-dark">
                                    <option value="Race">Race</option>
                                    <option value="Production">Production</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label micro-label">CLASS / DIVISION</label>
                                <input type="text" id="editClass" name="Class" class="form-control form-control-dark" placeholder="e.g. Hypercar, Superbike">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label micro-label">ENGINE / MOTOR</label>
                                <input type="text" id="editEngine" name="Engine" class="form-control form-control-dark" placeholder="e.g. 3.0L Twin-Turbo V6">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: PERFORMANCE METRICS -->
                    <div class="modal-section-box mb-4">
                        <div class="modal-section-title">// 02 PERFORMANCE METRICS</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label micro-label">HORSEPOWER (HP)</label>
                                <input type="number" id="editPower" name="Power" class="form-control form-control-dark" min="1" max="3000" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label micro-label">WEIGHT (KG)</label>
                                <input type="number" id="editWeight" name="Weight" class="form-control form-control-dark" min="1" max="10000" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label micro-label">TOP SPEED (KM/H)</label>
                                <input type="number" id="editTopSpeed" name="TopSpeed" class="form-control form-control-dark" min="1" max="600" required>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: VEHICLE IMAGE -->
                    <div class="modal-section-box">
                        <div class="modal-section-title">// 03 VEHICLE IMAGE</div>
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <div class="edit-img-preview-box">
                                    <img id="editImagePreview" src="/images/placeholder_car.png" alt="Vehicle Preview" onerror="this.onerror=null; this.src='/images/placeholder_car.png';" />
                                </div>
                            </div>
                            <div class="col">
                                <label class="form-label micro-label">CHANGE / UPLOAD IMAGE</label>
                                <input type="file" id="editImageFile" name="ImageFile" accept="image/*" class="form-control form-control-dark" onchange="previewEditImage(this)">
                                <small class="text-muted d-block mt-1">Leave empty to keep current image. Supports JPG, PNG, WEBP.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                    <button type="submit" class="btn btn-red-primary px-4" id="btnSaveVehicle">
                        <span id="btnSaveVehicleText">SAVE CHANGES</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: DELETE VEHICLE CONFIRMATION -->
<div class="modal fade" id="deleteVehicleModal" tabindex="-1" aria-labelledby="deleteVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-motorsport border-danger">
            <div class="modal-header border-danger-subtle">
                <h5 class="modal-title d-flex align-items-center gap-2 text-danger" id="deleteVehicleModalLabel">
                    <span>⚠️</span> DELETE VEHICLE?
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="mb-2 text-secondary">Are you sure you want to delete:</p>
                <h4 class="text-white fw-bold mb-3" id="deleteVehicleName">VEHICLE NAME</h4>
                <div class="alert alert-warning py-2 px-3 small border-0" style="background: rgba(234, 179, 8, 0.15); color: #facc15;">
                    This action cannot be undone. All telemetry sessions for this vehicle will also be removed.
                </div>
            </div>
            <div class="modal-footer justify-content-center gap-3">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">CANCEL</button>
                <button type="button" class="btn btn-danger px-4 fw-bold" id="btnConfirmDelete" onclick="confirmDeleteVehicle()">
                    <span id="btnDeleteText">DELETE</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* ==========================================================================
       DARK + BLACK + RED CINEMATIC MOTORSPORT THEME (1920x1080 OPTIMIZED)
       ========================================================================== */
    :root {
        --rta-black:         #050608;
        --rta-charcoal:      #0b0d12;
        --rta-surface:       #11141c;
        --rta-surface-hover: #191d29;
        --rta-red:           #ff1f38;
        --rta-red-bright:    #ff3b50;
        --rta-red-glow:      rgba(255, 31, 56, 0.45);
        --rta-red-subtle:    rgba(255, 31, 56, 0.15);
        --rta-cyan:          #00d2ff;
        --rta-cyan-glow:     rgba(0, 210, 255, 0.35);
        --rta-green:         #00e676;
        --rta-border-subtle: rgba(255, 255, 255, 0.08);
        --rta-border-glow:   rgba(255, 31, 56, 0.35);
        --rta-text-white:    #ffffff;
        --rta-text-light:    #e2e8f0;
        --rta-text-muted:    #828a9c;
        --rta-text-dim:      #4b5364;
        --font-mono:         'JetBrains Mono', monospace;
    }

    body {
        background-color: var(--rta-black);
        overflow: hidden;
    }

    /* --------------------------------------------------------------------------
       1. CINEMATIC MOTORSPORT BACKGROUND & REFLECTIONS
       -------------------------------------------------------------------------- */
    .cinematic-garage-bg {
        position: fixed;
        inset: 0;
        background-image: url('/images/loading/pit-garage-background.jpg');
        background-size: cover;
        background-position: center 46%;
        background-repeat: no-repeat;
        z-index: 1;
        filter: brightness(0.70) contrast(1.15);
        pointer-events: none;
    }

    .cinematic-garage-overlay {
        position: fixed;
        inset: 0;
        background: 
            radial-gradient(ellipse at 50% 48%, rgba(5, 6, 8, 0.40) 0%, rgba(5, 6, 8, 0.85) 65%, rgba(5, 6, 8, 0.98) 100%),
            linear-gradient(to bottom, rgba(5, 6, 8, 0.90) 0%, transparent 20%, transparent 70%, rgba(5, 6, 8, 0.95) 100%);
        z-index: 2;
        pointer-events: none;
    }

    /* --------------------------------------------------------------------------
       2. WORKSTATION MAIN CONTAINER
       -------------------------------------------------------------------------- */
    .garage-workstation-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 52px);
        position: relative;
        z-index: 10;
        overflow: hidden;
        user-select: none;
    }

    /* --------------------------------------------------------------------------
       3. UPPER ZONE: 3 MAIN PANELS (PERFORMANCE, HERO VEHICLE, STATS)
       -------------------------------------------------------------------------- */
    .workstation-upper-grid {
        height: 64%;
        flex: 0 0 64%;
        min-height: 420px;
        display: grid;
        grid-template-columns: 27.5% 45% 27.5%;
        gap: 16px;
        padding: 12px 28px 8px 28px;
    }

    .dash-panel {
        background: rgba(11, 14, 20, 0.78);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--rta-border-subtle);
        border-radius: 8px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.85);
        display: flex;
        flex-direction: column;
        padding: 16px 20px;
        overflow: hidden;
        position: relative;
        transition: border-color 0.25s ease;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding-bottom: 8px;
    }

    .panel-tag {
        font-family: var(--font-mono);
        color: var(--rta-red);
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .panel-title {
        font-size: 0.90rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #ffffff;
    }

    .status-indicator-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--rta-text-muted);
        letter-spacing: 1px;
    }

    .status-dot-pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: var(--rta-green);
        box-shadow: 0 0 8px var(--rta-green);
        display: inline-block;
    }

    /* --------------------------------------------------------------------------
       PANEL 1: PERFORMANCE GAUGE & TYRE THERMALS (LEFT)
       -------------------------------------------------------------------------- */
    .panel-performance {
        border-top: 3px solid var(--rta-red);
        justify-content: space-between;
    }

    .gauge-container {
        position: relative;
        width: clamp(190px, 21vh, 230px);
        height: clamp(190px, 21vh, 230px);
        margin: 2px auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .radial-gauge-svg {
        width: 100%;
        height: 100%;
        transform: rotate(135deg);
    }

    .gauge-track-bg {
        fill: none;
        stroke: rgba(255, 255, 255, 0.06);
        stroke-width: 11;
        stroke-dasharray: 565;
        stroke-dashoffset: 141;
    }

    .gauge-bar-fill {
        fill: none;
        stroke: var(--rta-cyan);
        stroke-width: 11;
        stroke-linecap: round;
        transition: stroke-dashoffset 0.6s cubic-bezier(0.2, 1, 0.3, 1), stroke 0.6s ease;
        filter: drop-shadow(0 0 8px var(--rta-cyan-glow));
    }

    .gauge-center-content {
        position: absolute;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .gauge-speed-label {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 2.2px;
        font-weight: 700;
    }

    .gauge-speed-val {
        font-size: clamp(3.4rem, 4.4vh, 4.2rem);
        font-family: var(--font-mono);
        font-weight: 900;
        color: #ffffff;
        line-height: 0.95;
        letter-spacing: -2px;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    }

    .gauge-speed-unit {
        font-size: 0.95rem;
        font-family: var(--font-mono);
        font-weight: 800;
        color: var(--rta-cyan);
        letter-spacing: 1.5px;
        margin-top: 2px;
    }

    .gauge-submetrics {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
        margin: 4px 0;
    }

    .submetric-box {
        background: rgba(5, 7, 10, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 5px;
        padding: 6px 8px;
        text-align: center;
    }

    .submetric-label {
        display: block;
        font-size: 0.68rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 1.2px;
        margin-bottom: 2px;
    }

    .submetric-val {
        font-size: 1.05rem;
        font-family: var(--font-mono);
        font-weight: 800;
    }

    .tyre-temp-section {
        background: rgba(5, 7, 10, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 6px;
        padding: 8px 12px;
    }

    .section-micro-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #e2e8f0;
        margin-bottom: 6px;
    }

    .red-bullet {
        color: var(--rta-red);
        font-size: 0.8rem;
    }

    .tyre-grid-car {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .tyre-grid-bike {
        display: grid;
        grid-template-columns: 1fr 1fr 1.2fr;
        gap: 6px;
    }

    .tyre-box {
        background: rgba(14, 18, 26, 0.8);
        border-left: 3px solid var(--rta-green);
        padding: 5px 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 4px;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        border-right: 1px solid rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .tyre-pos {
        font-size: 0.68rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        font-weight: 700;
    }

    .tyre-val {
        font-size: 0.88rem;
        font-family: var(--font-mono);
        font-weight: 800;
        color: #ffffff;
    }

    /* --------------------------------------------------------------------------
       PANEL 2: CINEMATIC HERO VEHICLE DISPLAY (CENTER)
       -------------------------------------------------------------------------- */
    .panel-hero-vehicle {
        border-top: 3px solid var(--rta-red);
        justify-content: space-between;
        position: relative;
    }

    .hero-vehicle-badge {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        font-weight: 700;
        background: rgba(255, 31, 56, 0.12);
        color: #ffffff;
        border: 1px solid rgba(255, 31, 56, 0.4);
        padding: 3px 12px;
        border-radius: 4px;
        letter-spacing: 1px;
    }

    .hero-image-stage {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        overflow: hidden;
        min-height: 0;
    }

    .hero-ambient-underglow {
        position: absolute;
        bottom: 22%;
        width: 70%;
        height: 60px;
        background: radial-gradient(ellipse at 50% 50%, rgba(255, 31, 56, 0.32) 0%, rgba(255, 31, 56, 0.08) 50%, transparent 75%);
        pointer-events: none;
        z-index: 2;
        filter: blur(12px);
    }

    .stage-crosshair {
        position: absolute;
        color: rgba(255, 255, 255, 0.2);
        font-family: var(--font-mono);
        font-size: 1.1rem;
        pointer-events: none;
        z-index: 5;
    }
    .stage-crosshair.top-left { top: 8px; left: 10px; }
    .stage-crosshair.top-right { top: 8px; right: 10px; }
    .stage-crosshair.bottom-left { bottom: 8px; left: 10px; }
    .stage-crosshair.bottom-right { bottom: 8px; right: 10px; }

    .hero-vehicle-img {
        max-width: 96%;
        max-height: clamp(280px, 34vh, 380px);
        width: auto;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.95));
        transition: opacity 0.25s ease, transform 0.25s ease;
        position: relative;
        z-index: 4;
    }

    /* Wet asphalt mirrored floor reflection */
    .hero-vehicle-reflect-img {
        position: absolute;
        bottom: 1%;
        max-width: 96%;
        max-height: clamp(140px, 16vh, 180px);
        width: auto;
        height: auto;
        object-fit: contain;
        transform: scaleY(-0.35);
        opacity: 0.25;
        filter: blur(2px) brightness(0.6);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 75%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 75%);
        pointer-events: none;
        z-index: 3;
    }

    .hero-fallback {
        text-align: center;
        padding: 30px;
        z-index: 5;
    }

    .fallback-icon {
        font-size: 3.5rem;
        margin-bottom: 10px;
    }

    .fallback-title {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: 2px;
        color: #f1f5f9;
        margin-bottom: 6px;
    }

    .fallback-sub {
        font-size: 0.82rem;
        color: var(--rta-text-muted);
        max-width: 360px;
        margin: 0 auto;
    }

    /* TELEMETRY CHANNELS STRIP */
    .telemetry-channels-strip {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        padding-top: 10px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        z-index: 6;
    }

    .channel-metric-card {
        background: rgba(5, 7, 10, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 5px;
        padding: 7px 10px;
    }

    .channel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .channel-name {
        font-size: 0.68rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 1.2px;
        font-weight: 700;
    }

    .channel-val {
        font-size: 0.92rem;
        font-family: var(--font-mono);
        font-weight: 800;
    }

    .channel-progress-bg {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 3px;
        overflow: hidden;
    }

    .channel-progress-bar {
        height: 100%;
        border-radius: 3px;
        transition: width 0.4s ease;
    }

    .bg-cyan { background-color: var(--rta-cyan); box-shadow: 0 0 8px var(--rta-cyan); }
    .bg-red { background-color: var(--rta-red); box-shadow: 0 0 8px var(--rta-red); }

    /* --------------------------------------------------------------------------
       PANEL 3: VEHICLE SPECIFICATIONS & ACTION (RIGHT)
       -------------------------------------------------------------------------- */
    .panel-vehicle-stats {
        border-top: 3px solid var(--rta-red);
        justify-content: space-between;
    }

    .vehicle-identity-header {
        margin-bottom: 6px;
    }

    .stats-name {
        font-size: clamp(1.4rem, 2.1vh, 1.9rem);
        font-weight: 900;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: #ffffff;
        margin: 0 0 4px 0;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .stats-classification {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .badge-class {
        background: rgba(255, 31, 56, 0.16);
        color: var(--rta-red);
        border: 1px solid rgba(255, 31, 56, 0.4);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 4px;
        letter-spacing: 1px;
    }

    .badge-manufacturer {
        color: var(--rta-text-muted);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 1.2px;
    }

    .spec-table-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 10px;
    }

    .spec-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 10px;
        background: rgba(5, 7, 10, 0.55);
        border-radius: 4px;
        border-left: 3px solid rgba(255, 255, 255, 0.1);
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .spec-title {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--rta-text-muted);
        letter-spacing: 1.2px;
        font-weight: 700;
    }

    .spec-num {
        font-size: 1.0rem;
        font-family: var(--font-mono);
        font-weight: 800;
        color: #f8fafc;
    }

    .analyze-btn-container {
        margin-top: auto;
        padding-top: 4px;
    }

    .btn-analyze-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 13px 20px;
        background: linear-gradient(135deg, #ff1f38 0%, #b8051a 100%);
        color: #ffffff !important;
        font-weight: 900;
        font-size: 0.95rem;
        letter-spacing: 2.2px;
        text-transform: uppercase;
        border-radius: 6px;
        text-decoration: none;
        border: none;
        box-shadow: 0 6px 24px rgba(255, 31, 56, 0.45);
        transition: all 0.22s ease;
    }

    .btn-analyze-primary:hover {
        background: linear-gradient(135deg, #ff3b50 0%, #d60822 100%);
        box-shadow: 0 8px 30px rgba(255, 31, 56, 0.7);
        transform: translateY(-2px);
    }

    .btn-icon {
        font-size: 1.1rem;
        transition: transform 0.2s ease;
    }

    .btn-analyze-primary:hover .btn-icon {
        transform: translateX(4px);
    }

    /* --------------------------------------------------------------------------
       4. LOWER SECTION: CATEGORY SIDEBAR + VEHICLE CAROUSEL
       -------------------------------------------------------------------------- */
    .workstation-carousel-container {
        height: 36%;
        flex: 0 0 36%;
        min-height: 0;
        padding: 8px 24px 12px 24px;
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(5, 7, 10, 0.75);
        backdrop-filter: blur(12px);
        position: relative;
    }

    /* LEFT CATEGORY FILTER SIDEBAR */
    .vehicle-filter-sidebar {
        flex: 0 0 170px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: rgba(11, 14, 20, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        padding: 6px 6px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    }

    .sidebar-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
        margin: 4px 4px;
    }

    .sidebar-add-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: rgba(255, 31, 56, 0.10);
        border: 1px dashed rgba(255, 31, 56, 0.55);
        border-radius: 4px;
        color: #ffffff;
        font-family: var(--font-ui);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 1.2px;
        padding: 7px 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .sidebar-add-btn:hover {
        background: var(--rta-red);
        border-color: var(--rta-red);
        box-shadow: 0 0 16px var(--rta-red-glow);
        color: #ffffff;
    }

    .sidebar-add-btn .plus-sign {
        color: var(--rta-red);
        font-size: 0.95rem;
        font-weight: 900;
        line-height: 1;
        transition: color 0.2s ease;
    }

    .sidebar-add-btn:hover .plus-sign {
        color: #ffffff;
    }

    .sidebar-micro-tag {
        font-family: var(--font-mono);
        font-size: 0.64rem;
        font-weight: 800;
        color: var(--rta-red);
        letter-spacing: 1.5px;
        padding: 2px 6px;
    }

    .sidebar-filter-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 4px;
        color: var(--rta-text-muted);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        padding: 5px 8px;
        text-align: left;
        cursor: pointer;
        transition: all 0.18s ease;
    }

    .sidebar-filter-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.05);
    }

    .sidebar-filter-btn.active {
        color: #ffffff;
        background: rgba(255, 31, 56, 0.16);
        border-color: rgba(255, 31, 56, 0.45);
        box-shadow: 0 0 12px rgba(255, 31, 56, 0.25);
    }

    .filter-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background-color: var(--rta-text-dim);
        transition: all 0.2s ease;
    }

    .sidebar-filter-btn.active .filter-dot {
        background-color: var(--rta-red);
        box-shadow: 0 0 6px var(--rta-red);
    }

    .carousel-arrow-btn {
        width: 34px;
        height: clamp(130px, 18vh, 180px);
        background: rgba(14, 17, 26, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #cbd5e1;
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        z-index: 5;
    }

    .carousel-arrow-btn:hover {
        background: var(--rta-red);
        color: #ffffff;
        border-color: var(--rta-red);
        box-shadow: 0 0 16px var(--rta-red-glow);
    }

    .carousel-viewport-track {
        flex: 1;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 4px 2px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 31, 56, 0.3) transparent;
    }

    .carousel-viewport-track::-webkit-scrollbar {
        height: 4px;
    }
    .carousel-viewport-track::-webkit-scrollbar-thumb {
        background: rgba(255, 31, 56, 0.35);
        border-radius: 2px;
    }

    /* FULL-HEIGHT VEHICLE CARD */
    .vehicle-card {
        flex: 0 0 clamp(245px, 15vw, 285px);
        width: clamp(245px, 15vw, 285px);
        height: clamp(170px, 22vh, 215px);
        background: rgba(12, 15, 22, 0.85);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.06), 0 8px 24px rgba(0, 0, 0, 0.7);
        border-radius: 6px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.24s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .vehicle-card:hover {

</style>

<script>
    // ==========================================================================
    // VEHICLE WORKSTATION ENGINE & DYNAMIC SPECIFICATION STATE
    // ==========================================================================
    let currentType = 'car';
    let currentCat = 'race';
    let currentCategoryFilter = 'all';
    let selectedVehicleId = @(ViewBag.SelectedVehicleId ?? 1);

    // In-memory data store serialized from backend
    const vehiclesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(v => new {
        id = v.VehicleId,
        name = v.Name,
        manufacturer = v.Manufacturer,
        type = v.VehicleType.ToString().ToLower(),
        category = v.VehicleCategory.ToString().ToLower(),
        vClass = v.Class ?? (v.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Car ? "Race Car" : "Superbike"),
        engine = v.Engine ?? (v.VehicleType == RacingTelemetryAnalyzer.Models.VehicleType.Car ? "Hybrid V8" : "Inline-4"),
        power = v.Power,
        weight = v.Weight,
        topSpeed = v.TopSpeed,
        imagePath = v.ImagePath
    })));

    function onVehicleCardClicked(cardEl) {
        if (!cardEl) return;
        const id = parseInt(cardEl.getAttribute('data-id'));
        selectVehicleById(id);
    }

    function selectVehicleById(id) {
        const vehicle = vehiclesData.find(v => v.id === id);
        if (!vehicle) return;

        selectedVehicleId = vehicle.id;

        // 1. Highlight Active Card in Carousel
        document.querySelectorAll('.vehicle-card').forEach(c => {
            if (parseInt(c.getAttribute('data-id')) === id) {
                c.classList.add('active');
            } else {
                c.classList.remove('active');
            }
        });

        // 2. Update Left Performance Gauge & Sub-metrics
        const speedNum = vehicle.topSpeed || 300;
        const powerNum = vehicle.power || 500;
        const isBike = vehicle.type === 'bike';

        // Calculate dynamic RPM & Gear based on engine / vehicle physics
        let rpm = isBike ? 13200 + Math.floor((powerNum % 40) * 80) : 8400 + Math.floor((powerNum % 80) * 20);
        if (rpm > 16500) rpm = 16500;
        const gear = isBike ? 6 : (speedNum >= 325 ? 7 : 6);

        document.getElementById('perfSpeedVal').innerText = speedNum;
        document.getElementById('perfRpmVal').innerText = rpm.toLocaleString();
        document.getElementById('perfGearVal').innerText = 'GEAR ' + gear;

        const powerOrLeanLabel = document.getElementById('perfPowerOrLeanLabel');
        const powerOrLeanVal = document.getElementById('perfPowerOrLeanVal');

        if (isBike) {
            powerOrLeanLabel.innerText = 'LEAN';
            powerOrLeanVal.innerText = '55.0°';
            powerOrLeanVal.className = 'submetric-val text-cyan';
            document.getElementById('tyreGridCar').classList.add('d-none');
            document.getElementById('tyreGridBike').classList.remove('d-none');

            // Dynamic Bike Tyre calculation from vehicle physics
            const bikeFTemp = Math.round(28 + 46 + (powerNum / 250) * 8 + (speedNum / 300) * 5);
            const bikeRTemp = Math.round(28 + 52 + (powerNum / 200) * 10 + (speedNum / 300) * 6);
            const bikeLean = (50 + (powerNum % 8) * 0.8).toFixed(1);
            if (document.getElementById('tyreFront')) document.getElementById('tyreFront').innerText = bikeFTemp + '°C';
            if (document.getElementById('tyreRear')) document.getElementById('tyreRear').innerText = bikeRTemp + '°C';
            if (document.getElementById('tyreLean')) document.getElementById('tyreLean').innerText = bikeLean + '°';
        } else {
            powerOrLeanLabel.innerText = 'POWER';
            powerOrLeanVal.innerText = powerNum + ' HP';
            powerOrLeanVal.className = 'submetric-val text-red';
            document.getElementById('tyreGridCar').classList.remove('d-none');
            document.getElementById('tyreGridBike').classList.add('d-none');

            // Dynamic Car Tyre calculation from vehicle physics
            const pScale = (powerNum / 800) * 10;
            const sScale = (speedNum / 200) * 5;
            const fl = Math.round(28 + 49 + pScale + sScale);
            const fr = Math.round(28 + 51 + pScale + sScale);
            const rl = Math.round(28 + 47 + pScale * 0.9 + sScale);
            const rr = Math.round(28 + 49 + pScale * 0.9 + sScale);
            if (document.getElementById('tyreFL')) document.getElementById('tyreFL').innerText = fl + '°C';
            if (document.getElementById('tyreFR')) document.getElementById('tyreFR').innerText = fr + '°C';
            if (document.getElementById('tyreRL')) document.getElementById('tyreRL').innerText = rl + '°C';
            if (document.getElementById('tyreRR')) document.getElementById('tyreRR').innerText = rr + '°C';
        }

        // Dynamic Gauge Arc Calculation
        const arc = document.getElementById('perfGaugeArc');
        if (arc) {
            const maxGaugeSpeed = isBike ? 340 : 380;
            const ratio = Math.min(speedNum / maxGaugeSpeed, 1.0);
            const totalDash = 565;
            const fullOffset = 141; 
            const offset = totalDash - (ratio * (totalDash - fullOffset));
            arc.style.strokeDashoffset = offset;

            if (speedNum >= 335) {
                arc.style.stroke = '#ff1f38';
                arc.style.filter = 'drop-shadow(0 0 10px rgba(255, 31, 56, 0.7))';
            } else {
                arc.style.stroke = '#00d2ff';
                arc.style.filter = 'drop-shadow(0 0 10px rgba(0, 210, 255, 0.5))';
            }
        }

        // 3. Update Center Hero Vehicle Image & Telemetry Channels
        const heroImg = document.getElementById('heroVehicleImg');
        const heroReflectImg = document.getElementById('heroVehicleReflectImg');
        const fallbackEl = document.getElementById('heroFallback');
        const heroBadge = document.getElementById('heroVehicleBadge');

        if (heroBadge) {
            heroBadge.innerText = `${vehicle.name} ${vehicle.vClass} — LIVE VIEW`;
        }

        if (heroImg) {
            heroImg.classList.add('fade-out');
            if (heroReflectImg) heroReflectImg.classList.add('fade-out');

            setTimeout(() => {
                if (vehicle.imagePath) {
                    heroImg.src = vehicle.imagePath;
                    heroImg.classList.remove('d-none');
                    if (heroReflectImg) {
                        heroReflectImg.src = vehicle.imagePath;
                        heroReflectImg.classList.remove('d-none');
                    }
                    if (fallbackEl) fallbackEl.classList.add('d-none');
                } else {
                    heroImg.classList.add('d-none');
                    if (heroReflectImg) heroReflectImg.classList.add('d-none');
                    if (fallbackEl) fallbackEl.classList.remove('d-none');
                }
                heroImg.classList.remove('fade-out');
                if (heroReflectImg) heroReflectImg.classList.remove('fade-out');
            }, 160);
        }

        // Calibrate Live Channels (Throttle, Braking, Fuel)
        const throttleVal = isBike ? 92 : 95;
        const fuelRemaining = isBike ? 17 : (vehicle.category === 'race' ? 87 : 64);
        const fuelUnit = isBike ? ' L' : ' L';

        const liveThrottle = document.getElementById('liveThrottleVal');
        const barThrottle = document.getElementById('barThrottle');
        if (liveThrottle) liveThrottle.innerText = throttleVal + '%';
        if (barThrottle) barThrottle.style.width = throttleVal + '%';

        const liveFuel = document.getElementById('liveFuelVal');
        const barFuel = document.getElementById('barFuel');
        if (liveFuel) liveFuel.innerText = fuelRemaining + fuelUnit;
        if (barFuel) barFuel.style.width = (fuelRemaining / (isBike ? 20 : 100) * 100) + '%';

        // 4. Update Right Vehicle Stats Panel
        const statsName = document.getElementById('statsVehicleName');
        const statsClass = document.getElementById('statsClassBadge');
        const statsMfg = document.getElementById('statsManufacturer');
        const statsPower = document.getElementById('statsPowerVal');
        const statsWeight = document.getElementById('statsWeightVal');
        const statsSpeed = document.getElementById('statsSpeedVal');
        const statsEngine = document.getElementById('statsEngineVal');
        const statsPtw = document.getElementById('statsPtwVal');
        const statsExtraLabel = document.getElementById('statsExtraLabel');
        const statsExtraVal = document.getElementById('statsExtraVal');
        const btnAnalyze = document.getElementById('btnAnalyzeVehicle');

        if (statsName) statsName.innerText = vehicle.name;
        if (statsClass) statsClass.innerText = vehicle.vClass;
        if (statsMfg) statsMfg.innerText = vehicle.manufacturer.toUpperCase();
        if (statsPower) statsPower.innerText = vehicle.power + ' HP';
        if (statsWeight) statsWeight.innerText = vehicle.weight + ' KG';
        if (statsSpeed) statsSpeed.innerText = vehicle.topSpeed + ' KM/H';
        if (statsEngine) statsEngine.innerText = vehicle.engine;

        if (statsPtw && vehicle.weight > 0) {
            const ptw = (vehicle.power / vehicle.weight).toFixed(2);
            statsPtw.innerText = `${ptw} HP/KG`;
        }

        if (statsExtraLabel && statsExtraVal) {
            if (isBike) {
                statsExtraLabel.innerText = 'DISPLACEMENT';
                statsExtraVal.innerText = vehicle.engine.includes('998') ? '998 cc' : (vehicle.engine.includes('999') ? '999 cc' : '1000 cc');
            } else if (vehicle.category === 'race') {
                statsExtraLabel.innerText = 'DRIVETRAIN';
                statsExtraVal.innerText = vehicle.name.includes('FERRARI F1') ? 'RWD Hybrid' : 'AWD Hybrid';
            } else {
                statsExtraLabel.innerText = 'DRIVETRAIN';
                statsExtraVal.innerText = vehicle.name.includes('BMW M4') || vehicle.name.includes('PORSCHE 911') ? 'RWD' : 'AWD';
            }
        }

        // 5. Connect "PROCEED TO TRACK" button directly to the selected vehicle
        if (btnAnalyze) {
            btnAnalyze.href = '/Track?vehicleId=' + vehicle.id;
        }
    }

    function handleImageError(img) {
        if (!img) return;
        img.onerror = null;
        img.classList.add('d-none');
        const reflectImg = document.getElementById('heroVehicleReflectImg');
        if (reflectImg) reflectImg.classList.add('d-none');
        const fallback = document.getElementById('heroFallback');
        if (fallback) fallback.classList.remove('d-none');
    }

    function handleThumbError(img) {
        if (!img) return;
        img.onerror = null;
        img.src = '/images/placeholder_car.png';
    }

    // Unified filtering logic supporting Category Sidebar (ALL, GT3, GTP, F1, MOTORCYCLE, PRODUCTION)
    function filterVehicles() {
        let firstCard = null;
        const track = document.getElementById('vehicleCarouselTrack');

        document.querySelectorAll('.vehicle-card').forEach(card => {
            const cardType = card.getAttribute('data-type');
            const cardCat = card.getAttribute('data-category');
            const cardClass = (card.getAttribute('data-class') || '').toUpperCase();
            const cardName = (card.getAttribute('data-name') || '').toUpperCase();

            let matches = false;

            if (currentCategoryFilter === 'all') {
                matches = true;
            } else if (currentCategoryFilter === 'gt3') {
                matches = cardType === 'car' && (cardClass.includes('GT3') || cardName.includes('R8') || cardName.includes('GT3'));
            } else if (currentCategoryFilter === 'gtp') {
                matches = cardType === 'car' && (cardClass.includes('GTP') || cardClass.includes('LMDH') || cardClass.includes('HYPERCAR') || cardName.includes('CADILLAC') || cardName.includes('963') || cardName.includes('499P'));
            } else if (currentCategoryFilter === 'f1') {
                matches = cardType === 'car' && (cardClass.includes('FORMULA') || cardClass.includes('F1') || cardName.includes('F1'));
            } else if (currentCategoryFilter === 'bike') {
                matches = cardType === 'bike';
            } else if (currentCategoryFilter === 'production') {
                matches = cardCat === 'production';
            }

            if (matches) {
                card.classList.remove('d-none');
                if (!firstCard) {
                    firstCard = card;
                }
            } else {
                card.classList.add('d-none');
                card.classList.remove('active');
            }
        });

        // Auto select matching vehicle: preserve currently selected if still visible, otherwise first matching
        const currentlySelectedCard = document.querySelector(`.vehicle-card[data-id="${selectedVehicleId}"]:not(.d-none)`);
        if (currentlySelectedCard) {
            currentlySelectedCard.click();
            if (track) {
                const trackRect = track.getBoundingClientRect();
                const cardRect = currentlySelectedCard.getBoundingClientRect();
                track.scrollBy({ left: cardRect.left - trackRect.left - 40, behavior: 'smooth' });
            }
        } else if (firstCard) {
            firstCard.click();
            if (track) track.scrollTo({ left: 0, behavior: 'smooth' });
        }
    }

    // Left Category Sidebar handler
    function applyCategoryFilter(filterKey, btnEl) {
        currentCategoryFilter = filterKey;

        // Highlight active sidebar button
        document.querySelectorAll('.sidebar-filter-btn').forEach(b => b.classList.remove('active'));
        if (btnEl) btnEl.classList.add('active');

        filterVehicles();
    }

    // Carousel Scrolling Navigation
    const track = document.getElementById('vehicleCarouselTrack');
    document.getElementById('carouselPrevBtn').addEventListener('click', function() {
        if (track) track.scrollBy({ left: -580, behavior: 'smooth' });
    });

    document.getElementById('carouselNextBtn').addEventListener('click', function() {
        if (track) track.scrollBy({ left: 580, behavior: 'smooth' });
    });

    // ==========================================================================
    // VEHICLE MANAGEMENT: RIGHT-CLICK CONTEXT MENU, EDIT STATS & DELETE
    // ==========================================================================
    let contextVehicleId = null;

    function initVehicleContextMenu() {
        const menu = document.getElementById('vehicleContextMenu');

        document.addEventListener('contextmenu', (e) => {
            const card = e.target.closest('.vehicle-card');
            if (card) {
                e.preventDefault();
                const id = parseInt(card.getAttribute('data-id'));
                const vehicle = vehiclesData.find(v => v.id === id);
                if (!vehicle) return;

                contextVehicleId = id;
                const titleEl = document.getElementById('ctxVehicleTitle');
                if (titleEl) titleEl.innerText = vehicle.name;

                menu.classList.remove('d-none');
                const menuWidth = menu.offsetWidth || 215;
                const menuHeight = menu.offsetHeight || 110;

                let left = e.clientX + 4;
                let top = e.clientY + 4;

                if (left + menuWidth > window.innerWidth - 10) {
                    left = Math.max(10, e.clientX - menuWidth - 4);
                }
                if (top + menuHeight > window.innerHeight - 10) {
                    top = Math.max(10, e.clientY - menuHeight - 4);
                }

                menu.style.left = left + 'px';
                menu.style.top = top + 'px';
            } else {
                hideContextMenu();
            }
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('#vehicleContextMenu')) {
                hideContextMenu();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                hideContextMenu();
            }
        });

        window.addEventListener('resize', hideContextMenu);
        window.addEventListener('scroll', hideContextMenu, true);
    }

    function hideContextMenu() {
        const menu = document.getElementById('vehicleContextMenu');
        if (menu) menu.classList.add('d-none');
    }

    // --- EDIT VEHICLE MODAL ---
    function populateEditForm(vehicle) {
        document.getElementById('editVehicleId').value = vehicle.id;
        document.getElementById('editManufacturer').value = vehicle.manufacturer || '';
        document.getElementById('editName').value = vehicle.name || '';
        document.getElementById('editVehicleType').value = (vehicle.type === 'bike' || vehicle.vehicleType === 'Bike') ? 'Bike' : 'Car';
        document.getElementById('editVehicleCategory').value = (vehicle.category === 'production' || vehicle.vehicleCategory === 'Production') ? 'Production' : 'Race';
        document.getElementById('editClass').value = vehicle.vClass || vehicle.class || '';
        document.getElementById('editEngine').value = vehicle.engine || '';
        document.getElementById('editPower').value = vehicle.power || '';
        document.getElementById('editWeight').value = vehicle.weight || '';
        document.getElementById('editTopSpeed').value = vehicle.topSpeed || '';

        const previewImg = document.getElementById('editImagePreview');
        if (previewImg) {
            const fallbackPath = (vehicle.type === 'bike' || vehicle.vehicleType === 'Bike') ? '/images/placeholder_bike.png' : '/images/placeholder_car.png';
            previewImg.onerror = function() {
                this.onerror = null;
                this.src = fallbackPath;
            };
            previewImg.src = vehicle.imagePath || fallbackPath;
        }

        const fileInput = document.getElementById('editImageFile');
        if (fileInput) fileInput.value = '';
    }

    async function onContextEditClicked() {
        hideContextMenu();
        if (!contextVehicleId) return;

        const alertError = document.getElementById('editAlertError');
        if (alertError) {
            alertError.classList.add('d-none');
            alertError.innerText = '';
        }

        const targetId = contextVehicleId;
        const cached = vehiclesData.find(v => v.id === targetId);
        if (cached) {
            populateEditForm(cached);
        }

        const editModalEl = document.getElementById('editVehicleModal');
        const editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);
        editModal.show();

        try {
            const response = await fetch(`/Home/GetVehicle?id=${targetId}`);
            if (response.ok) {
                const data = await response.json();
                if (data.success && data.vehicle) {
                    populateEditForm(data.vehicle);
                    const idx = vehiclesData.findIndex(v => v.id === data.vehicle.id);
                    if (idx !== -1) {
                        vehiclesData[idx] = data.vehicle;
                    }
                }
            }
        } catch (_) {}
    }

    function previewEditImage(input) {
        if (input.files && input.files[0]) {
            const previewImg = document.getElementById('editImagePreview');
            if (previewImg) {
                previewImg.src = URL.createObjectURL(input.files[0]);
            }
        }
    }

    async function submitEditVehicle(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }

        const form = document.getElementById('editVehicleForm');
        const btnSave = document.getElementById('btnSaveVehicle');
        const btnSaveText = document.getElementById('btnSaveVehicleText');
        const alertError = document.getElementById('editAlertError');

        if (alertError) {
            alertError.classList.add('d-none');
            alertError.innerText = '';
        }

        const vName = document.getElementById('editName').value.trim();
        const vMfg = document.getElementById('editManufacturer').value.trim();
        const vPower = parseInt(document.getElementById('editPower').value);
        const vWeight = parseInt(document.getElementById('editWeight').value);
        const vSpeed = parseInt(document.getElementById('editTopSpeed').value);

        if (!vName || !vMfg) {
            if (alertError) {
                alertError.innerText = 'Vehicle Name and Manufacturer are required.';
                alertError.classList.remove('d-none');
            }
            return;
        }

        if (isNaN(vPower) || vPower <= 0 || isNaN(vWeight) || vWeight <= 0 || isNaN(vSpeed) || vSpeed <= 0) {
            if (alertError) {
                alertError.innerText = 'Power, Weight, and Top Speed must be positive values.';
                alertError.classList.remove('d-none');
            }
            return;
        }

        if (btnSave) btnSave.disabled = true;
        if (btnSaveText) btnSaveText.innerText = 'SAVING...';

        const formData = new FormData(form);

        try {
            const response = await fetch('/Home/EditVehicle', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                let errorMsg = `Server error (HTTP ${response.status})`;
                try {
                    const errorJson = await response.json();
                    if (errorJson.message) errorMsg = errorJson.message;
                } catch (_) {}
                throw new Error(errorMsg);
            }

            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'Failed to update vehicle.');
            }

            const updated = result.vehicle;
            const idx = vehiclesData.findIndex(v => v.id === updated.id);
            if (idx !== -1) {
                vehiclesData[idx] = updated;
            } else {
                vehiclesData.push(updated);
            }

            const card = document.querySelector(`.vehicle-card[data-id="${updated.id}"]`);
            if (card) {
                card.setAttribute('data-name', updated.name);
                card.setAttribute('data-manufacturer', updated.manufacturer);
                card.setAttribute('data-type', updated.type);
                card.setAttribute('data-category', updated.category);
                card.setAttribute('data-class', updated.vClass);
                card.setAttribute('data-engine', updated.engine);
                card.setAttribute('data-power', updated.power);
                card.setAttribute('data-weight', updated.weight);
                card.setAttribute('data-speed', updated.topSpeed);
                card.setAttribute('data-img', updated.imagePath);

                const titleEl = card.querySelector('.card-vehicle-title');
                if (titleEl) { titleEl.innerText = updated.name; titleEl.title = updated.name; }
                const mfgEl = card.querySelector('.card-mfg-badge');
                if (mfgEl) mfgEl.innerText = updated.manufacturer;
                const speedEl = card.querySelector('.card-speed-badge');
                if (speedEl) speedEl.innerText = updated.topSpeed + ' KM/H';
                const classEl = card.querySelector('.badge-mini-class');
                if (classEl) classEl.innerText = updated.vClass;
                const powerEl = card.querySelector('.badge-mini-spec');
                if (powerEl) powerEl.innerText = updated.power + ' HP';
                const thumbEl = card.querySelector('.card-thumb');
                if (thumbEl && updated.imagePath) thumbEl.src = updated.imagePath;
            }

            if (selectedVehicleId === updated.id) {
                selectVehicleById(updated.id);
            }

            const modalEl = document.getElementById('editVehicleModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            form.reset();
            const fileInput = document.getElementById('editImageFile');
            if (fileInput) fileInput.value = '';
        } catch (err) {
            if (alertError) {
                alertError.innerText = 'Save failed: ' + err.message;
                alertError.classList.remove('d-none');
            }
        } finally {
            if (btnSave) btnSave.disabled = false;
            if (btnSaveText) btnSaveText.innerText = 'SAVE CHANGES';
        }
    }

    // --- DELETE VEHICLE MODAL ---
    function onContextDeleteClicked() {
        hideContextMenu();
        if (!contextVehicleId) return;
        const vehicle = vehiclesData.find(v => v.id === contextVehicleId);
        if (!vehicle) return;

        const nameEl = document.getElementById('deleteVehicleName');
        if (nameEl) nameEl.innerText = `"${vehicle.name}"`;

        const deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteVehicleModal'));
        deleteModal.show();
    }

    async function confirmDeleteVehicle() {
        if (!contextVehicleId) return;
        const btnDelete = document.getElementById('btnConfirmDelete');
        const textDelete = document.getElementById('btnDeleteText');
        if (btnDelete) btnDelete.disabled = true;
        if (textDelete) textDelete.innerText = 'DELETING...';

        try {
            const response = await fetch('/Home/DeleteVehicle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'id=' + contextVehicleId
            });

            if (!response.ok) {
                let errorMsg = `Server error (HTTP ${response.status})`;
                try {
                    const errorJson = await response.json();
                    if (errorJson.message) errorMsg = errorJson.message;
                } catch (_) {}
                throw new Error(errorMsg);
            }

            const result = await response.json();
            if (!result.success) {
                throw new Error(result.message || 'Failed to delete vehicle.');
            }

            const deletedId = contextVehicleId;

            const idx = vehiclesData.findIndex(v => v.id === deletedId);
            if (idx !== -1) {
                vehiclesData.splice(idx, 1);
            }

            const card = document.querySelector(`.vehicle-card[data-id="${deletedId}"]`);
            if (card) card.remove();

            const modalEl = document.getElementById('deleteVehicleModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            if (selectedVehicleId === deletedId) {
                const remainingCards = Array.from(document.querySelectorAll('.vehicle-card'));
                const visibleCard = remainingCards.find(c => !c.classList.contains('d-none')) || remainingCards[0];

                if (visibleCard) {
                    const newId = parseInt(visibleCard.getAttribute('data-id'));
                    selectVehicleById(newId);
                } else if (vehiclesData.length > 0) {
                    selectVehicleById(vehiclesData[0].id);
                } else {
                    selectedVehicleId = null;
                    const statsName = document.getElementById('statsVehicleName');
                    if (statsName) statsName.innerText = 'NO VEHICLES IN GARAGE';
                    const heroImg = document.getElementById('heroVehicleImg');
                    if (heroImg) heroImg.classList.add('d-none');
                    const fallback = document.getElementById('heroFallback');
                    if (fallback) fallback.classList.remove('d-none');
                }
            }
        } catch (err) {
            alert('Failed to delete vehicle: ' + err.message);
        } finally {
            if (btnDelete) btnDelete.disabled = false;
            if (textDelete) textDelete.innerText = 'DELETE';
            contextVehicleId = null;
        }
    }

    // Modal Cleanup Listeners
    const editModalEl = document.getElementById('editVehicleModal');
    if (editModalEl) {
        editModalEl.addEventListener('hidden.bs.modal', function () {
            const alertError = document.getElementById('editAlertError');
            if (alertError) {
                alertError.classList.add('d-none');
                alertError.innerText = '';
            }
            const btnSave = document.getElementById('btnSaveVehicle');
            const btnSaveText = document.getElementById('btnSaveVehicleText');
            if (btnSave) btnSave.disabled = false;
            if (btnSaveText) btnSaveText.innerText = 'SAVE CHANGES';
            const form = document.getElementById('editVehicleForm');
            if (form) form.reset();
            const fileInput = document.getElementById('editImageFile');
            if (fileInput) fileInput.value = '';
        });
    }

    // Initialize on Load
    window.addEventListener('DOMContentLoaded', () => {
        @if (ViewBag.SelectedVehicleId != null)
        {
            <text>
            const requestedVehicle = vehiclesData.find(v => v.id === @ViewBag.SelectedVehicleId);
            if (requestedVehicle) {
                selectedVehicleId = @ViewBag.SelectedVehicleId;
                if (requestedVehicle.type === 'bike') {
                    currentCategoryFilter = 'bike';
                    document.querySelectorAll('.sidebar-filter-btn').forEach(b => b.classList.remove('active'));
                    const bikeBtn = document.querySelector('.sidebar-filter-btn[data-filter="bike"]');
                    if (bikeBtn) bikeBtn.classList.add('active');
                } else if (requestedVehicle.category === 'production') {
                    currentCategoryFilter = 'production';
                    document.querySelectorAll('.sidebar-filter-btn').forEach(b => b.classList.remove('active'));
                    const prodBtn = document.querySelector('.sidebar-filter-btn[data-filter="production"]');
                    if (prodBtn) prodBtn.classList.add('active');
                }
            }
            </text>
        }
        filterVehicles();
        initVehicleContextMenu();
    });
</script>
